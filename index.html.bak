o"],["sekian","samono; kc. kian.","",""],["sekin","sêking.","",""],["sekoci","prau sêkoci.","","ngoko"],["sekoi","juwawut.","","ngoko"],["sekolah","sêkolahan.\n--- 160 ---","",""],["sekon","sêkon.","",""],["sekongkol","sêkongkêl.","",""],["sekonyar","ar. prau.","","ngoko"],["sekonyong-konyong","dumadakan.","","ngoko"],["sekop","sêkop.","",""],["sekopong","sêkopèn (kêrtu gêdhe).","","ngoko"],["sekotah","sakabèhe.","",""],["seksama","dengan seksamanya: kalawan titi; kc. saksama.","","ngoko,krama"],["sekuik","bngs. otèk.","","ngoko"],["sekul","bêruk, bathok.","","ngoko"],["sekunar, sekonyar","ar. prau.","","ngoko"],["sekup","sêkop.","",""],["sekut","cêthil bangêt.","",""],["sekutu","1 sêkuthon; 2 warga, rewang, kanca; bersekutu: sêkuthon, bathon, ngumpul; disekutui: diiloni, direwangi ênggone dagang lsp; persekutuan: pakumpulan dagang.","","ngoko,sanskerta"],["sela","i sêla (-sêla), lêt, sêlan; sela-menyela: gênti-gênti lêt siji; diselakan: disêsêlake ing. ii lapak; iii sila, linggih; bersela: sila.","","ngoko,dialek,arkais"],["selada","sêlad.","",""],["seladang","i sapi alasan (bngs. banthèng). ii 1 tunggal jrambah tmr. sênthong loro lsp; 2 dubug ut. mbêmbêng tmr. sikil; menyeladang: rata.","","ngoko,krama,dialek,arkais"],["selagi","sêlawase.","",""],["selain","saliyane; kc. lain.","","ngoko"],["selak","1 slorok (palang) kancing lawang. ii diselak: disilakake, dibiyak, dicincingake.","","ngoko,dialek"],["selaka","bngs. kurungan ut. kranjang dianggo ngukup sandhangan.","","ngoko"],["selam","i menyelam: nyilêm, slulup; diselam(i): disilêmi, dislulupi. ii islam.","","ngoko,arab"],["selamat","slamêt; diselamatkan: diluputake saka ing bêbaya; selamatan: slamêtan.","","ngoko,arkais"],["selamba","1 saru, kasar têmbunge; 2 (muka-) saèn, ora idhêp isin.","","ngoko,krama,kasar"],["selampai","slempang, slendhang; diselampaikan: dislempangake, disampirake ing pundhak.","","ngoko"],["selampe","kacu.","","ngoko"],["selampit","klabangan ut. tamparan gèpèng.","","ngoko"],["selan","pulo selon.","","ngoko,dialek"],["selang","i lêt, antara; diselang: 1 disêlani; 2 diêlêti; 3 (ut. diselangkan) dibanjêli, digêntèni; berselang-selang: gênti-gênti, sêlang-sêling; setahun berselang: lêt sêtaun. ii ut. selangkan: salagine, sing ... bae; kc. sedang. iii diselang: disilih, diutang; diperselangi: diutangi; diperselangkan: disilihake, diutangake.","","ngoko,krama"],["selang-seling","sêlang-sêling.","",""],["selangat","ar. iwak loh.","","ngoko"],["selangin","ar. iwak loh; kc. senangin.","","ngoko"],["selangka","(tulang-): balung salang.","","ngoko"],["selap","ora eling (marga sêmaput, kapanjingan setan lsp); diselap: dipanjingi setan.","","ngoko,krama,arab"],["selaput","kêndhangan tipis ing mata lsp; berselaput: kasasaban ing blêdug lsp.","","ngoko"],["selar","i diselar: 1 dibrongot (dicirèni lsp) nganggo wêsi bang lsp; 2 digorèng. ii ar. iwak loh.","","ngoko"],["selara","êri lêmbut, lugut; anak selara: anak sêmbilang.","","ngoko"],["selaruh","ut. menyelaruh: 1 ngêmbrah, tansah ajêg ana (tmr. dagangan lsp); 2 manuh, matuh tumindak kang ora prayoga.","","ngoko,krama,dialek"],["selarung","tipaking buron alas.","","ngoko,dialek"],["selasa","slasa.","","ngoko,cakapan"],["selasar","èmpèr jrambahe luwih cêndhèk tinimbang omah.","","ngoko"],["selasih","kêmbang tlasih; mabuk (bunga-) selasih: rada mêndêm.","","ngoko"],["selat","1 supitan (antarane pulo); 2 supitan singapura; menyelat: lêlayaran ngambah ing supitan.","","ngoko"],["selatan","kidul; selatan daya: kidul kulon.","","ngoko"],["selawat","kc. selawat.","",""],["selayak","bngs. manuk dara.","","ngoko"],["selayun, selayut","piranti kanggo nggusah manuk.","","ngoko"],["selayur","iwak layur.","","ngoko"],["selebu","(lautan-) sagara gêdhe ut. ing têngah.","","ngoko"],["seleder","ar. wit.","","ngoko"],["selederi, selderi","slèdri.","","ngoko"],["seleguri","wit sidaguri.","","ngoko"],["selekeh","dlêmok, leletan; diselekeh: didlêmoki, dilèlèti.","","ngoko"],["selekoh","1 sleko têmpukaning dalan; 2 pangungakan ing bètèng (peranganing bètèng kang moncol).","","ngoko,dialek"],["selekor","ar. iwak sagara.","","ngoko"],["selembada","ar. sêmut gêdhe.","","ngoko"],["selembana","ut. menyelembana: mandhêg (labuh) ngarêpake pinangkaning prahara.","","ngoko,arkais"],["selembayung","bapangan ing sakaguru (kanggo canthelan diyan lsp).","","ngoko"],["selempada","ar. sêmut gêdhe; kc. selembada.","","ngoko"],["selempang","slempang, disampirake kaya slempang.\n--- 161 ---","","ngoko,dialek,arkais"],["selempukau","ar. manuk.","","ngoko"],["selempuri","(kain-) mori wêton indu (sêrampore).","","ngoko,arkais"],["selendang","slendang.","",""],["selenggara","diselenggara(kan): 1 diupakara, diopèni; 2 diurus; kc. senggara.","","ngoko,cakapan,arkais"],["selepa","slepa, cêpukan digandhulake ing sabuk.","","ngoko"],["selepang","slempang.","",""],["selepat","pating klaprut (rêgêd).","","ngoko"],["selepuh","ngêrês (akèh blêduge lsp).","","ngoko"],["selera","napsu marang pangan, pêpenginan mêmangan.","","ngoko,dialek,arab"],["selesa","ombèr, ora sumpêk.","","ngoko,krama,cakapan"],["selesai","rampung; diselesaikan: dirampungi, dirampungake, diputus.","","ngoko"],["selesama, selesma, sema-sema","pilêg.","",""],["seleweng","sêndhon waon.","","ngoko"],["seli","seling-seli: sêlang-sêling.","",""],["seliap","ar. iwak sagara.","","ngoko"],["selidik","titi, tliti, sêtiti; diselidik(i): dititipriksa, ditanjihake, ditamatake.","","ngoko,arkais"],["seligi","bngs. tumbak (kayu, luyung lsp) ditlorongake.","","ngoko"],["seligut","pating blulung, pating blêbêr.","","ngoko"],["selimbar","ut. selembar: simbar layangan.","","ngoko"],["selimpang","i nyimpang, nggiwar. ii kuwatir, sumêlang.","","ngoko"],["selimpat","1 nam-naman udhar; 2 ukêl ut. nylêkênthung ing tulisan arab; 3 bngs. untir-untir; 4 ar. ula sêgara; menyelimpat: nylimpêt, lunga dhêdhêmitan.","","ngoko,arkais"],["selimut","kêmul.","","ngoko"],["selinap","i diselinap: 1 diirisi tipis-tipis tmr. iwak loh; 2 diklènyèm kulite tmr. pitik lsp. ii menyelinap: glêsêr-glêsêr kaya lakuning ula.","","ngoko,dialek,arkais"],["selindung","aling-aling, ampingan, ndhêlik; kc. lindung.","","ngoko,arkais"],["seling","i selang-seling: sêlang-sêling. ii bêling, porsêlin.","",""],["selip","i klèru (menggok klèru). ii terselip: sumlêmpit ing; kc. selit.","","ngoko"],["selirat","ruwêd, ora karu-karuwan.","","ngoko,krama"],["seliri","palinggihan, kursi.","","ngoko"],["selisih","gèsèh; berselisih: sulaya: perselisihan: pasulayan.","","ngoko"],["selisik","diselisik: didhidhis, dipetani.","",""],["selit","diselitkan: dislêmpitake; terselit: kêslêmpit.","",""],["selit-sepit","pating slêmpit.","","ngoko"],["seliu","ut. terseliu: kêsliyo.","",""],["seloka","saloka (kidung saliyane pantun).","","ngoko,krama"],["selokan","kalèn.","","ngoko"],["seloki","sloki.","","ngoko"],["selongkar","diselongkar: 1 diblengkrahi; 2 ent. dititipriksa têmênan.","",""],["selop","sêlop.","",""],["seloroh","lucu, cucut.","","ngoko"],["seluang","ar. iwak kali.","","ngoko"],["seluar","kathok.","","ngoko"],["selubung","krukub, krudhuk, kêmul; diselubung: dikrukubi, dikêmuli.","","ngoko"],["seludang","tlakupaning mayang (kêmbang lsp), manggar, anthok.","","ngoko"],["seludip","mancung ênom.","","ngoko"],["seludu","ar. iwak loh.","","ngoko"],["selui","bngs. gêmak.","",""],["seluk","diseluk: digagapi, dirogoh digrayahi, diuthêk-uthêk.","",""],["seluk-beluk","bakuning prakara, thêk kliwêr.","","ngoko"],["selukat","saron cilik.","","ngoko"],["selukung","bngs. tamèng dawa.","","ngoko"],["selumar","ar. wit.","","ngoko"],["selumbar","tatal cilik landhêp kayata ing arèn lsp.","","ngoko,dialek"],["selumur","wlungsungan.","",""],["selundat","ar. iwak sagara.","","ngoko"],["selundup","menyelundup: nyiruk, mlêbu amblês; diselundupkan: dilêbokake tmr. barang pêtêng.","","ngoko"],["selungkang","ora murni tmr. logam.","","ngoko,krama"],["selungkap","thèthèl, nglingkap; kc. jelungkap.","","ngoko"],["selupat","kulit tipis (kêndhangan, bungkusing bayi lsp).","","ngoko,dialek"],["selurah, seluruh","sakabèhe, kabèh.\n--- 162 ---","","ngoko"],["selusuh","(-beranak) jamu sorogan; menyelusuh: mletre, mlorod.","","ngoko"],["selusur","cêkêlan ing bambinging krêtêg","","ngoko"],["selut","lêndhut plikêt.","",""],["sema-sema","pilêg; kc. selesma.","",""],["semah","sajèn têtulak lêlêmbut; disemahkan: disajèkake kanggo têtulak.","","ngoko"],["semai","ut. semaian: winih; disemai, diurit tmr. wiji pari, didhêdhêr; (pe)semaian: panguritan, pawinihan.","","ngoko,dialek"],["semaja","mung, bae; kc. sahaja.","","ngoko"],["semak","1 rungkud (akèh thêthukulane); 2 (ut. semak-semak) rêrungkudan, gêgrumbulan cilik-cilik.","","ngoko"],["semakin","saya; kc. makin.","","ngoko,dialek"],["semalam","wingi sore; kc. malam.","","ngoko"],["semalu","piskucing.","","ngoko"],["semambu","bngs. pênjalin gêdhe.","","ngoko"],["semampai","lugas, ora sambungan tmr. balok lsp.","","ngoko,krama,dialek"],["semang","sêsanggêmaning wong utang nyambutgawe ana ing panggonane wong kang potang; anak semang: 1 wong kang mondhok ut. numpang mangan; 2 wong kang mèlu wong liya bêburuh lsp; induk semang: 1 wong kang dipondhoki; 2 ent. êmbok-êmbokan; jomblang.","","ngoko,inggil,dialek,arkais"],["semangat","1 nyawa, sukma; 2 tuking urip; 3 dhanyang; hilang (kurang, lemah) semangat: 1 gêtapan, kagetan; 2 kurang grêgêt; kur semangat: kanggo ngêlokake wong sêmaput ut. bayi lair, karêpe; muga sukmane balia; terbang semangat: sêmaput, ora eling; bersemangat: gumrêgut, mêmpêng.","","ngoko,krama,dialek,arkais"],["semanggi","sêmanggi.","",""],["semangka","sêmangka.","",""],["semangu","ar. wit.","","ngoko"],["semanja","mung, bae; kc. semaja.","","ngoko"],["semantan","nyiur semantan: krambil koplak; kc. santan.","","ngoko"],["semarak","sorot, cahya.","","ngoko,arkais,sanskerta"],["semaram","ar. wit.","","ngoko"],["semat","sindik, sujèn, dom, biting; disemat: disindik, disunduki, dibitingi, digandhèng srana pêniti lsp; penyemat: pêniti; tersemat: 1 kêslusupên; 2 (-pada) tumancêb ing, kalampirake ing, katut kapetung ing.","","ngoko,dialek"],["semata","sakabèhe, babarpisan; semata-mata: ngêmungake, mligi, thothok.","","ngoko"],["semawang","kluwak.","","ngoko"],["semayam","bersemayam: lênggah, pinarak, dêdalêm, manggon.","","ngoko,inggil"],["sembab","abuh bêngêp.","","ngoko"],["sembada","kc. selembada.","",""],["sembah","1 sêmbah; 2 atur, unjuk; berdatang sembah: matur munjuk; disembah: disêmbah; di(per)sembahkan: 1 diaturake; 2 dicaosake; persembahan: pisungsung.","","ngoko,krama,inggil,cakapan,dialek"],["sembahyang","sêmbahyang.","",""],["sembak","ar. iwak sagara.","","ngoko"],["sembam","1 (sungkur-) kêbênêm, kêpêndhêm; 2 dipocot.","",""],["sembar","simbar bngs. kêmladheyan.","","ngoko"],["sembarang","sêbarang.","",""],["sembari","kambi; kc. seraya.","","ngoko,dialek"],["sembat","i disembat: disampe, dicêkêl lsp. kambi mlaku. ii disembat: disabêt(ake), dibabit(ake).","","ngoko,dialek"],["sembelih","disembelih: disêmbêlèh.","",""],["sembelit","kêdhêdhêlên ut. kêbêbêlên anggone bêbanyu.","",""],["semberani","sêmbrani.","",""],["semberap","mrabot, pêpak saprabot kapurantine.","","ngoko"],["semberip","bngs. talam nganggo sikilan.","","ngoko,dialek"],["sembeta","cuwak prau yèn ana ing babagan.","","ngoko"],["sembilan","sanga.","","ngoko"],["sembilang","iwak sêmbilang.","","ngoko"],["sembilik","(puru-) lara ambe.","","ngoko"],["sembilu","wêlad; sembiluan: krasa pêrih (kaya diiris wêlat).","","ngoko,dialek,arkais"],["sembir","1 pinggiran (ing piring, layang lsp); 2 lingiraning wowohan kyt. blimbing lsp; menyembir: ora pênêr tmr. ênêring pandom lsp.","","ngoko,krama"],["semboyan","1 têngara, sasmita; 2 têtêmbungan kanggo sêmayan, têtêmbungan cêkak aos (motto); disêmboyankan: dianggo têngara (sasmita).","","ngoko,krama,arkais"],["sembuang","pathokan cancangan prau ing sagara.","","ngoko"],["sembuh","mari, waras; disembuhkan: ditambani, diwarasake.","","ngoko"],["sembul","mêndêlo, moto-moto.","",""],["sembung","sêmbung.","",""],["sembunyi","ut. bersembunyi: ndhêlik, umpêtan; [um...]\n--- 163 ---