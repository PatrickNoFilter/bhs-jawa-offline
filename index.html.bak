],["ahlan","bagea satêkamu.","",""],["ahli","ahli (sanak sadulur, wong kang putus ing kawruh).","","ngoko,inggil,dialek,arkais"],["ahlunnujum","juru nujum.","","ngoko,arab"],["ahmak","bodho, cubluk, gêndhêng.","","ngoko"],["ahmar","abang.","","ngoko"],["aho","e!","",""],["ahwal","bab; kc. ihwal.","","ngoko"],["aib","cacad, kuciwa, kasalahan; di'aibkan: dicacad, diwirangake, dirèmèhake.","","ngoko"],["aidilfitri","lêbaran pasa.","","ngoko,arkais"],["ain","mata, undêraning prakara.","","ngoko"],["air","1 banyu; 2 duduh; 3 kanggo nyêbutake araning barang cuwèr warna-warna, up. air susu, air madu lsp; 4 (batang -) kali; buang air (besar, kecil): bêbanyu, nguyuh; mengair: kaya banyu, gilap alandhêp (tmr. pêdhang); diairi: dibanyoni, diêlêbi banyu; pengairan: irigasi; keairan: kêlêban banyu, kêbanjiran, kêlêbon banyu.","","ngoko,dialek,arkais"],["air bah (-sebak)","banjir.","","ngoko"],["air batu (-beku)","ès.","",""],["air mata","luh.","","ngoko,cakapan"],["air muka","1 pasêmoning praean; 2 ent. pakurmatan.","",""],["air rasa","banyu rasa.","","ngoko,dialek"],["air timah","prusi.","","ngoko"],["air têrjun (-lata)","grojogan.","","ngoko"],["ajab","gumun.","","ngoko"],["ajab","siksa; kc. 'azab.","","ngoko,sanskerta"],["ajaib","gumun, nggumunake, anèh.\n--- 9 ---","","ngoko"],["ajak","diajak: 1 diajak; 2 diajani, digugah atine.","",""],["ajal","1 wangênan, watêsing urip; 2 (sampai ajalnya) mati.","","ngoko"],["ajam","pèrsi.","",""],["ajar","i piwulang; belajar: sinau, ajar, gladhi, nggêgulang; dipelajari: disinau, digêgulang; diajari: 1 diwulang, diajari; 2 disrêngêni; pelajar: murid; pelajaran: piwulang, pasinaon; terpelajar: (wong) pintêr, wêton sêkolahan dhuwur (têngahan); pengajar: pamulang, guru; pengajaran: wulangan, pasinaon, piwulang. ii ut. ajar-ajar: ajar (pandhita tapa).","","ngoko,arkais,arab"],["aji","i mengaji: ngaji; pengajian: piwulang, wulangan ngaji, carane ngaji. ii sang aji, ratu.","","ngoko,arkais"],["ajnas","warna-warna; kc. jenis.","","ngoko,melayu"],["ajujah, ajujat","ngala-ala, nyatur ala.","","ngoko"],["ajuk","i diajuk(i), diajuk (ajuk)- kan: ditirokake saparipolahe prêlu dianggo gêguyon, nyênyamah lsp. ii diajuk: dijajagi, kc. duga.","","ngoko,cakapan,arkais"],["ajun","1 tujuan, maksud; 2 nylewar (nggiwar) adoh saka kang diêlês; diajun, diênêr, dituju.","","ngoko,dialek,arkais"],["akad","prajanjian, layang pikukuh.","","ngoko"],["akal","1 nalar, reka; 2 (-budi) pikiran, budi kang bênêr; 3 akal, kajuligan; ber'akal: sugih akal, pintêr; masuk'akal: kêtêmu nalar; di'akali: diakali, diapusi.","","ngoko,dialek"],["akan","1 mungguh ing, tumrap ing; 2 minangka dadi, kanggo ing; 3 marang, mênyang; 4 bakal, arêp; akan tetapi: ananging; seakan-akan: kayadene, mèh kaya.","","ngoko,dialek,arkais"],["akar","1 oyod, oyod-oyodan; 2 uga dianggo araning têtuwuhan rambat warna-warna; berakar: ngoyod.","","ngoko,cakapan"],["akar bahar","akar bahar.","","ngoko,dialek,arkais,arab"],["akar mati","sulur.","","ngoko,dialek"],["akar wangi","larasètu.","",""],["akas","i cukat, trêngginas. ii ut. akasa: awang-awang.","","ngoko,krama,arkais,sanskerta"],["akas","kosokbalèn.","",""],["akasa","awang-awang.","","ngoko,krama"],["akat","kc. akad.","","ngoko"],["akbar","gêdhe, agung.","","ngoko,arkais"],["akekah","slamêtan ngêthok rambut bayi.","","ngoko,dialek"],["akhbar","(layang-) kabar.","","ngoko,dialek"],["akhir","1 wusana, pungkasan; 2 têmbe buri; berakhir: kêpungkur, rampung; diakhirkan: dikèrèkake, disumênèkake; akhiran: panambang.","","ngoko"],["akhirat","ngakerat.","",""],["akhirulkalam","panutuping atur, ing wasana.","","ngoko,krama,dialek"],["aki","to'aki, aki-aki: kaki, êmbah lanang.","","ngoko"],["akibat","kawusanane, têmahane, kadadeyane.","",""],["akik","akik.","","ngoko"],["akik","bngs. kima.","","ngoko"],["akil balig","wis diwasa.","","ngoko"],["akmal","maha sampurna.","","ngoko"],["akrab","urang.","","ngoko"],["akrab","rakêt pamitrane, sanak sadulur.","","ngoko"],["aksara","aksara.","","ngoko"],["aksi","1 tandang; 2 pratin