akan: dipengini, diangsa-angsa.","","ngoko"],["dambir","kc. gêlambir.","",""],["dammah","ar. sandhangan aksara arab (swara u).","","ngoko,arkais"],["dampak","mendampak: têtumbukan, têtunjangan. [têtun...]\n--- 44 ---","",""],["dampar","(ut. terdampar) kandhas, kontal ana ing pasisir; didampar: dikandhasake, digèrèd mênyang dharatan tmr. prau.","","ngoko"],["dampil","berdampil: ndhêmpêl, ndhêpèpèl.","",""],["damping","sandhing, cakêt; berdamping: sêsandhingan, mèpèt.","","ngoko"],["dampit","ora mrêduli marang pitutur lsp.","","ngoko,krama"],["damprat","didamprat: dikrawus, digrujug ujar.","","ngoko"],["dan","lan, karo.","","ngoko,krama,dialek"],["dana","i bèrbudi; 2 dana, dêrma. ii mênyanyian kang nganggo dijogèdi.","","ngoko,dialek"],["danam","angkul-angkul (pasangan).","","ngoko"],["danau","tlaga, sêndhang.","","ngoko"],["danawa","buta.","","ngoko"],["dandan","1 tata, tumata; 2 rêrênggan, pacakan; berdandan: dandan, macak; didandan: ditata, dipacak, dipaèsi; sedandan: padha pacakane, ent. jambe sinigar patrape lsp.","","ngoko,arkais"],["dandang","dandang.","","ngoko"],["dandi","i bngs. clêmpung. ii tutul-tutul tmr. ulêsing kewan.","","ngoko,arab"],["dang","sêbutaning putri ing crita.","","ngoko,inggil"],["dangai","ar. panganan.","","ngoko"],["dangak","mendangak: ndhangak.","","ngoko"],["dangau","gubug.","","ngoko"],["dangkak","saèmpêr cebol (dhêngkak).","","ngoko"],["dangkal","i atos ing jêro (tmr. woh-wohan); 2 ent. wêntalan, siya, ala atine. ii cêthèk; kc. dangkar.","","ngoko,krama,dialek"],["dangkap","berdangkap: sikêp-sikêpan.","",""],["dangkar","i cêthèk. ii didangkar: digulung tmr. klasa.","","ngoko"],["dangku","ar. wit (kayu).","","ngoko"],["dangkung","bngs. lara budhug.","","ngoko"],["dangsa","dangsah.","",""],["danguk","linggih njêngongok sangga wang, kandhas njêngat tmr. prau.","","ngoko,dialek,arkais"],["danta","siyung, gadhing.","","ngoko,arkais"],["danur","kringêting mayit.","","ngoko"],["dap","bngs. tambur (trêbang).","","ngoko"],["dapa","batur tukon lsp. kang dianggo sarana nglamar.","","ngoko,dialek"],["dapat","1 bisa, kêconggah, kêduga; 2 kêna, olèh; 3 nêmu, kêtêmu; ta' dapat tiada: tan kêna ora (mêsthi); didapat: 1 ditêmu; 2 dicêkêl tmr. panjangka lsp.; didapati: 1 ditêmu; 2 dialami, diwêruhi, konangan: didapatkan: 1 ditêmokake; 2 ditêmoni, ditêkani, ditiliki; pendapat: panêmu; pendapatan: olèh-olèhan, pamêtu; kedapatan: tinêmu, kêtêmu, konangan.","","ngoko,krama,arkais"],["dapur","1 (ut. dapur-dapur) kêrên, anglo, luwêng; 2 pawon; 3 (-dada, -susu) lêkokan sangisoring dhadha (saantarane susu); orang sedapur: wong saomah, sabrayat.","","ngoko,dialek,arkais"],["dara","i (anak-) prawan; 2 dhara, dêre; ii burung dara: dara; kc. merpati.","","ngoko,dialek"],["darab","panggêbug, siksa.","","ngoko,sanskerta"],["darah","gêtih; berdarah: 1 mêtu gêtihe, gêtihên; 2 asal saka kewan tmr. pangan; naik (makan) darah: nêpsu bangêt; mendarah: 1 sugih gêtih (akèh gatihe); 2 mêmpêng ênggone marsudi.","","ngoko,cakapan,dialek,arkais,arab"],["darah daging","sanak sadulur.","","ngoko"],["darah putih","isih darah luhur.","","ngoko"],["darajat","grad, pangkat, undha usuking pangkat.","","ngoko,dialek"],["daras","mendaras: 1 ndêrês maca kor'an; 2 mêmpêng sinaune.","","ngoko,dialek"],["darat","1 dharat, dharatan, pêntasan; 2 tanah-tanah kang têngah; mendarat: ngênêr (munggah) mênyang ing dharatan; didaratkan: diunggahake ing dharatan; tali pendarat: tampar kanggo nêncang prau; tiang pendarat: cagak (pathokan) panêncangan prau.","","ngoko,dialek"],["dari","1 saka, sangka; 2 (-pada) kadadeyan saka, awujud ...; 3 (-pada) kang digawe- ...; 4 (-pada) tinimbang karo; 5 (pada, -sebab) marga, jalaran; 6 (-hal) mungguh ing bab.","","ngoko,dialek,arkais"],["darjah, darjat","grad, pangkat.","","ngoko,dialek"],["darji","darzi, grêji.","",""],["darma","kawajiban; piwulung (kalakuan) bêcik; kc. derma.","","ngoko,arkais"],["daru-daru","kc. dewa daru.","","ngoko"],["darulaman","nagara kang krêta raharja.","","ngoko,dialek,arkais"],["darulbaka","kala