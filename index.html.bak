n; pengetahuan: kawruh; setahu: êmbuh; dengan setahu ayahnya: kanthi kawêruhan ing bapakne.","","ngoko"],["tahun","taun; hari taun: wêton taunan; bertahun-tahun: têtaunan; menaun: naun (nganti sataun).","","ngoko,arkais"],["taiko","lara budhug; kc. kusta.","","ngoko,sanskerta"],["tajak","1 bngs. wangkil lancip kanggo matun, malik lêmah lsp; 2 kêjèn; menajak: nggarap lêmah nganggo tajak.","","ngoko"],["tajali","wêdharaning allah (têrang pangrêtine marga olèh wisik).","","ngoko,arab"],["tajam","landhêp.","",""],["tajau","bngs. èncèh.","",""],["taji","1 taji; 2 bngs. lading cilik.","","ngoko,dialek"],["tajin","tajin, kanji; ditajinkan: dikanji.","","ngoko,arkais"],["tajrib","kupiya, panêmu.","","ngoko"],["taju","i 1 nyongat; 2 kuku êmas ut. slaka kanggo rêrênggan; menaju: nyongat. ii ut. tajuk: makutha.","","ngoko"],["tajung","ar. tênunan bugis.","",""],["tajur","1 buntuting wuwu; 2 (menajur) dawa nglojok ing sêgara tmr. pulo lsp.","","ngoko"],["tajwid","bêcik lan bênêr pakêcapane tmr. maca, ngaji.","","ngoko,krama,dialek"],["tak","ora.","","ngoko,krama"],["takah","tataran ing prau kanggo munggah; kc. takuh.","","ngoko"],["takak","kain takak (bertakak): sarung sambungan; ditakak: disambung sarana didondomi supaya mundhak amba tmr. layar, sarung lsp.","","ngoko,arkais"],["takal","kerekan, katrol.","","ngoko"],["takang-takik","sakèhing gêrêtan (tataran, gêthêtan).","","ngoko"],["takar","i bngs. klênthing porsêlin wêton tiongkok, ii takêran; ditakar: ditakêr.","",""],["takat","nganti têkan ing.","","ngoko"],["takbir","têkbir, têkbiran.","",""],["takdir","takdir, pêpêsthèn; ditakdirkan: tinakdir, pinêsthi.","","ngoko"],["takdis","suci, disucèkake.","","ngoko"],["takhayul","takhyul, gugon-tuhon.","",""],["takhta","(-kerajaan): dhampar palênggahan; ditakhtakan: dijumênêngake ratu.","","ngoko,dialek"],["taki","menaki: tukaran, rêgêjêgan, padon.","","ngoko"],["takik","kowekan ing wit, tataran; ditakik: ditatari, dikowèki (kyt. wit karèt lsp); kc. takang-takik.","","ngoko"],["t