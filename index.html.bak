","","ngoko"],["torek","kopok, tèlèr.","","ngoko,kasar"],["totok","totok.","","ngoko"],["tua","tuwa; tua bangka: tuwa bangêt; tua renta: tuwa pikun, jêmpo; tua-tua: 1 pinituwa; 2 têtuwa; ketua: kang dianggêp tuwa, pangarsa (presiden); diketuai:\n--- 192 ---","","ngoko,dialek"],["tuah","bêgja, kabêgjan; bertuah: 1 sugih bêgja, (ora apêsan, luput ing kasangsaran lsp.); 2 mênangan, patohan; 3 njalari (marakake) bêgja.","","ngoko,krama"],["tuai","dituai: diênèni; penuaian: panenan.","",""],["tuak","tuwak.","","ngoko"],["tuakang","wong umuk.","","ngoko,arkais"],["tual","kêthokan kayu; ditoal: dikêthoki cêndhak-cêndhak tmr. kayu.","","ngoko"],["tuala","sêrbèt, andhuk, taplak.","","ngoko"],["tuam","seka; dituam: diseka.","","dialek"],["tuan","1 tuwan, bêndara; 2 wong kang duwe, up. tuan rumah, tuan tanah; 3 panjênêngan; tuanku: sampeyan dalêm; tuan besar: 1 gupêrnur jendral; 2 sêsêbutane panggêdhening kabudidayan lsp. yang dipertuan: ingkang minulya (kanggo sêsêbutan raja); pertuanan: para bêndara.","","ngoko,krama,cakapan,dialek,arkais"],["tuang","dituang: 1 diêsok, diiling; 2 dicithak tmr. gêntha lsp.; tuangan: cithakan.","","ngoko"],["tuang-tuang","bumbung disêbul kanggo têngara.","","ngoko"],["tuar","incir; kc. lukah.","",""],["tuas","bngs. antru ut. gol; dituas: disongkèl nganggo antru, senggotan lsp.; tuasan: senggotan ing anco.","","ngoko,dialek"],["tuba","tuba, (bngs. jênu).","","ngoko"],["tuban-tuban","kêndhangan bungkus bayi; air tuban-tuban: banyu kawah.","","ngoko,dialek"],["tubi","bertubi(-tubi): mêmpêng, nyrêmpêng; ditubi: disrêmpêng.","",""],["tubin","patang dina angkas.","","ngoko"],["tubir","1 têpining kali, têpining sagara lsp. kang kacakan banyu; 2 lêgokan jêro (kêdhung) ing kali lsp.; menubir: 1 ngêdhung; 2 nglojok manjêro.","","ngoko,dialek"],["tubuh","badan, awak; bersetubuh: sanggama.","","ngoko,krama,dialek,arkais"],["tuding","nlèsèr (njlampar) mangisor, up. mengasah tuding: (ngasah dijlamparake mangisor, sisihe siji dijongatake sathithik).","","ngo