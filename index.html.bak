","njêbêbêg, sêbah.","",""],["senunggang","ar. iwak sagara.","","ngoko"],["senyak","sêpi, nyênyêt; kc. senyap.","",""],["senyampang","mumpung, kêbênêran, kapinujon.","","ngoko"],["senyap","(sunyi-) sêpi nyênyêt, mamring.","","ngoko"],["senyar","krasa êmar.","","ngoko"],["senyum","èsêm; tersenyum: mèsêm; tersenyum simpul: mèsêm kapathêt; tersenyum raja: mrêngut.","","ngoko"],["senyur","bêndara, tuwa.","","ngoko"],["seolah-olah","kayadene.","",""],["sepah","i sêpah (an kinang); sepah puteri: ar. manuk; sepah raja: manuk cendrawasih. ii tersepah: pating blangkrèh.","","ngoko"],["sepai","buyar mrana-mrana tmr. pêcahan barang lsp.","","ngoko"],["sepak","i tampèk; disepak: ditampèk, ditamplèk. ii sepak; sepak raga: bal-balan; sepak terjang: jangka-jangkah, tandang grayang; disepak: 1 disepak, didugang, ditêndhang; 2 (disepak sila): ditepang.","","ngoko,dialek,arkais"],["sepakat","mupakat, rujuk.","","ngoko,dialek"],["sepam","bngs. pêlêm alasan.","","dialek"],["sepan","bngs. rangên.","",""],["sepang","wit sêpang.","","ngoko"],["sepantun","kayadene.","",""],["separuh","saparo, satêngah.","",""],["sepat","i krasa sêpêt. ii iwak sêpat.","","ngoko"],["sepatu","sêpatu.","",""],["sepatung","kc. sipatung.","",""],["sepecat","ar. iwak loh.","","ngoko"],["sepeda","pit.","","ngoko"],["sepegoh","bngs. tirêm.","",""],["sepekur","bngs. kêmladheyan.","",""],["seperai","sprèi, lèmèk kasur.","","ngoko"],["seperti","kaya, prasasat, mèmpêr; dengan sepertinya: kalawan pantês, kaya mêsthine; disepertikan: dipêpantês, dirêngkuh kalawan pantês.","","ngoko,krama,dialek,arkais"],["sepesan","ut. pesan-pesan: babak salu.","","ngoko,dialek"],["sepet","1 mênga sathithik; 2 suthup tmr. mata.\n--- 166 ---","","ngoko"],["sepi","sêpi, ora rame.","","ngoko,krama"],["sepit","1 ciyut, supêk, rupak; 2 (ut. penyepit) supit, sapit cathut cilik; disepit: disupit, disapit, dicathut, dijêpit; tersepit: kêjêpit.","","ngoko"],["sepoi","sêpai.","",""],["sepoi-sepoi, sepui-sepui","silir-silir.","",""],["sepuh","disepuh: 1 disêpuhi; 2 dilapis, diêlim tmr. dluwang.","","ngoko"],["sepuk","disepuk: dibuang (dibrukake) kasar-kasaran.","",""],["sepuku","(keris-) kêris tanpa luk.","","ngoko"],["seput","kucêm tmr. warna.","","ngoko,arkais"],["seputih","ar. têtuwuhan.","",""],["sera","gupuh; tersera-sera: gupuh-gupuh, kêsusu, gita-gita.","","ngoko"],["serabai","srabi.","","ngoko"],["serabut","pating jriwut.","","ngoko,dialek"],["seraga","bantal seraga: bantal gêdhe nganggo rêrênggan.","","ngoko"],["serah","i berserah, menyerah: 1 pasrah, sumarah; 2 asrah bongkokan (kalah, têluk); diserahi: dipasrahi; diserahkan: dipasrahake. ii 1 abang sumringah; 2 têrang tmr. warna.","","ngoko,arkais"],["serahi","gêbyas, gêndul cilik.","","ngoko"],["serai","sêre.","",""],["serajam","ar. wit.","","ngoko"],["serak","i ut. terserak: pating slêbar, sumêbar mrana-mrana; diserak(-serakkan); diawut-awut. ii sêrak, èsèk; burung serak: kokokbêluk. iii diserak: dikêndhokake lan dibênakake tmr. gulungan lsp.","","ngoko,krama,dialek"],["serak-serik","pating jrêthut (driji).","","ngoko"],["seram","nyabe tmr. kulit, njêgrik tmr. wulu kulit.","","ngoko,dialek"],["serambi","srambi, èmpèr mêtu.","","ngoko,dialek"],["serampang","cêmpuling lancipe nganggo grèthèl.","","ngoko"],["serampin","ampas pathi sago ut. arèn.","","ngoko,dialek"],["seran","lirik-lirik tmr. cita lsp.","","ngoko,arkais"],["seranah","(sumpah-) sot, ipat-ipat, supata.","","ngoko,arkais"],["serandang","cuwak pring (kayu) loro ing pucuk digathukake lan ditalèni nganti wangun cawangan.","","ngoko,krama,dialek"],["serandung","terserandung: kêsandhung","",""],["serang","i arang-arang ut. amba tmr. bolongan kranjang, jala lsp. ii diserang: disêrang, ditrajang, ditêmpuh; serangan: panêmpuh. iii ar. pangkating bêbau prau (onderopsir). iv ênom tmr. warna; menyerang: sumilak warnane.","","ngoko,arkais"],["serangga","i sungu, pucak, ii kewan gêgrêmêtan.","","ngoko,arab"],["serangguh","menyerangguh: linggih ndêkung; kc. seranggung.","","ngoko"],["seranggung","menyeranggung: linggih ndêkung, ndhodhok.","","ngoko,dialek"],["serangkak","i êri ut. sangkrah dipulêtake ing wit-witan supaya aja kêna dipènèki. ii kêpithing cilik.","","ngoko"],["serani","kristên.","",""],["seranta","menyeranta: lunga mampir-mampir, njajah desa milang kori; diserantakan: diwartakake mrana-mrana.","","ngoko,dialek"],["serantang","diserantang: dikrampyang, diujar-ujari.","",""],["serap","menyerap: manjing, rumêsêp, rumangsuk.","","ngoko,arkais"],["serap-mesra","rakêt supêkêt pamitrane.","",""],["serapah","donga nundhung lêlêmbut, sot, ipat-ipat; diserapah: ditundhung srana didongani, diipat-ipati, ditênung.","","ngoko,arkais,arab"],["serasa","i 1 tunggal rasa; 2 mèmpêr; kc. rasa. ii ar. suruh.","","ngoko,krama"],["serasah","i larahan, uwuh, lêmi, rabuk. ii ar. cita kêkêmbangan.","","ngoko,arkais"],["serasi","jodho, cocog petungane; kc. rasi.","","ngoko"],["serat","sêrêt (ora kêna dicopot).","","ngoko,krama"],["seratah","ar. pala kêpêndhêm.","","ngoko,arkais"],["serau","udhar tmr. tênunan.","","ngoko"],["serawa","ar. panganan.","","ngoko"],["seraya","i kambi, karo. ii sraya, pitulungan; diseraya: dijaluki pitulungan. iii ar. wit.","","ngoko,dialek"],["serba","sarwa, sakabèhe; serba putih: sarwa putih; serba rumah: thêk kliwêring omah kabèh.","","ngoko,cakapan,dialek"],["serba-neka, serba-serbi","warna-warna, sruwa-sruwi.","","ngoko"],["serbak","menyerbak: sumêrbak, ngambar; kc. semerbak.","",""],["serban","i sêrban, tulban.\n--- 167 ---","",""],["serbat","sêrbat.","",""],["serbet","sarbèt.","",""],["serbu","menyerbu, menyerbukan diri: nggrêdêg, ambyuk nêmpuh.","","ngoko"],["serbuk","bubukan; diserbuk: dibubuk; serbuk gergaji: grajèn.","","ngoko"],["serdadu","prajurit.","","ngoko"],["serdak","rês-rês.","",""],["serdam","suling.","","ngoko"],["serdang","bngs. arèn.","","ngoko,dialek"],["serdawa","antop, glegekan.","","ngoko"],["serdi","ngêlu pilêg, pilêg tmr. jaran.","","ngoko"],["serdih","wêtêng lan dhadhane mungal.","","ngoko,krama,dialek"],["sereat","sarengat; kc. syari'at.","",""],["sereh","sêre.","",""],["serejang","sadohe, up. sêrêjang kuda lari.","","ngoko"],["serek","wêgah.","",""],["seremban","menyeremban: onclang nganggo dhuwit.","","ngoko"],["serempak","barêng brêg, sabrêsan; terserempak: kêtukup, digrêdêg.","",""],["serempu","kayu kawangun kaya prau kaêtrap ing dhasaring prau.","","ngoko,dialek,arkais"],["serendah","ar. gêdhang.","","ngoko"],["serendang","ar. iwak kali.","","ngoko"],["serendeng","miring sasisih; kc. sendeng.","","ngoko"],["serengam","berserengam: uyêk-uyêkan, untêk-untêkan.","",""],["serenjang","ngadêg jêjêg, njêjêr tmr. wit.","","ngoko"],["seresah","rês-rês.","",""],["seret","i sèrèt, pinggiran. ii diseret: disèrèt, dilarak.","","ngoko"],["sergah","disergah: digêrtak, digêtak, dikagètake.","",""],["sergam","munggul, mêncungul.","","ngoko"],["sergap","disergap: ditêmpuh (ditukup, digrêdêg) dadakan.","",""],["sergut","groboh.","","ngoko,kasar"],["seri","i 1 sorot, cahya; 2 ent. endah, luhur, kang endah dhewe, kaluhuran, kaendahan; 3 sri (sêsêbutan), up. sêri baginda; berseri(-seri): sumunar, mawa cahya, cahyane bingar. ii diseri: diisêp tmr. kêmbang madu lsp. iii ut. berseri: nêtêpake kang kawit dhisik tmr. dolanan, kayata sarana sut, ndudut suwiran godhong lsp. iv pur, gêdhêg.","","ngoko,dialek,arkais,sanskerta"],["seri-balai","bangsal pasewakan.","","ngoko"],["seri-gunung","srigunung (saka kadohan katon bêcik).","","ngoko,arkais"],["seri-muka","nêca, caya.","","ngoko"],["seri-pantai","sritaman (saka kadohan ala).","","ngoko,arkais"],["seriawan","lara sriawan.","","ngoko"],["seridanta","kêmbang srigadhing.","","ngoko"],["seridewa","ar. kêmbang.","",""],["seriding","1 lingir; 2 ar. iwak sagara.","","ngoko"],["serigading","srigadhing.","","ngoko"],["serigala","asu ajag.","","ngoko,dialek"],["serik","kapok, kanji, jinja.","","ngoko"],["serikat","pakumpulan; berserikat: kêkumpulan; perserikatan: pakumpulan.","",""],["serikaya","srikaya.","","ngoko"],["serimala","undhagi.","","ngoko"],["serindai","i ar. lêlêmbut bngs. puntianak. ii ngrangin, kêpenak dirungokake.","","ngoko"],["serindit","manuk slindhit.","","ngoko,dialek"],["sering","i kêdhut, kêkêr, wulêd tmr. dluwang; disering: dikêkêrake, dikêncêngake tmr. tampar lsp. ii sering kali: kêrêp, sok. iii kêcut bangêt, kêmranyas. iv disering: diisêp; kc. seri.","","ngoko,dialek"],["seringai","menyeringai: mrêngut.","",""],["serip","plipidan ing sandhangan.","","ngoko"],["serja","sêrsi (ar. bakal).","","ngoko"],["serkah","sêmplok, sêmpal, pokah.","","ngoko"],["serkai","diserkai: 1 dipêrês ut. diuntir supaya apuh; 2 disaring tmr. glêpung lsp.","","ngoko"],["serkap","1 susug; 2 kranjang kaya susug dianggo kurungan.","","ngoko,dialek,arkais"],["serkup","diserkup: ditutupi ing kranjang lsp., disusug.","","ngoko"],["serlah","ut. terselah: katon ngegla, katon cêtha tmr. rêmbulan, srêngenge.","","ngoko"],["serling","pluwang (pasangan kewan lsp).","","ngoko,dialek,arab"],["sermangin","bngs. kêndhang gêdhe.","","ngoko"],["sero","bersero: bêbrandon dagang; pesero: wong kang mèlu brandon; peseroan: pakumpulan dagang; untung sero: bêbathèn ing brandon.","","ngoko,cakapan,dialek,arkais"],["serobeh","pating dhrawul tmr. rambut.","","ngoko"],["serobot","diserobot: 1 disêbrot; 2 dijupuk tanpa têmbung.","","ngoko"],["seroja","kêmbang tunjung (trate).","","ngoko"],["serombong","wuluhan kuningan lsp., wuluhan kanggo sambungan up. ing suling, pipa lsp.\n--- 168 ---","","ngoko"],["serombongan","grombolan, gêgolongan.","","ngoko"],["serondong","diserondong: disrudug, disrondhol.","",""],["serong","mèncèng, mencong; serong hati: sèdhèng, ora barès; serong menyerong: mencang-mèncèng, ngecas-encos.","","ngoko,krama"],["seronggang","urung-urung (gronggongan) ing pamêlikan.","","ngoko"],["seronok","kêpenak, nyênêngake.","",""],["serpih","cuwilan, pugutan, sêmpelan; diserpih: dicuwil, dipugut.","","ngoko"],["serta","1 sarta, karo, kanthi; 2 (-dengan) bêbarêngan karo, barêng karo, mèlu karo; 3 barêng, up. serta dilihatnya; disertai: dikanthèni, dibarêngi, dikancani; disertakan: dikanthèkake, dibarêngake karo.","","ngoko,arkais"],["serta-merta","tumuli.","","ngoko"],["seru","i panyêluk, pangundang; berseru: ngundang, nguwuh-uwuh; diseru: diundang, diuwuh-uwuh. ii (-sekalian, -semesta) sakabèhe. iii sêru, bangêt.","","ngoko"],["seruda","êri ut. sangkrah digubêdake ing wit-witan.","","ngoko"],["serudi","ut. berserudi: sinarawèdi; diserudi: disarawèdi.","","ngoko"],["seruh","kêmpès tmr. abuh lsp.","","ngoko"],["seruit","cêmpuling nganggo grèthèl.","","ngoko"],["seruk","ar. takêran gabah (10 gantang).","","ngoko"],["seruling","suling.","","ngoko"],["serunai","i bngs. slomprèt (klarinèt). ii sruni.","","ngoko"],["serunda","diserunda: digèrèd tmr. prau.","","ngoko"],["serunding","i srundèng. ii ar. wit.","","ngoko"],["serunjang","tumbak kayu.","","ngoko"],["serut","1 swara mak srut, sruk; 2 pasah.","","ngoko,cakapan,dialek"],["serutu","srutu.","","ngoko,dialek"],["sesah","disesah: disabêti, digêblègi.","",""],["sesak","sêsak, sêsêk, supêk, rupak; sesak dada: lara sêsêk; penuh sesak: kêbak bangêt, sêk-sêkan; disesakkan: diêsêk-êsêk, disêsêk, ditindhês; tersesak: kêpèpèt, rêkasa; kesesakan: sêsêk-rupêk.","","ngoko"],["sesal","(bersesal, menesal, menyesal) gêtun, kêduwung, disêsali, disesalkan: digêtuni.","",""],["sesap","ngombe (tmr. manuk); sesapan burung: papan pangombèn manuk.","","ngoko,dialek,arkais"],["sesar","disesar(kan): 1 diingsêr tmr. wadyabala, dibiyak tmr. klambu; 2 disur, diganti.","","ngoko,cakapan,arkais"],["sesat","ut. tersesat: kêsasar; disesatkan: disasarake.","",""],["sesat-darat","bingung, kêsasar-sasar.","","ngoko"],["sesawi","sawi.","","ngoko,dialek"],["seta","ukuran sadawaning tangan; kc. hasta.","","ngoko,arkais,sanskerta"],["setabelan","prajurit mriyêman.","","ngoko"],["setagih","ar. rêrênggan.","",""],["setak","ar. prau cilik.","","ngoko"],["setaka","ar. têtuwuhan.","",""],["setakona","maju wolu; kc. astakona.","","ngoko"],["setambul","bngs. wayang wong (tonil).","","ngoko,arkais,walanda"],["setan","setan.","","ngoko,arab"],["setangan","saptangan; kc. saputangan.","",""],["setanggi","dupa, mênyan.","","ngoko"],["setawar","ar. wit.","","ngoko"],["setelah","sawise; kc. telah.","","ngoko,arkais"],["setengah","satêngah, saparo.","",""],["seteria","satriya.","","ngoko"],["seterika","sêtlika.","",""],["seteru","satru; berseteru: sêsatron; diseterukan: disatru, dimungsuhake.","","ngoko"],["seti","satin.","",""],["setia","sêtya.","",""],["setiabu","ar. ula; pedang setiabu: pêdhang alingir têlu.","","ngoko"],["setiawan","sêtya bangêt.","",""],["setinggi","tampar pangerekan layar.","","ngoko"],["setinja","cewok.","","ngoko"],["setolop","bngs. ting.","","ngoko"],["seton","bngs. êmpluk gilap.","","ngoko"],["setu","i 1 bngs. ganggêng; 2 ar. ula sêgara. ii pangèstu; barkah.","","ngoko"],["setua","kewan; kc. satwa.","","ngoko,arkais,arab"],["setubuh","bersetubuh: sanggama; kc. tubuh.","","ngoko,arkais"],["setuil","ar. têtuwuhan.","",""],["setuju","mupakat, cocog; disetujui: disarujuki, dimupakati.","","ngoko,dialek"],["seturi","crita, gunêm, gegeran.","","ngoko"],["sewa","sewa, sewan; disewa: disewa; di(pers)sewakan: disewakake.","","ngoko"],["sewah, sewar","bngs. cundrik mlêngkung.","","ngoko"],["sewal","njalari cilaka (tmr. impèn, tamba lsp).","","ngoko,arkais"],["si","si.","",""],["sia-sia","muspra, tanpa tanja, tanpa guna; disia-siakan: 1 diêcèh-êcèh, ora ditanjakake; 2 ora dirêmbug.\n--- 169 ---","","ngoko,krama"],["siah","disiah: disilakake nisih tmr. rambut lsp.","","ngoko"],["siah-layah","miyat-miyut, mêntêlang-mêntêlung, sênggoyoran.","","dialek"],["siak","i tukang ngrêksa mêsjid; santri. ii akar siak, siak-siak: ar. têtuwuhan oyode wangi.","","ngoko,dialek,arkais"],["siakap","ar. iwak loh.","","ngoko"],["sial","siyal, sêbêl; sial dangkalan: siyal bangêt.","","ngoko"],["sialang","1 tala tawon; 2 (pokok-) wit kang ana talane tawon.","","ngoko,dialek,arkais"],["siamang","i bngs. kêthèk gêdhe. ii wêdhi malela, lêmah kang isi mangaan.","","ngoko,dialek"],["siamis","ar. iwak sagara.","","ngoko"],["sianang","ar. iwak kali.","","ngoko"],["siang","i 1 awan, rina; 2 katon rêsik (marga dibabadi têtuwuhane lsp); bersiang: bêbêsik; disiangi, dipersiangi: dibêsiki, dibabadi, diwatun, dibubuti. ii siang-siang: ar. manuk.","","ngoko,krama"],["siap","cumawis, siyaga, rampung; bersiap: siyaga, tata-tata, cêcawis; disiapkan: dicawisake, disiyagakake, dirampungake.","","ngoko,krama"],["siapa","sapa.","","ngoko,arkais"],["siar","i disiar: 1 dipasang srana dilepa (kayata masang bata lsp); 2 dipatri, disambung nganggo patri. ii disiar: diobong nganti mêngangah tmr. wêsi lsp. iii disiarkan: disêbar, digiyarake; siaran: pakabaran, panggiaran radhio.","","ngoko"],["siasat","1 siyasat, siksa; 2 paniti-priksa; siasat perang: gêlaring pêrang; disiasat(kan): 1 dipidana disiksa; 2 dititipriksa, disêtitèkake têmênan.","","ngoko,cakapan,dialek,arkais,sanskerta"],["siat","disiat(kan): diiris-iris; kc. sayat.","","cakapan,arkais"],["siau","wis adhêm tmr. barang kang maune panas.","","ngoko,dialek"],["sibar(-sibar)","èmbèl-èmbèl (wuwuhan kang diplipid), omah wuwuhan (kagamblokake omah baku).","","ngoko,dialek"],["sibuk","ribut tumandang ing gawe.","","ngoko,dialek,arkais"],["sibur","siwur.","","ngoko"],["sibur-sibur","kinjêng dom.","","ngoko"],["sida","kêbirèn; sida-sida: 1 wong kêbirèn; 2 ar. punggawa kraton, juru nujum ing kraton, tukang njaga kaputrèn; disida: digêbiri tmr. wong.","","ngoko,arkais,arab"],["sidai","disidai: diisis, diangin-anginake supaya garing.","","ngoko"],["sidang","kumpulan srasehan; bersidang: kêkumpulan.","",""],["sidik","disidik: dititipriksa, disêtitèkake, ditliti; sidik jari: pênitipriksa cap tangan (jêmpol; driji).","","ngoko,dialek"],["siding","i jaring kang digawe panjalin kanggo masangi mênjangan lsp. ii lingir.","","ngoko,dialek"],["sifat","sipat, kaanan; tiada tersifatkan: ora kêna dicritakake.","","ngoko,krama"],["sigai","palang ing wit (tiyang lsp), kanggo pancadan mènèk; tangga sigai: andha lanang; menyigai: mènèk mancad ing palang-palang mau.","","ngoko,krama,inggil"],["sigap","bersigap: cumêpak, siyaga, cumawis.","","ngoko,krama"],["sigar","ar. rêrênggan ing sirah.","","ngoko"],["sigara","bngs. kopyah lancip.","","ngoko"],["sigi","i disigi: 1 dicuthiki; 2 dikurêki, diukir. ii obor kayu.","","ngoko"],["sigung","menyigung: nyikut; kc. singgung.","",""],["sihir","ngèlmu sikir (gêndam, tênung).","","ngoko,krama,arab"],["sijil","layang piagêm, layang cathêtan.","","ngoko"],["sika","(baju-) saèm. klambi takwa.","","ngoko"],["sikap","i 1 pawakan, dêdêg-piadêg; 2 sikêp, tanduk adhêdhasar kaantêpane; mengambil sikap: nêtêpake antêpe; membuang sikap: gawe wiraga. ii elang sikap: bngs. wulung cilik. baju sikap(an): klambi sikêpan.","","ngoko,dialek"],["sikat","1 sikat; 2 (-rambut) jungkat; 3 garu; 4 lirang (tmr. gêdhang); disikat: 1 disikat; 2 dijungkati; 3 digaru.","","ngoko,dialek"],["sikikih","ar. manuk.","","ngoko"],["sikin","sêkin (bngs. lading, golok).","","ngoko,dialek"],["sikit","sathithik; kc. sedhikit.","","ngoko"],["siksa","siksa; disiksai(kan): disiksa, dipilara.","","ngoko,cakapan,arkais,sanskerta"],["siku","1 sikut; 2 siku, sikon; 3 pojok jêjêg; siku-siku: 1 pojok jêjêg; 2 gadhinging prau; 3 popor bêdhil; menyiku: mangun pojok (up. enggok-enggokaning kali lsp).","","ngoko,arkais"],["siku-keluang","nguntu-walang.","",""],["sikudidi","ar. manuk.","","ngoko"],["sikudomba","ar. iwak sagara.","","ngoko"],["sikut","sikut; menyikut: ent. ngapusi.\n--- 170 ---","","ngoko"],["sila","1 patrap kang bêcik (tatakrama, subasita); 2 (bersila) linggih sila; 3 (silalah, silakanlah) sumangga, kula aturi ...; di(per)silahkan: diaturi supaya ...","","ngoko,krama,dialek,arkais"],["silam","pêtêng ndhêdhêt; tahun yang telah silam: taun kêpungkur; tersilam: kêwêngèn, kêtungka ing wêngi.","","ngoko,cakapan,dialek,arkais"],["silang","tumpang-tumpangan mrapat; silang empat: prapatan (dalan); silang selisih: padudon pasulayan; silang menyilang: tumpang-tumpangan mrapat upamane pêdhang loro katata têtumpangan.","","ngoko,dialek"],["silap","i sulapan; bermain silap: nyulap; bersilap: sulapan; disilap: disulap, diapusi lsp. sarana rêrekan. ii menyilap: gawe kêkêmbangan (rêrênggan) ing pinggiraning layang lsp. iii kliru, salah; kc. khilaf, kilap.","","ngoko,arkais"],["silat","bersilat: main selat, main pêdhang; disilat: ditangkis nganggo pêdhang.","","ngoko,dialek"],["silau","silo, sulap, blêrêng; menyilau: ulap-ulap marga blêrêng.","","ngoko,dialek,arkais"],["silawatang","ar. pangkat bangsa bugis.","","ngoko,dialek"],["silih","têtêmpuh, pêpulih; silih menyilih: solan-salin, gonta-ganti; disilih: ditêmpuhi, dipulihake.","","ngoko,arkais"],["silih mata","mung dianggo gêlar, lumrahe tumrap mènèhi tukon akèh, nanging sawise katêmu banjur akèh kang dijaluk bali.","","ngoko,dialek"],["silsilah","salasilah.","","ngoko"],["silu","krasa ngêrês, kakênan atine, krasa ora kapenak tumrap pangrungu, mripat ut. pangrasa.","","ngoko,krama"],["siluk","ar. iwak sagara.","","ngoko"],["siluman","seluman (dhêmit).","",""],["simalu","piskucing.","","ngoko"],["simbah","kumêpyur ut. sumirating banyu (ombak lsp); bersimbah: gumrobyos tmr. kringêt, nyiprat; bersimbahan: pating cliprat; disimbah: diciprati, dikêpyuri banyu lsp.; dikapyuk ing banyu.","","ngoko,dialek"],["simbai","ngatonake ênggone ngrêti subasita (tatakrama lsp).","","ngoko"],["simbang(an)","ar. manuk sêgara.","","ngoko"],["simbar","simbar mênjangan.","","ngoko"],["simbat","bngs. prêstha.","",""],["simbur","menyimbur: munggah (kyt. munggah ing sirah).","","ngoko"],["simpai","i blêngkêr, suh; disimpai: ditrapi blêngkêr, disuhi. ii ar. bngs. kêthèk.","","ngoko,arkais"],["simpan","disimpan: 1 disimpêni, dirumat, dirawati, disinggahake, disingkir-singkirake; 2 (ut. diambil simpan) dipêthik (dijupuk) sapêrlune ut. ringkêse bae tmr. layang lsp.","","ngoko"],["simpang","(-tiga, -empat): dalan pratêlon, prapatan; menyimpang: nyimpang, nisih; simpangan: simpanganing dalan ut. kali.","","ngoko"],["simpang-siur","sêsimpangan akèh ut. têtrajangan tmr. dalan.","","ngoko"],["simpir","nyèngklèhake suwiwi.","","ngoko"],["simpit","cakêt, mèpèt karo.","","ngoko"],["simpuh","ar. pala kêpêndhêm.","","ngoko,arkais"],["simpuk","menyimpuk: nggadhug ut. nyenggol; disimpuk: didakwa kang ora-ora.","","ngoko,dialek"],["simpul","bundhêlan ut. sindhêtan; simpul mati: tali pati; simpul pulih (hidup): tali wangsul; tersenyum simpul: sêmu mèsêm; disimpul-(kan): dibundhêli, ditalèni, disindhêt; kesimpulan: pêpuntoning rêmbug, pêpuntoning panêmu.","","ngoko,krama,cakapan,dialek,arkais"],["simpur","ar. têtuwuhan.","",""],["simun","bngs. cita kêkêmbangan.","","ngoko,arkais"],["sinar","sorot; sinar menyinar: pating glêbyar; disinari: disoroti.","","ngoko,arkais"],["sindir","ut. sindiran: pêpoyok, pasêmon; disindir: disêmoni.","",""],["singa","singa.","","ngoko"],["singal","ar. rêrênggan sirah.","","ngoko"],["singgah","mampir; singgah menyinggah: mompar-mampir; disinggahi: diampiri; persinggahan: palêrêban, palerenan, ampiran.","","ngoko"],["singgan","nganti; kc. sehingga.","","ngoko"],["singgang","i iwak loh godhogan diasin. ii ukuman tmr. murid yaiku tangane nyêkêli kuping ngadêg linggih bola-bali.","","ngoko,arab"],["singgasana","dhampar palênggahan.","","dialek"],["singgir","menyinggir: wiwit mêgar tmr. kêmbang, mringis tmr. cangkêm.\n--- 171 ---","","ngoko"],["singgit","gosokan, senggolan; disinggit: disenggol, digosok.","","ngoko"],["singgul","menyinggul: nggabig.","","ngoko"],["singgung","menyinggung: mbijig, nyrudug; disinggung: 1 disangga ing bau kyt. wong kang klêngêr; 2 disrudug, ent. digêpok, disenggol, katut dirêmbug lsp.","","ngoko,dialek,arkais"],["singkap","disingkap: dibiyak, diungkapi.","",""],["singkat","1 cêkak, cêndhak; 2 ent. ora loma; disingkatkan: dicêkak, diringkês.","","ngoko,krama"],["singkek, singkik","singkèk.","","ngoko,dialek"],["singkil","i tali singkil: kêndhit; disingkil: dikêndhiti, disabuki nganggo sabuk cilik. ii krasa linu tmr. untu.","","ngoko"],["singkir","disingkir(kan): 1 dièrèki (tmr. babon); 2 disingkiri, disingkirake; 3 dilancangi, disêtut tmr. lakuning prau.","","ngoko,cakapan,arkais"],["singkong","tela kaspe.","","ngoko"],["singkur","disingkur: disuduk lsp. mayat (miring).","","ngoko"],["singsat","singsêt, cancut; disingsat: dicancutake.","","ngoko"],["singse","singsèh.","",""],["singsing","menyingsing: sumilak tmr. mêndhung lsp; fajar menyingsing: bangbang wetan; disingsing(kan): 1 diwingkis tmr. lêngênan, dicancutake tmr. lambe, kathok lsp.; 2 digulung sathithik tmr. layar.","","ngoko,cakapan,dialek,arkais"],["sini","kene.","",""],["sintal","wêwêg.","",""],["sintik","bngs. tirêm cilik.","","ngoko"],["sinting","bngs. tirêm gèpèng.","","ngoko"],["sintuk","sintok.","",""],["sintul","ipêl-ipêl, cêndhèk lêmu.","",""],["sipai","sêpèi.","",""],["sipat","i (tali-): tali sipatan (piranti tukang kayu); disipatkan: disipat. ii kaanan; kc. sifat.","","ngoko"],["sipatung","thokerok.","",""],["sipi","1 saka ing têngah minggir; 2 tunggakan pagaweyan; menyipi: nggiwar minggir tmr. barang kang disawatake.","","ngoko,dialek,arkais"],["sipir","sêpir.","",""],["sipu","tersipu-sipu, kesipu-sipuan: kisinan, clingusan marga isin.","","ngoko"],["siput","bngs. keyong warna-warna.","","ngoko"],["sir","i mak srêng, cês, nyês; kc. sar. ii pathok kanggo lesan. iii (-berahi) siring ati, pêpenginaning ati. iv wadi.","","ngoko,cakapan,dialek,arkais"],["sira","i disira: diulig-uligake ing barang kang plikêt, kayata roti ing juruh lsp. ii 1 sira, kowe; 2 dhèwèke.","","ngoko,dialek,arkais"],["sirai","tatas lan tata tmr. rambut.","","ngoko,krama,dialek,arkais"],["siram","ut. bersiram: siram; disiram: disiram.","","ngoko,inggil"],["sirap","i 1 kêjongkèng sathithik up. gêndhèng kanginan; 2 ent. mênga atine dening kêsêngsêm. ii sirap. iii aji sirêp; tersirap: 1 kêturon (kêna sêsirêp); 2 kandhêg tmr. lakuning gêtih.","","ngoko,arkais"],["sirat","disirat: 1 dibundhêli, disindhêt; 2 dinam tmr. jala, rajut jaring; lsp.; siratan gigi: pinggiraning untu kang tumancêb ing gusi; siratan kuku: bêlahan tracak.","","ngoko,dialek,arkais"],["siratulmustakim","dalan marang swarga.","","ngoko"],["siraut","pangot cilik; kc. raut.","","ngoko,dialek"],["sirih","suruh; sirih masak: kinang; wang sirih: tukon suruh (opahan, buruhan).","","ngoko,dialek,arkais"],["siring","disiring: dilerobi, diseropi.","",""],["sirip","kèpèt.","","ngoko,dialek"],["siru","bersiru: ganti ênêre (tmr. angin lsp).","","ngoko"],["sirulkulup","têlênging ati.","","ngoko"],["sisa","sisa, turahan; disisakan: diturahake.","","ngoko"],["sisi","sisih; menyisi: nisih.","","ngoko"],["sisih","pêpadon, pasulayan; disisih: dipadoni, dipalangi; kc. selisih.","",""],["sisik","1 sisik; 2 thothok (tmr. bulus lsp); disisik: 1 disisiki, diklocop kulite (sisike); 2 didêlêng katuranggane tmr. jago, kêris lsp.","","ngoko"],["sisip","disisip: 1 (ut. disisipkan) dislêmpitake up. kêris ing sabuk; 2 disêsêlake, ditlêsêpake; 3 disulami tmr. tanduran, nam-naman lsp; tersisip: kêslêmpit, kêsêsêlan; sisipan: sêsêlan.","","ngoko"],["sisir","1 jungkat, suri; 2 garu; 3 lirangan (gêdhang); disisir(i): dijungkati, disurèni.","","ngoko,dialek"],["sit","swara suwit, sênthit.","","ngoko"],["sita","disita: 1 digugat; 2 dirajadarbe.","",""],["sitar","sitêr.","",""],["sitti","sêsêbutan tmr. wong wadon.","","ngoko,arkais"],["situ","kono.","","ngoko"],["siuk","menyiuk: mêgêng napas (marga krasa lara lsp).","","ngoko,arkais"],["siul","bersiul: singsot.","","ngoko"],["siuman","eling (mari mêndêm, mari sêmaput).","","ngoko"],["siung","i mbêngung, sumiyut kayata lakuning mimis. ii siyung.","","ngoko"],["siur","kc. simpang-siur.\n--- 172 ---","",""],["siut","mak siyut.","","ngoko,cakapan,dialek"],["siwah","(elang-) alap-alap.","","ngoko"],["soal","soal, pitakonan; soal jawab: takon-takonan, adu rêmbug.","","ngoko,arab"],["sobat","mitra, kanca; kc. sahabat.","","ngoko"],["sobek","suwèk.","","ngoko"],["sobok","disobok: diblêjog, ditukup (ditêmpuh) dadakan.","",""],["sodok","sorok, bngs. lêncêg.","","ngoko"],["sodok bikang","bngs. kêris.","",""],["sodor","nyongat mangarêp, nyodor.","",""],["soga","wit soga.","","ngoko"],["sogang","trucuk (pathok) kang ditata mayat kanggo mêpêti mungsuh; disogang: dipisah sarana dipêpêti kayu lsp.","","ngoko,dialek"],["sogok","disogok: 1 diwèhi sasmita sarana obahing tangan (kayata dikon linggih lsp); 2 dibêsêli.","","ngoko,cakapan,arkais"],["soja","sojah ndungkluk ngormati.","","ngoko"],["soka","wit soka; kc. angsoka.","","ngoko,arkais"],["sokak","ar. wit.","","ngoko"],["sokom","bêlang irêng ut. congore irêng tmr. ulêsing asu.","","ngoko"],["sokong","cuwak, sanggan; disokong: 1 dicuwaki, disangga, dicagak; 2 ent. ditulungi sawatara; sokongan: pitulungan, panjurung, sumbangan.","","ngoko"],["solat","salat.","","ngoko,arab"],["solek","bêsus, dhêmên macak.","","ngoko"],["solok","sumbangan marang wong duwe gawe.","","ngoko,arkais"],["sombol","disombol: diloloh, didublag.","",""],["sombong","umuk bangêt, ngedak-edakake; menyombongkan diri: sumêngah, sêsongaran, pambêkan.","","ngoko"],["someng","ora bêcik tmr. ing pandêlêng, klakuan lsp.","","ngoko,krama"],["sompek","gopèl, gowèng.","","ngoko"],["sompoh","disompoh: dipanggul ing pundhak.","","ngoko"],["sompok","kêpêngkok, kêsompok, kêprêgok.","",""],["sondeh","ar. wit.","","ngoko"],["sondol","menyondol: nggudag, nyundhang, mbijig.","","ngoko"],["sondong","ut. menyondong: maju karo mundhuk-mundhuk.","","ngoko"],["songar","sumangkeyan, kakehan pratingkah.","","ngoko"],["songel","mênjete, nyongat sathithik.","","ngoko"],["songkok","topi, kupluk, tudhung, songkok.","","ngoko,dialek"],["songsong","disongsong: dipapagake, dipêthukake.","",""],["songsong-kalak","têtêmpukan ora gathuk urut tmr. sêrating kayu lsp.","","ngoko,krama"],["sop","sop.","","ngoko"],["sopak","bngs. bêlak.","",""],["sopan","1 antêng, jatmika; 2 tatatrapsila, ngrêti tatakrama; burung sopan: manuk cendrawasih; disopani: ditanggapi lsp. kalawan tatakrama; kesopanan: tatatrapsila, kasusilan.","","ngoko,krama"],["sopan-santun","sarèh jatmika, ngêrti tatakrama.","","ngoko"],["sopir","sopir.","","ngoko"],["sorak","surak; disoraki: disuraki, disênggaki.","","ngoko"],["sore","sore.","","ngoko"],["sorong","surungan, up. kêreta sorong (kreta surungan); kena sorong: dibêsêli; disorong: 1 disurung; 2 diajak, ditari; disorong damai: diajak bêdhamèn; disorong bantal: diwènèhi bantal dikon turu; sorongan: bêsêl.","","ngoko,dialek"],["sosok","i plipidan gêdhe (kêna dilêboni koloran). ii sosok tubuh: ragangan (ing awak, prau, omah lsp.); menyosok: ngêdêgake ragangan prau, omah lsp.","","ngoko,dialek"],["sotoh","1 payon wrata (ora mayat); 2 plangitan, lotèng.","","ngoko,krama,dialek"],["sotong","bngs. iwak mangsi.","","ngoko"],["soyak, soyat","suwèk.","","ngoko"],["sua","adu arêp (kaya jago kang arêp tarung); bulu sua: baris (wulu jago ing gulu); bersua: kêpêthuk, kêtêmu.","","ngoko,dialek,arkais"],["suah","belum suah: durung tau: adakah suah: apa wis tau.","","ngoko"],["suai","1 ut. sesuai: jodho, cocog trêp. 2 kc. suaji.","","ngoko"],["suaji","tampar kang pungkasane mawa kolongan (kanggo ngèrèk momotan).","","ngoko,dialek"],["suak","lêmpong (têluk) kang cilik; menyuak: lêlayaran ing lêmpong.","","ngoko,dialek"],["suaka","pangungsèn, pondhokan.","",""],["sual","pitakonan; kc. soal.","",""],["sualak","mèmpêr, kaya.","","ngoko,dialek,arkais"],["sualing","bersualing: sliringan (pêthukan) nanging padha dene ora wêruh.","","ngoko,krama"],["suam","mangêt-mangêt.","",""],["suami","bojo (kang lanang).","","ngoko,dialek"],["suang","gampang; ta' suang-suang: ora gampang.","","ngoko,krama"],["suangi","1 ar. mêmêdi; 2 ar. iwak; burung\n--- 173 ---","","ngoko"],["suap","1 êmplokan, pulukan; 2 ent. bêsêl, ruba; makan suap: mangan bêsêl; disuap: 1 dipuluk; 2 didulang, diloloh, dijuju; 3 ent. dibêsêli.","","ngoko,inggil,cakapan"],["suar","diyan (gêni lsp) kanggo têtêngêr (nyoloki, madhangi lsp) disuar: dicoloki, diobori tmr. tala.","","ngoko,arkais"],["suara","suwara.","","ngoko"],["suari","suwari; bantal suari: bantal pajangan (kanggo pangantèn).","","ngoko"],["suasa","suwasa.","","ngoko"],["suasana","swasana.","","arkais"],["suatu","siji, sawiji; barang suatu: samubarang, sabarang; bersuatu: nunggal; dipersuatukan: ditunggalake, didadèkake siji.","","ngoko"],["subahat","1 tasbèh; 2 pandonga, pamuji.","","ngoko"],["subal","groboh tmr. gêgarapan.","","ngoko,kasar"],["suban","tatal.","","ngoko"],["subang","1 suwêng; 2 uwêr kanggo ngêlar bolongan pasuwêngan; 3 kêrêtan têbu; disubang: dikêrêti (diirisi) bundêr-bundêr.","","ngoko"],["subhanallah, allah subhanahu","mugi pinujia allah!.","","ngoko,krama,arab"],["subuh","wayah subuh (bangbang wetan).","","ngoko,dialek"],["subur","subur, wlagang, loh tmr. lêmah.","","ngoko,dialek"],["suci","suci, rêsik.","","ngoko"],["suda","saèm. sujèn dawa kanggo borang; suda-suda: sogolan têtuwuhan kang lancip-lancip kyt. bung alang-alang lsp.","","ngoko,dialek"],["sudah","1 rampung, lêbar; 2 wis, uwis, sawise, bakda; sudah-sudah: sadurunge; sudah-sudahnya: pungkasane, wasanane; disudahi: 1 didadèkake, dirampungake, dirampungi, diuwisi; 2 dilêksanani, dipinangkani; disudahkan: diuwisi, dirampungi; kesudahan: êntèk-êntèkan, pantogan, karampungan, pungkasan; tiada berkesudahan: tanpa wasana; penyudah: kang dianggo mungkasi, upamane panganan lsp. kang dipangan bakda mangan sêga.","","ngoko,inggil,cakapan,dialek,arab"],["sudi","sudi, sênêng; sudilah kiranya: mugi kêrsaa.","","ngoko,krama"],["sudip","solèt.","",""],["sudu","1 suru, sendhok; 2 sosor, cocor.","","ngoko,dialek"],["sudu-ayah","sidawayah.","","ngoko"],["sudu-hati","pucuking balung dhadha.","","ngoko"],["sudung","gubug.","","ngoko"],["sudut","pojok (an).","","ngoko"],["suf","ar. bakal kang digawe wulu unta.","","ngoko,dialek"],["sufi","ar. kawruh kabatinan ing kalangan agama islam.","","ngoko,arab"],["sufian","mualim sufian: guru ngèlmu kabatinan.","","ngoko,arkais"],["sugar","disugar: disunggar (dijungkati nganggo driji).","","ngoko"],["sugul","susah, sêdhih; kc. masgul.","","ngoko"],["sugun","disugun: