 [x] iriban ([x] ulat): nganggo nyawang marang kaanane (kang arêp ditêmbungi lsp); [x] kosok: nangguh mangsa kang bêcik; [x] repa ak: nggathuk-nggathukake surasane (ing nalikane maca); [x] swara ak: nilingake marang lagu sarta larasing swara; kc. pangon, pangonan.","","ngoko"],["angop","ak angob.","","ngoko"],["angot","kn 1 kumat, lara manèh; 2 ent. bali nglakoni ala manèh.","","ngoko"],["angsa","I ng-[x](-[x]) kn murka kumudu olèh. II (S) kw: -banyak. III (S) kw: 1 turun, wangsa; 2 panduman, perangan.","","ngoko"],["angsu","ng-[x] kn 1 golèk banyu; 2 ent. golèk kawruh, mêguru; di-[x] ak. diangsoni: 1 dijupuk (digolèki) banyune; 2 ent. diguroni, dicêcêp kawruhe.","","ngoko"],["angub","êngg.ak ngaub, ngeyub.","","ngoko"],["anguk","I pc angur, aluwung. II [x]-[x] kn: ndêlêng ungak-ungak saka ing cêndhela lsp; di-[x]-[x]-i: diungak, diadhang arêp wêruh apa wis têka apa durung.","","ngoko"],["angum","kw adus kungkum; kc. kum.","","ngoko"],["angur","kn luwih prayoga (bêcik) yèn ...","","ngoko"],["angus","kn kênthêlaning kukusing diyan lsp.","","ngoko"],["angut","kw mêthik, ngundhuh.","","ngoko"],["anila","kw angin.","","sanskerta"],["aning","êngg.kn nanging.","","ngoko"],["anjal","(-anjal) êngg. kn tansah lunga (klintong).","","ngoko"],["anjap","êngg. kn paga.","","ngoko"],["anjat","êngg. kn dronjongan, pèrèng; di-[x]-i êngg: 1 diunggahi, dipènèk; 2 disrêmpêng, diudi bangêt; kc. manjat.","","ngoko"],["anjel","di-[x]-ake êngg. kn diajokake.","","ngoko"],["anjer","êngg. kn anjir.","","ngoko"],["anjil","I [x]-[x]-ên kn. ak kanji, kapok, II di-[x], dianjèni kn. ak: dilakèni; kc. lanji.","","ngoko"],["anjir","kn 1 pathokan dawa dianggo têtêngêr lsp; 2 êngg. kuli padesan kang pinatah ndandani dalan; di-[x]-i: dipasangi anjir.","","ngoko"],["anjog","kn 1 têkan (jêbul) ing ...; 2 ak. mudhun.","","ngoko"],["anjor","êngg. kn mudhun.","","ngoko"],["anjuk","di-[x] êngg. kn dituku pambayare kèri.","","ngoko"],["anjun","I êngg. kn (tukang [x]) tukang gawe grabah. II ut. anjung pc: aju