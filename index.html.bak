ek"],["eru, ru","wit cêmara.","","ngoko"],["es","ès.","",""],["esa, sa","sawiji; diesakan: disawijèkake; esa-esaan: ekan, ijèn.","","ngoko"],["esak","sêsêg napase; mengesak: mingsêg-mingsêg.","",""],["esek","bngs. lara cêkèk.","","ngoko"],["esok","sesuk; esok lusa: 1 besuk êmbèn; 2 êmbèn buri; keesokan harinya: esuke.","","ngoko,dialek"],["esot","mengesot: 1 mlaku ngesot; 2 ent. rindhik bangêt.\nf","","ngoko,dialek"]],"f":[["faal","(ut. paal) panggawe, patrap, kalakuan.","","ngoko,arkais"],["faal","(ut. paal, pal) ngalamat bêcik ut. ala.","","ngoko,dialek"],["fadihat","kawirangan.","",""],["fadilat","kautaman, kaluwihan.","",""],["faedah","(ut. paedah) paedah, piguna.","",""],["faham","(ut. paham) 1 surasa, pangrêti; 2 (-akan) ngrêti têmênan marang, paham; salah faham: klèru tampa; difahamkan: dingrêtèkake têmênan.","","ngoko,arkais"],["fajar","(ut. pajar) byar raina, bangun esuk.","","ngoko,dialek"],["fakih","(ut. pakih, pekih) ngulama ahli kawruh agama.","","ngoko,arab"],["fakir","(ut. pakir, pekir) 1 pêkir, wong kang nglakoni miskin; 2 (ut. alfakir) aku.","","ngoko,dialek,arkais"],["falak","(ut palak) langit; 'ilmu falak: ngelmu palintangan.","","ngoko"],["falsafah, falsafat, filsafat","ngèlmu kawicaksanan.","",""],["fana","kêna ing rusak, ora langgêng.","","ngoko,krama"],["faraid","(ut. paraid, peraid) wêwênang bab warisan.","","ngoko"],["farisi","wong parisi.","","ngoko,arkais"],["fasal","(ut. pasal) pasal, bab.","","ngoko"],["fasih","(ut. pasih) pasèh ênggone gunêman ut. maca.","","ngoko,dialek"],["fasik","(ut. pasik) pasèk (duraka, ala, dosa).","","ngoko"],["fatah","(ut. patehah, patah) ar. sandhangan ing tulisan arab (baris diatas).","","ngoko,arkais"],["fatihah","(ut. petihah) patekah yaiku bêbukane kitab kur'an.","","ngoko,arab"],["fatsal","pasal; kc. fasal.","","ngoko"],["fidah","slaka.","","ngoko"],["fihak","(ut. pihak) sisih, prênahing ênêr, parte; kc. pihak.","","ngoko"],["fiil","1 panggawe, patrap, kalakuan; 2 (perkataan nama fi'il) têmbung kriya.","","ngoko,krama,arkais"],["fikir","(ut. pikir): pikiran; kc. pikir.","","ngoko"],["filsafah","kc. falsafah.","","ngoko"],["firasah, firasat","(ut. pirasah, perasat) rai; 'ilmu firasah: kawruh wirasating jalma (nyumurupi wêwatakan sarana nyawang kaananing raine lsp.).","","ngoko"],["firman","(ut. perman) pangandika, dhawuh.","","ngoko,inggil"],["fitnah","(ut. petenah, pitenah) pitênah, pangala-ala; difitnahkan: dipitênah, diala-ala, dicêcamah, diuman-uman.","","ngoko"],["fitrah","(ut. peterah, piterah) pitrah.","","ngoko"],["fuad, foad","ati, pangrasa.","","ngoko"],["fulus","dhuwit.","","ngoko"],["furak","beda.","","ngoko"],["fusta","ar. prau.","","ngoko"],["futur","lêbar pasa.\n--- 54 ---\n\ng","","ngoko,arkais"]],"g":[["gaba-gaba","1 blarak ut. bongkoking wit sagu dianggo gêdhèg, payon lsp; 2 gêgodhongan dianggo pajangan, tarub lsp.","","ngoko,arkais"],["gabai-gabai","bngs. kêmbên sing digawe sangkêlat abang dibludir.","","ngoko,krama"],["gabak","mêndhung.","",""],["gabas","groboh, kasar tmr. gêgarapan.","","ngoko,kasar"],["gabung","bergabung: nggamblok dadi siji; digabungkan: digamblokake dadi siji.","","ngoko"],["gabus","i kayu gabus dianggo ngosèk lading lsp; digabus: 1 dikosèk ing gabus tmr. lading lsp, digosok nganggo gabus; 3 dikoroki tmr. bêdhil; penggabus: korok bêdhil (mriyêm). ii ikan gabus: iwak kutuk.","","ngoko,dialek"],["gada","gada; gada-gada: piranti dianggo nyumurupi ênêring angin kapasang ing pucuking tiyang.","","ngoko,krama"],["gadai","gadhe, gadhèn; digadaikan: digadhèkake; gadaian: gadhèn; pegadaian: pagadhean.","","ngoko"],["gadamala","laos; kc. lengkuas.","","ngoko"],["gadang","i irig, ayakan (kalo) gêdhe. ii (ut. gedang) gêdhe.","","ngoko"],["gading","1 gadhing; 2 ent. panjawating baris; gading-gading: 1 iga-iga ing awak-awaking prau; 2 blêngkêr rodha.","","ngoko,dialek,arkais"],["gadis","prawan.","","ngoko,dialek"],["gaduh","rame, dêdrêg, gumêdêr; bergaduh: gumêdêr, udrêg; pergaduhan: gegeran, udrêg-udrêgan, drêdah.","","ngoko"],["gaduh riuh","gumêdêr bangêt, udrêg arame.","",""],["gaduk","kumayu, gumagus, sênêng pamèr.","","ngoko"],["gadung","gadhung.","","ngoko"],["gadungan","gadhungan.","","ngoko"],["gaga","gaga; kc. huma, ladang.","","ngoko,arkais"],["gagah","1 gagah, rosa; 2 (-berani) gagah prakosa, kêndêl; digagahi: 1 dipêksa, dirodapêksa; 2 dikalahake.","","ngoko,arkais"],["gagai","menggagai: ngranggèh-ngranggèh.","",""],["gagak","gagak.","","ngoko"],["gagal","gagal, cabar, ora olèh gawe.","","ngoko,krama"],["gagang","gantilan, gagang.","","ngoko"],["gagap","menggagap: groyok, glagêpan tmr. gunêman.","","ngoko"],["gagau","digagau: digagapi, digrayahi, digrayangi.","",""],["gagu","bisu.","","ngoko"],["gah","kuncara, kamisuwuran; kc. megah.","","ngoko"],["gahar","digahar: digosok, diangsab.","",""],["gahara, gara","1 trahing ngaluhur; 2 babag pêpangkatane ut. darahe; têmênan tmr. bojo ut. anak, up. bini gahara (bojo têmênan, garwa padmi).","","ngoko,arkais"],["gahari","sêdhêngan; kc. ugahari.","",""],["gaharu, garu","kayu garu (cêndhana).","","ngoko"],["gaib","ilang, musna, gaib, winadi.","","ngoko"],["gaibana","wong urakan.","","ngoko,arkais"],["gaing","cucuking prau.","","ngoko"],["gairah, gairat","dêrênging ati, pêpenginaning ati.","","ngoko"],["gait","digait: digèthèl, disènggèt.","",""],["gajah","1 gajah; 2 mantri tmr. dolanan catur; ikan gajah, gajah mina: iwak lodan; main gajah (gajah-gajahan) dolanan catur (sêkak).","","ngoko,krama,dialek,arkais"],["gajah lalang","gajah ingon.","","ngoko"],["gajah menyusu","payon gêdhang salirang.","","ngoko"],["gajai","digajaikan: diuculake; tergajai: ucul, copot.","","ngoko"],["gaji","bayar, buruhan; makan gaji: bêburuh; orang gajian: wong bayaran, buruh.","","ngoko,cakapan,arkais"],["gajus","jambu mete.","","ngoko"],["gala","1 blêndok; 2 sêsambungan; tiada bergala: ora sêsambungan; gala-gala: 1 gala, jabung; 2 bngs. dhêmpul ut. kruwing.","","ngoko,krama"],["galah","gèntèr, satang; matahari sepenggalah: wayah esuk jam 6-7; matahari dua penggalah: wayah e