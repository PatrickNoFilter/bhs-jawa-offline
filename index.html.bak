,"njêmbluk tmr. wêtêng.","",""],["bozah","bngs. arak.","","ngoko,dialek"],["buah","1 woh; 2 kanggo wilanganing barang-barang kang ora gumathok wangune (kyt. kutha, nagara, gunung lsp); 3 ing têmbung camboran atêgês ar. peranganing badan, kyt: buah pinggang (ginjêl), buah betis (kempol); ar. peranganing barang, kyt. buah meriam (mimis); berbuah: awoh; buah-buahan: wowohan.","","ngoko,krama,dialek,arkais"],["buah atap","woh kolang-kaling.","","ngoko"],["buah hati","kêkasih.","",""],["buah kata","prakara kang dirêmbug.","","ngoko,dialek"],["buah mulut","(dadi-) kêmbang lambe.","","ngoko"],["buah pikiran","panêmu.","",""],["buah tangan","olèh-olèh.","",""],["buai","membuai, berbuai (-buai): 1 obah mbandul (kaya dieyun); 2 ent. nganyut-anyut tmr. swara lsp.; buaian: 1 bandulan; 2 obahing ombak; 3 (-jam) bandhul jam.","","ngoko,dialek,arkais"],["buak","membuak: 1 mbual mêtu tmr. banyu, mêtu kumêlun tmr. kukus lap; 2 ent. kêmpros, pamèr.","","ngoko,dialek"],["bual","membual: 1 mbludag, mbual; 2 ent. kumawani, kumêndêl.","","ngoko"],["buana","buwana, jagat.","","ngoko,arkais,sanskerta"],["buang","dibuang(kan): dibuang; buang air (kecil, besar); nguyuh, bêbanyu; membuang belakang: mlayu nglungani; membuang diri: 1 lunga sumingkir (nênêpi lsp); 2 lunga ngumbara; membuang malu: nêtaki, nêtakake; membuang nama: gawe alaning jênênge; membuang penat: rêkasa tanpa tanja; buangan: buangan; pembuangan: pambuangan.","","ngoko,krama,cakapan,dialek,arkais"],["buar","sênêng wèwèh, ngêbrèh, boros.","","ngoko"],["buari","bngs. daging garingan.","","ngoko"],["buas","galak.","","ngoko"],["buat","1 gawe; 2 nindakake; 3 kanggo, tumrap marang; berbuat: nindakake, tumindak; dibuat-: digawe, ditindakake; diperbuat: digawe, digarap, dipanggawe; buatan: gawean; bukan buatan: dudu rasa; perbuatan: tindak, patrap, kalakuan.","","ngoko,inggil,arkais"],["buaya","baya, bajul, ent. wong ala.","","ngoko,arkais"],["buaya-buaya","blabag tanjêbaning tiyang.","","ngoko,krama"],["bubar","bubar; dibubarkan: dibubarake.","","ngoko"],["bubu","(-karang, -labuh, gamat): bngs. wuwu.","","ngoko"],["bubuh","dibubuh: 1 diwuwuhi; 2 didokoki, ditrapi, disèlèh.","","ngoko"],["bubuk","bubuk, têtêr.","","ngoko"],["bubul","i 1 bêlak; 2 (-buk) bubul. ii dibubul: disulami tmr. jala lsp.","","ngoko,arkais"],["bubung","1 puncak, kucir; 2 (ut. bubungan) molo, wuwungan; membubung: ndêdêl munggah.","","ngoko,dialek"],["bubur","jênang.","",""],["bubus","i rontog rambute; butak. ii membubus: brol-brolan; untêk-untêkan; uyêk-uyêkan.","","ngoko"],["bubut","i manuk bubut. ii ut. tali bubutan: tampar panarik tiyang; dibubut: dibubut, didhaut, dijêbol.","","ngoko,krama"],["bucu","pongol, pojok kang mêtu nglojok.","","ngoko,dialek"],["budak","bocah, batur (-tukon); membudak: ngèngèr, dadi batur; kebudak-budakan: mbocahi.","","ngoko,dialek"],["budar","udhar.","","ngoko"],["budaya","kebudayaan: kabudayan.","","ngoko"],["budi","1 budi, pangrêti, watak, bêbudèn; 2 akal, reka; 3 panggawe bêcik; hutang budi: kêpotangan kabêcikan; membalas budi: malês bêcik; berbudi: pintêr, wicaksana, duwe bêbudèn bêcik.","","ngoko,arkais"],["budi bahasa","tatakrama, bêbudèn bêcik.","",""],["budi bicara","akal, reka.","","ngoko"],["budi-pêkêrti","wêwatakan, kalakuan.","","arkais"],["budiman","pintêr, wasis.","","ngoko"],["budu","ar. iwak cilik-cilik sok diasin.\n--- 32 ---","","ngoko,dialek"],["buduh","tulisan sandi ing ngalamating layang lsp.","","ngoko,arkais"],["buduk","lara budhug.","","ngoko"],["bugar","saras, sigrak.","","krama"],["buhul","dibuhul: ditalèni; disingsêti; dibundhêli.","",""],["bui","kunjara.","","ngoko"],["buih","umpluk, unthuk; berbuih: mumpluk, munthuk","","ngoko"],["buil","ar. wit (kayu).","","ngoko"],["bujal","1 mêtoto, mênjoto, bodong tmr. wudêl; 2 bujêl.","","ngoko"],["bujam","saèm. kêba cilik.","","ngoko"],["bujang","1 ora (durung) duwe bojo; 2 jaka ut. prawan; membujang: ora bêbojoan (wadat); pembujangan, pemujangan: 1 bab wadat; 2 paklumpukane wong-wong kang wadat.","","ngoko,krama,dialek"],[