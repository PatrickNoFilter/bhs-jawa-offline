awa, melihat) bulan: nggarap sari.","","ngoko,arkais"],["bulan mati","rêmbulan kantha.","","ngoko,arkais"],["bulan susut","rêmbulan tanggal tuwa.","","ngoko"],["bulan terang","(têrang bulan) padhang rêmbulan.","","ngoko,dialek,arkais"],["bulan timbul","rêmbulan tanggal ênom.","","ngoko"],["bulan-bulan","lesan.","","ngoko"],["bulang","1 kacu ut. rambut kang diubêdake ing sirah; 2 (-hulu): udhêng gilig, uga dianggo têmbung pamiluta; 3 godhi ut. tali diubêdake ing sikil jago; dibulang: 1 dipuntir lan diubêdake ing sirah tmr. rambut, kacu lsp; 2 digodhi, diblêbêd tmr. sikil jago lsp.","","ngoko,krama,dialek"],["bulang-baling","mubêng kaya kitiran, kitiran.","","ngoko,dialek,arkais"],["bulangan","ar. têtuwuhan.","",""],["bular","siwêr ut. rada putih tmr. mripat.","","ngoko,krama,cakapan"],["bulat","1 bundêr; 2 (ut. bulat-bulat) wutuh, blêjêt; dengan bulat hatinya: kalawan gumolonging ati; dengan suara bulat: kanthi mupakat kabèh; dibulatkan: diwutuhake tmr. petungan.","","ngoko,krama,dialek"],["bulat bujur (-panjang)","bundêr lonjong.","","ngoko"],["bulat pipih","bundêr gèpèng.","","ngoko"],["bulat torak","gilig.","","ngoko"],["bulbul","manuk guwêg.","","ngoko"],["buldan","kutha-kutha.","",""],["buli-buli","bngs. guci (gêndul) wêtênge mblêndhuk.","","ngoko"],["bulir","1 wuli, wulên; 2 dhompolan; membulir: mêthit tmr. tampar lsp.\n--- 33 ---","","ngoko"],["bulsak","kasur.","","ngoko"],["bulu","wulu, rambuting awak.","","ngoko,dialek"],["bulu mata","idêp.","",""],["bulu têngkuk","suri jaran lsp.","","ngoko"],["buluh","pring; buluh-buluh, pêmbuluh: wuluhan, bumbungan.","","ngoko"],["buluh bangsi","suling.","","ngoko"],["buluh kerongkong(-leher)","gurung.","","ngoko"],["buluh perindu","bngs. suling.","","ngoko"],["bulur","ngêlih bangêt; kebuluran: kalirên, kêluwèn, pacêklik.","",""],["bulus","brindhil tanpa pang, gabug tmr. wong.","","ngoko,arkais"],["bulus-bulus","ar. iwak sagara.","","ngoko"],["bum","bum (ing palabuhan).","","ngoko"],["bumantara","awang-awang.","","ngoko,k