g; dipersendakan: dianggo gêguyon, disêmbranani.","",""],["sendal","i disendal: dianjingake nganggo diganjêl (dipacèli, diwèhi tandhing tmr. pacul). ii disendal: diunus ngêgèt tmr. kêris lsp.","","ngoko,cakapan,dialek"],["sendalu","(angin-) angin lumrah.","","ngoko"],["sendar","ngorok lirih.","","ngoko,kasar,dialek"],["sendat","1 kêjêndhêlên, kêcêpit; 2 sumpêk tmr. ati.","","ngoko"],["sendawa","sêndawa.","",""],["sendel","bersendel: sêsèndhèn.","",""],["sendeng","ut. menyendeng: miring mèncèng tmr. panganggone kupluk lsp.","","ngoko,dialek"],["senderik","bngs. cundrik (kêris mandar).","","ngoko,dialek"],["sendering","ar. wit.","","ngoko"],["senderung","ar. kewan sagara sok mblêngkêr kaya bal.","","ngoko,dialek,arkais,arab"],["sendi","1 athik-athikan, gêgêlan, ros-rosan; 2 èngsêl lawang; 3 (batu-) ompak; 4 lapisan ing pêndhok lsp; 5 ent. dhêdhasar, têtalês; disendi(-sendi): dikêthoki gêgêlane; disendikan: 1 dilapis (ing êmas lsp); 2 (-pada) digathukake karo, didhasarake ing.","","ngoko"],["sendiri","ijèn, dhewe.","","ngoko"],["sendocong","ar. iwak loh.","","ngoko"],["sendu","sêdhih, susah.","","ngoko"],["senduduk","sênggani.","",""],["senduk","sendhok, enthong, irus.","","ngoko"],["sengaja","sêngaja, njarag.","","ngoko"],["sengal","pêgêl, ngêrês linu, lara encok.","","ngoko"],["sengam","disengam: dipangan kabèh.","","ngoko"],["sengangkang","bngs. sriti.","","ngoko"],["sengap","ngglèntèr, antêng (ora rèwèl tmr. bocah).","","ngoko,krama,dialek"],["sengarat","ar. iwak loh.","","ngoko"],["sengat","êntup; disengat: diêntup; penyengat: tawon.","","ngoko"],["sengau","bindhêng.","",""],["sengelat","tukang apus, tukang nggadhung.","","ngoko"],["senget","mêndhak sasisih, miring, dhoyong nisih.","","ngoko"],["senggara","disenggara(kan): diupakara, diopèni; kc. selenggara.","","ngoko,cakapan,arkais"],["senggau","menyanggau: 1 jinjit ngranggèh (njupuk); 2 mrèmèn tmr. gêni.","","ngoko"],["senggayut","bersenggayut: geyong-geyong, gandhul-gandhul.","","ngoko"],["senggot","nyodhok (nyikut, nyotho) ing ngiringan.","","ngoko"],["senggugut","ar. lêlaraning wong wadon; senggugut darah: lara bakda nggarap banyu; senggugut meroyan: lara bakda manak.","","ngoko,dialek,arkais,arab"],["sengguk","ut. menyengguk: dhêklak-dhêkluk.","",""],["senggulung","1 luwing; 2 gêmbus (ganjêl sunggèn).","","ngoko"],["senggut","ut. menyenggut: dhêklak-dhêkluk.","",""],["sengih","ut. tersengih: mlêngèh, mênga mluwèk tmr. tatu.","","ngoko"],["sengit","sêngit ent. dêdrêg bangêt, sêrêng.","",""],["sengkak","disengkak: diurut (dipijêti) ut. disêngkakake tmr. wêtêng.","",""],["sengkalan","bngs. lèmpèr kayu (dianggo nggêrus bumbu).","","ngoko"],["sengkang","i 1 palang, palangan mrapat; 2 palang ing èmbèr lsp; 3 rujining rodha; 4 garis têngahing cakran; 5 bêlok, cêngkalak. ii jegang sikile siji slonjor.","","ngoko,dialek"],["sengkar","saèm. dhingklik ing prau kanggo linggih kang mêlahi.","","ngoko,dialek"],["sengkarut","bersengkarut: ulêt-ulêtan, bêbulêtan, ruwêt ora karuwan (tmr. crita lsp).","","ngoko,krama"],["sengkayan","bngs. lesus ing sagara.","","ngoko"],["sengkela","bêlok; disengkela: dibêlok.","",""],["sengkelang","1 kayu palangan; 2 sidhakêp tangane nyathok pundhak; menyengkelangkan jari: ngapurancang.","","ngoko,dialek"],["sengkelat","sêngkêlat (lakên).","",""],["sengkelat","ora cêwok.","","ngoko,krama"],["sengkeling","1 mbanda tangan; 2 tumpang tali tmr. sikil; disengkeling: dibanda ing buri.","","ngoko"],["sengkelit","bngs. jirêt (tali kolongan) kanggo pancadan mènèk.","","ngoko"],["sengketa","papriksaning prakara; bersengketa: prakaran.","","ngoko"],["sengkilang","katata mrapat têtumpangan up. pêdhang.","","ngoko"],["sengkol","sêsêg wêtênge (krasa mêndhêkêl, dianggo mêmangan rêkasa).","","ngoko"],["sengkuang","bêsusu.\n--- 165 ---","",""],["sengkuap","èmpèr, ampok.","","ngoko,dialek"],["sengkul","isis sumyah.","","ngoko"],["sengsai","judhêg, kêpranan bangêt, prihatin.","","ngoko"],["sengsara","1 sangsara, cilaka; 2 (azab-, siksa-) siksa; disengsarakan: disiksa, di