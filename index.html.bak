goko"],["rumput","sukêt; merumput: golèk sukêt (ngarit), matun; rumput kemaluan: piskucing; rumput-rumputan: srompod.","","ngoko,krama,dialek"],["rumus","aksara cêkakan, up. 'a a = 'alaihi 'ssalam.","","ngoko"],["runas","merunas: nyênggut.","",""],["runcing","lancip; runcing tanduk: ora tau sêdhêkah; runcing paham: gathekan.","","ngoko,krama"],["runding","berunding: rêmbugan; merunding: 1 ngrêrantam, mêmetung; 2 ngrêmbug; dirundingkan: dirêmbug.","",""],["runduk","ndhungkluk; merunduk: 1 ndhungkluk; 2 tumêlung, tumiyung.","","ngoko,dialek"],["rundung","dirundung: tansah digodha, diribêdi, dirêridhu.","","ngoko"],["rung","balai rung: ar. bangsal ing kraton.","","ngoko"],["runggas","dirunggas: disêndhal, dirênggut, dibêdhol, dibêthot.","",""],["runggu-rangga","pating jlêgrig.","","ngoko"],["rungkai","dirungkai: diudhari ut. diuculi tmr. bundhêlan, sindhêtan lsp; kc. ungkai.","",""],["rungkap","merungkap: nyêntak, songol.","","ngoko,kasar"],["rungkas","bngs. tirêm.","",""],["rungkau","rambut jaran ing êndhas; merungkau: rembyak-rembyak nutupi rai tmr. rambut.","","ngoko"],["rungkuh","katon kaya wis tuwa; kerungkuhan: kêtuwan.","","ngoko,dialek,arkais"],["rungkup","awangun (katon) kaya gathuking payon loro.","","ngoko,dialek,arkais"],["rungut","merungut: kêdumêlan, grênêngan.","",""],["runjang","dirunjang: ditojoh-tojoh, diogrog-ogrog.","",""],["runjau","ut. merunjau: dhuwur ngronje (lêncir).","","ngoko"],["runjung","ut. merunjung: 1 mbrunjung alancip (kaya wangun ing tumpêng); 2 munjung-munjung; (se)perunjung: (sa)-dêdêg pangawe.","","ngoko,dialek,arkais"],["runtai","meruntai: nglèmbrèh, nglèwèr.","","ngoko"],["runtas","diruntas: disêndhal, ditarik ngêgèt.","","ngoko"],["runtuh","ambruk, jugrug.","","ngoko,arkais"],["runut","tipak, tilas; merunut: 1 napak tilas (nglari, tutburi, nurut); 2 sêdhih bae.","","ngoko,dialek"],["rupa","rupa; rupanya: sêmune, ayake; rupa-rupa: warna-warna; dirupakan: diwujudi, diwangun; serupa: kaya, padha rupa.","","ngoko,dialek,arkais"],["rupawan","endah.","","ngoko"],["rupiah","rupiyah.","",""],["rusa","mênjangan.","",""],["rusak","rusak, bubrah; rusak hati: susah bangêt.","","ngoko"],["rusia","wadi; kc. rahasia.","","ngoko,dialek"],["rusuh","rusuh, rêrusuh, gegeran.","","ngoko,krama,dialek"],["rusuk","(tulang-) iga; dirusuk: ditojoh, disogok.","","ngoko"],["rut","kêconggah, bisa kuwat.","","ngoko"],["ruyu-ruyu","ar. iwak loh.","","ngoko"],["ruyung","ruyung.","","arkais"],["ruyup","1 loyop (ngantuk bangêt); 2 mèh sumurup tmr. srêngenge.\n--- 153 ---\n\ns","","ngoko,dialek"]],"s":[["sa, esa","siji, sawiji.","","ngoko"],["saat","sangat, wêktu.","","ngoko"],["saba","bersaba: sêsrawungan; disaba: ditiliki, disaba.","",""],["sabak","i berbiji sabak, menyabak: nangis sêsambat. ii disabak: digodhog tmr. kilang ut. lêgèn.","","ngoko"],["saban","sabên.","",""],["saban, syaban","sasi ruwah.","","ngoko,arkais"],["sabang","layar sabang: ar. layar cilik.","","ngoko"],["sabar","sabar, sarèh.","","ngoko,arab"],["sabas","prayoga!","","ngoko"],["sabbat","dina sabat (sabtu).","","ngoko,arab"],["sabda","pangandika, dhawuh; bersabda: ngandika, paring dhawuh.","","ngoko,krama,inggil"],["sabil","dêdalan (marang allah); perang sabil (-allah): pêrang sabil (mungsuh wong kapir).","","ngoko,dialek,arkais,arab"],["sabit","i arit. ii ut. thabit: wis têtêp, wis mêsthi.","","ngoko"],["sabtu","sabtu.","","ngoko,arab"],["sabuk","sabuk, kêmbên.","","ngoko"],["sabun","i sabun. ii orang sabun: wong bule; sakit sabun: lara nguyuh nanah.","","ngoko,krama,arkais"],["sabung","bersabung: tarung; menyabung: adu jago; disabung(kan): diêdu tmr. jago; sabung menyabung: sêsambêran tmr. jago, blêdhèg lsp.","","ngoko,cakapan,arkais"],["sabur","1 uyêk-uyêkan, untêk-untêkan; 2 campur ora kêna dipilah-pilah; layar sabur: layar ing dhuwur; semut sabur: ar. sêmut; sabur limur: rêmêng-rêmêng; menyabur: ambyuk, nggrudug.","","ngoko,krama"],["sabut","sêpêt (kulit krambil).","","ngoko"],["sadai","ut. tersadai: sumèlèh sêmu miring lêlendhehan.","","ngoko"],["sadak","miring tmr. tiyang.","","ngoko,krama"],["sadang","pintu sadang sading: aling-aling sangarêping palungguhan pangantèn.","","ngoko,dialek,arkais"],["sadap","ut. penyadap: lading panderesan: disadap: didèrès.","","ngoko,dialek"],["sadar","i dhadha, perangan ngarêp. ii 1 (-akan, -kan) eling marang, rumangsa: 2 (-daripada) eling, nglilir saka sêmaput, turu lsp; kc. sedar.","","ngoko,arkais"],["sadau","menyadau: mêlahi nganggo wêlah dawa; disadau: dipagas ingisor tmr. tala.","","ngoko,arkais"],["sadik","têmên-têmên tmr. pamitran.","",""],["sading","kc. sadang.","",""],["sadir","uyah amoniyak.","","ngoko,dialek"],["sado","sadho (ar. kreta).","","ngoko,dialek"],["sadu","pinunjul, utama bangêt; sadu perdana: kang pinunjul dhewe.","","ngoko,dialek,arkais,sanskerta"],["sadur","sadur; disadur: disadur, disêpuh êmas lsp.","","ngoko,dialek"],["saf","larik(an); kc. sap.","","ngoko"],["safa","têrang.","",""],["safar","sasi sapar.","","ngoko,arkais,arab"],["safi","murni, rêsik, bênêr.","","ngoko"],["safir","wong lêlungan; kc. musafir.","","ngoko,arkais"],["saga","(-pohon, -kendiri): saga (têlik, -thunthêng).","","ngoko"],["sagai","ar. iwak sagara.","","ngoko"],["sagang","dhoyong rubuh tmr. tumbak, bêdhil lsp; disagang: dipèpèti ing tumbak lsp. kang didhoyongake.","","ngoko,dialek"],["sagar","i sruwa duk. ii gula.","","ngoko,dialek"],["sagu","sagu.","","ngoko"],["sagun (-sagun)","sagon.","","ngoko"],["sagur","lunasing prau wrata.","","ngoko,dialek"],["sah","i sah, absah, bênêr ut. nyata; disahkan: disahake, dianggêp bênêr ut. nyata. ii sêkak! (tmr. main catur).","","ngoko,krama,cakapan,arkais"],["sahabat","mitra, kanca.","","ngoko"],["sahadat","sahadat (pangandêl islam).","","ngoko,arab"],["sahaja","1 mung, ngêmungake, bae; 2 ut. bersahaja, pasaja, barès; 3 (dengan-) kalawan njarag; disahajakan: 1 dilugokake, dibarèsake; 2 disêngaja, disêdya, dijarag.","","ngoko,krama"],["saham","panduman.","",""],["sahan","saèm. lèmpèr (layah).","","ngoko"],["sahaya","1 (hamba-) batur; 2 (ut. saja) inggih.","","ngoko"],["sahbandar","panggêdhe palabuhan.","",""],["sahda, syahda","endah.","","ngoko"],["sahi","kèthèr, weya.","","ngoko"],["sahib","kang duwe.","","ngoko,dialek"],["sahibulhikayat","kang duwe crita, pangarang.\n--- 154 ---","","ngoko,dialek"],["sahid","syahid, saksi bab kanyataaning agama.","","ngoko"],["sahih","nyata, têrang; kc. sah.","","ngoko,krama,cakapan,arkais"],["sahur","saur.","","ngoko"],["sahut","wangsulan; menyahut: mangsuli; disahuti: diwangsuli.","","ngoko"],["sahwat","sahwat, cumbana.","","ngoko,arkais"],["said","sayid.","","ngoko,arab"],["saidi","bêndara kula.","","ngoko,krama"],["saidina","bêndara kula.","","ngoko,krama"],["saing","bersaing(an): 1 bêbarêngan lêlayaran; 2 jor-joran, rêbut unggul; disaingi: 1 dibarêngi ênggone lêlayaran ut. lêlungan; 2 dijori; persaingan: konkirèn, jor-joran.","","ngoko"],["sair, sya'ir","têmbang, kidung; penyair: tukang ngarang kidung.","","ngoko"],["sais","kusir.","","ngoko,dialek,walanda"],["sait","disait: diirisi tipis-tipis, dikêlèti dioncèki; kc. sayat.","","ngoko,dialek"],["saja","bae, kc. sahaja.","","ngoko"],["saja, sajak","1 guru lagu ut. purwakanthi ing syair ut. pantun; 2 wiramaning têmbang, kidung.","","ngoko,krama,arkais"],["sajadah","klasa lèmèk sêmbayang.","","ngoko"],["saji","ut. sajian: rampadan; disajikan: diladèkake, dicawisake.","",""],["sak","kc. syak.","",""],["saka","kc. pusaka; saka-baka: prakara warisan, kawajiban marang ratu.","","ngoko,dialek"],["sakai","1 karerehan, bawah; 2 ar. bangsa ing malaka.","","ngoko"],["sakal","nampêk lakuning prau tmr. angin; disakal: dithuthuk, digêbug.","","ngoko"],["sakar","gula.","","ngoko"],["sakarat","sêkarat; kc. sakratu'lmaut.","",""],["sakat","i disakat: dirêridhu, diganggu-gawe; tersakat: kandhas tmr. prau. ii bngs. kêmladheyan, simbar lsp.","","ngoko"],["sakatimuna","ar. naga ing crita.","","ngoko"],["sakinat","katêntrêman.","",""],["sakit","1 lara; 2 (ut. penyakit) lêlara; 3 ent. rêkasa, kangelan; sakit bulan: grahana rêmbulan; sakit hati: lara atine; sakit sampar (ta'un): pagêblug, lêlara nular; menyakiti: nglarani; bersakit(-sakit): kanthi rêkasa; di(per)sakiti: dipilara, disêrikake atine; pesakitan: pasakitan.","","ngoko,krama,inggil,dialek"],["sakratulmaut","sêkarat.","",""],["saksama","sa'sama: 1 sabar, mêmpêng, mathêm; 2 têmên-têmên, tliti bangêt tmr. mêmriksa lsp.","","ngoko,arkais,arab"],["saksi","sêksi, pasêksèn; disaksikan: 1 disêksèni; 2 (ut. dipersaksikan) dinyatakake.","",""],["sakti","1 sêkti; 2 (ut. kesaktian) kasêktèn.","",""],["saku","sak, kanthongan.","","ngoko,cakapan"],["salah","salah, luput, kliru; salah dengar: kliru pangrungune; salah faham (tampa): salah tampa; salah hati: nêpsu; salah kata: kêclenthot têmbunge; bersalah: salah; bersalahan: beda, sulaya, ora cocog; disalahi: disalahi, dipadoni, dipapali gunême; disalahkan: 1 disalahake, diluputake; 2 diendhani.","","ngoko,krama,arkais"],["salah-silih","sakèhing kaluputan.","",""],["salai","ikan salai: iwak dikukus; disalai: dikukus ut. digarang tmr. iwak.","","ngoko,dialek"],["salak","i salak. ii panjugug; menyalak: njugug, njêgog.","","ngoko"],["salam","1 slamêt; 2 salam (tabe); memberi salam: uluk salam.","","ngoko,dialek,arab"],["salang","disalang: disuduk ing kêris saka sadhuwuring balung salang têrus ing jantung.","","ngoko,arkais"],["salapan","wolu; kc. delapan.","","ngoko"],["salasal","lara gulanên.","","ngoko"],["salasilah","salasilah.","","ngoko"],["salat","salat, sêmbahyang.","","ngoko,arab"],["salatin","para sultan.","","ngoko,arkais"],["salawat","slawat, pandonga, sêmbahyangan.","","ngoko"],["salek","(wong lêlungan) ngambah ing alam gaib; kc. suluk.","","ngoko,arkais"],["sali","kuwat, bisa lumawan; sama sali: babag, tandhing.","","ngoko,dialek"],["salib","salib.","","ngoko,arab"],["salin","bersalin: 1 ganti, malih; 2 mbabar (duwe anak); disalin: 1 disalini; 2 ditêdhak, diturun; 3 dijarwakake (dipêrtal); dipersalin: diganjar sandhangan; persalin(an): ganjaran sandhangan; salinan: 1 turunan, têdhakan; 2 pêrtalan.","","ngoko,krama,dialek"],["saling","gênti-gêntèn, kc. saling menolong (tulung tinulung).","","ngoko"],["salju","salju.","","ngoko,arab"],["sallallahu 'alaihi wasallama","mugi gusti allah paring katêntrêman marang dhèwèke (kanggo nyêbut asmane k.n. mochamad, dicêkak s.a.w.).","","ngoko,krama,inggil,arab"],["salung","bngs. suling; salung api: sêmprong.\n--- 155 ---","","ngoko,arkais"],["salur(an)","talang, bumbungan dalan banyu, kalenan.","","ngoko,dialek"],["salut","salut, srasah, blongsong.","","ngoko,dialek"],["salèh","mursid, wêkêl, utama.","","ngoko,sanskerta"],["sama","1 padha; 2 (ut. bersama-sama) bêbarêngan; 3 trêp, bênêr, kyt. sama tengah (têngah bênêr); 4 (ut. sesama) pêpadha; 5 pisan, up. sama kêduanya (karopisan); sama sekali: babarpisan, kabèh; 6 pacalathon uga atêgês karo, nganggo, dening; sama sendirinya: dhewekan; disamai: dipadhani; di(per)samakan: dipadhakake; menyama-nyama: mêmadhani.","","ngoko,dialek,arkais"],["samadi","sêmadi.","",""],["samak","i samak (wlulang mangsakan); disamak: dimangsak tmr. wlulang. ii ar. wit.","","ngoko"],["saman","panyêrêging pradata.","","ngoko"],["samar","samar, samun; samar muka: rêmêng-rêmêng ngarêpake surup srêngenge; menyamar: nyamar, nyamoor; sêsinglon; disamarkan: disamar, disamur; nama samaran: jênêng sêsinglon.","","ngoko,krama,dialek,arkais"],["sambal","sambêl.","",""],["sambalewa","sêmbrana, gêlêm ora-ora; menyambalewa: nggêgarap gêlêm ora-ora (sêmbrana).","",""],["sambang","i (ut. bersambang) sambang, rondha, nganglang. ii tala tawon suwung.","","ngoko,dialek,arkais"],["sambar","disambar: disambêr.","",""],["sambat","i ut. bersambat: gandhèng, gathuk dadi siji; disambat: digandhèng, digathukake dadi siji; menyambut tangan: ngapurancang. ii bersambat: nyambat, ngrêsaya.","","ngoko"],["sambau","bngs. sukêt.","",""],["sambil","kambi, karo; sambil menyambil: nyambi, ngiras karo.","","ngoko,dialek"],["sambuk","sambuk, pêcut.","","ngoko"],["sambung","disambung: 1 disambung; 2 ditutugake tmr. crita; sambungan: sambungan, tutuge.","","ngoko"],["sambur-limbur","rêpêt-rêpêt, rêmêng-rêmêng (jam 6 sore).","","ngoko"],["sambut","bersambutan dengan: cocog (laras) karo; disambut: 1 ditampa, ditampani kanthi urmat; 2 dipapagake kanthi urmat, ditanggapi tmr. sasmita; 3 dikulak nanging diutang tmr. dagangan; sambutan dagangan: dagangan kulakan kang diutang.","","ngoko,dialek,arkais"],["sami","ar. pandhita budha.","","ngoko"],["samir","rèntèngan godhong sagu (wêlit sagu, dianggo payon lsp); disamir: diwêlit tmr. godhong sagu.","","ngoko"],["sampah","uwuh, larahan.","","ngoko"],["sampai","i 1 têkan, tutug; 2 nganti, kongsi; 3 kêlakon têmênan tmr. impèn lsp; 4 dukup, sêdhêng; disampaikan: 1 ditêkakake, ditutugake; 2 dilantarake, diaturake, diulungake; 3 dituruti, dilêksanani. ii menyampai: sumampir; disampaikan: disampirake; sampaian: sampiran, pamemeyan.","","ngoko,arkais"],["sampai-hati","têgêl, têga, mêntala.","",""],["sampak","i alèn-alèn kuningan lsp. dianggo karah ing bongkot lan pucuking tulup. ii main sampak: ar. mainan nganggo toh dhuwit; seluar sampak: kathok kalèt.","","ngoko,krama,dialek"],["sampan","ar. prau cilik.","","ngoko"],["sampang","i menyampang: mêlahi prau ana ing canthik ngarêp. ii sampang.","","ngoko"],["sampar","lêlara nular (pagêblug).","","ngoko"],["sampil","upih.","","ngoko"],["samping","i bngs. kêtipung (tambur) keling. ii têmbing, pinggir, sandhing; disampingkan: dicakêtake, disandhing, dijèjèrake.","","ngoko"],["sampir","wrangka kêris kang dhuwur.","","ngoko,dialek,arkais"],["sampu","i lêlaranên, uncrit-uncritên. ii menyampu: mandhêg ut. lèrèn tmr. dolanan.","","ngoko"],["sampuk","disampuk: 1 ditumbuk, dibêntus, dikabruk, ditladhung; 2 digathukake pucuke tmr. tumbak lsp; 3 ditrambul tmr. rêmbug lsp.","","ngoko"],["sampul","ulês, blongsong, bungkus, tapih layang, amplop; disampul: diulêsi, diblongsong, disamaki tmr. layang lsp. diamplopi.","","ngoko,dialek"],["samsam","ut. siam samsam: pranakan wong\n--- 156 ---","","ngoko,dialek,arkais"],["samsir","pêdhang gêdhe.","","ngoko"],["samsu","syamsu, srêngenge.","",""],["samudera","samodra (sêgara gêdhe).","","ngoko,arkais"],["samun","semak samun: rêrungkudan, gêgrumbulan; menyamun: mbegal; disamuni: dibegal; penyamun: begal.","","ngoko,dialek"],["sana","kana.","","ngoko"],["sanak(-saudara)","sanak sadulur.","","ngoko"],["sanat","taun, up. sanat masèhi.","","ngoko"],["sanatulhijrat","taun ijrah.","","ngoko"],["sandang","slendhang,samir, slempang; 1 disandang(kan): - dicangklong ing pundhak; 2 (ut. dipersandangkan) disampirake ing pundhak, dislempangake.","","ngoko,cakapan,dialek,arkais"],["sandar","bersandar: lendheyan, sumendhe; sandar menyandar: lendheh-lendhehan; disandarkan: dilèndhèhake; (per)sandaran: lendheyan ing kursi lsp.","","ngoko"],["sandera","mujangan, wong kang dianggo tanggungan (cêkêlan); disanderakan: dianggo mujangan, dianggo cêkêlan.","","ngoko,dialek,arkais"],["sanding","i ut. bersanding: sandhing. ii lingir; bersanding: nglingir.","","ngoko"],["sandiwara","sandiwara (tonil).","","ngoko,walanda"],["sandung","pidakan ut. pancatan ing panênunan lsp; tersandung: kêsandhung.","","ngoko"],["sang","sang.","","ngoko,arkais"],["sanga","têtaining luluhan logam.","","ngoko"],["sangai","kêkêp (tutup kukusan), tutup saji kang digawe nipah.","","ngoko,dialek"],["sangat","bangêt.","",""],["sangga-langit","sangga-langit.","",""],["sangga-lutung","bngs. rambutan.","","ngoko"],["sanggah","disanggah: dilawan, ditampik, diêmohi.","",""],["sanggam","disanggam: digadhuh, disilih sawatara suwene.","",""],["sanggamara","1 palangan ing wilahan tumbak; 2 ganthol prau.","","ngoko"],["sanggan","1 cuwak, sanggan, uwat-uwat; 2 (-bunuh) tumbal, tulak; sangga-sangga: paladèn ing kraton; disangga: disangga, dicuwak, diduwa; penyangga: sanggan, cuwak, plangkan; penyangga pedang: blêngkêr ing cêkêlan pêdhang.","","ngoko"],["sanggan","bngs. bokor kuningan.","","ngoko"],["sanggang","disanggang: dijunjung tangan loro sarana disangga ing ngisore.","","ngoko"],["sanggat","rada kandhas (nanggor dhasar) tmr. prau.","","ngoko"],["sangggit","menyanggit: kêrit-kêrit, kêrot-kêrot; menyanggit gigi: kêrot untu.","","ngoko"],["sanggul","gêlungan.","",""],["sanggup","sanggup, kêduga, kêconggah, saguh.","","ngoko,dialek"],["sanggurdi","sanggawêdhi.","",""],["sangka","i pangira, panyana; disangka: dikira, dinyana; disangkakakan: dikira, diarani. ii bngs. keyong gêdhe.","","ngoko,krama"],["sangkak","disangkak(i): dipalangi, dialang-alangi, dicêgah.","",""],["sangkakala","kêlasangka (slomprèt).","","ngoko"],["sangkal","i disangkal: diselaki, dibalak, dipadoni; disangkalkan: dicêgah, ditangkis, ditanggulang. ii garan wadung (palu lsp).","","ngoko"],["sangkap","sangkêp; ganêp; pêpak; cukup.","","ngoko"],["sangkar","i ut. sangkaran: kurungan. ii garis têngah lmr. tmr. prau. iii kolongan, karah, suh, lsp. ing landheyan.","","ngoko,arkais"],["sangkar-bidang","palang ing têngahing prau.","","ngoko"],["sangkil","1 têkan ing êndon tmr. prau, lêlungan lsp; 2 kêna pamanahe, pambêdhile lsp; 3 tumama tmr. jamu.","","ngoko"],["sangku","bngs. bokor gêdhe.","","ngoko"],["sangkur","(mata-) sangkuh bêdhil.","","ngoko"],["sangkut","bersangkut: 1 sumangsang, cumanthèl, nggayut; 2 kandhêg tmr. ginêm, lumaraping pêdhang lsp; bersangkutan: gêgayutan; tersangkut: kêsangkut; sangkutan: pêpalang, rêribêd.","","ngoko"],["sangkut-paut","1 gêgayutan, gèndèng cènèng; 2 bot-repot; sangkut paut dengan piutang: utange rèndhèl.","","ngoko,dialek"],["sangsi","gojag-gajêg, sujana, ora pati ngandêl.","","ngoko,krama,arkais"],["sangu","agêr-agêr alus.","","ngoko"],["sanjiman","prau kapal gêdhe.","","ngoko,krama"],["santak","disantak: disotho, dijotos.","",""],["santan","santên; kepala santan: santên kanil.","","ngoko,cakapan,dialek"],["santap","dhahar, ngunjuk; santap sirih: nggantèn.","","ngoko,inggil,dialek"],["santau","ar. wisa.","","ngoko"],["santeri","santri; kc. senteri.","","ngoko,dialek"],["santuk","menyantuk: natap, njêglug; kc. antuk.","","ngoko,krama"],["santun","alus tmr. patrap; sopan santun: sarwa alus patrape.","","ngoko,dialek"],["sanubari","sanubari.","","arkais"],["sanya","bahwa sanya (bahwa sesungguhnya): salugune, sanyatane.\n--- 157 ---","","ngoko"],["sap","i gombal ing wadhah mangsi; kertas sap: pèl. ii sap, larikan; bersap-sap: lêlarikan, jèjèr-jèjèr.","","ngoko"],["sapa","bersapaan, tegur sapa: aruh-aruh, omong-omongan kalawan manis; disapa: diaruh-aruhi.","","ngoko,krama,dialek,arkais"],["sapar","sasi sapar.","","ngoko,arkais,arab"],["sapau","gubug cilik kanggo tambêl.","","ngoko"],["sapi","sapi.","","ngoko"],["sapih","i satêngah pêpês (lumpuh, jimpe). ii sapih, pisah.","","ngoko"],["sapir","i sipir (tukang ngrêksa kunjara). ii bersapir: lêlungan mrana-mrana; kc. musafir.","","ngoko"],["sapu","1 usap, sikat; 2 (ut. penyapu) sapu, kêlud; disapu: 1 diusapi, dibusêk; 2 disaponi, dikêludi; 3 disapu (digêbugi); disapukan: diusap-usapake, diusarake.","","ngoko,dialek"],["sapu-tangan","saptangan, kacu.","","ngoko"],["saput","disaput: dilimputi, kêsaput.","",""],["sar","mak srêng, krênyês.","","ngoko,cakapan,dialek"],["sara","1 suminggah saka ing bêbaya; 2 pangrêksaning urip (kayata sarana pancèn pangan, pènsiyun lsp); 3 bageyaning brandon nyambut gawe, dagang lsp; menyara, bersara: mèlu brandon nyambut gawe.","","ngoko,dialek,arkais"],["sara, syara'","anggêr-anggêr agama.","","ngoko"],["sara-bara","buyar mrana-mrana.","","ngoko"],["saraf","i paramasastra bab rêrimbaganing têmbung; 'ilmu saraf: paramasastra. ii sarap, talirasa.","","ngoko,dialek,arkais,arab"],["sarak","bersarak: pisahan; disarak: dipisah, dipêgat, disapih.","",""],["saran","lesan.","","ngoko"],["sarang","susuh; bersarang: nusuh; sarang kuli: salang wadhah kuwali; sarang labah-labah: klamat kêmangga; sarang lebah: omah tawon (glodhog); sarang madu: tala.","","ngoko,dialek,arkais"],["sarap","i (-sampah) larahan (uwuh) kang lêmbut-lêmbut; sarap laut: rêrêgêd ing sêgara. ii sarap pangrasa, talirasa. iii lara mlècèt ing wlakang lsp.","","ngoko,dialek"],["sarat","sarat (kêbak momotan); bunting sarat: mêtêng tuwa.","","ngoko,dialek"],["sarau","bngs. kranjang gêdhe kanggo golèk agêr-agêr.","","ngoko"],["sari","cukat, trêngginas.","","ngoko,arkais"],["sari","kêmbang, pari.","","ngoko"],["saring","i disaring: diplintir tmr. lawe lsp. ii disaring: disaring; saringan: saringan.","","ngoko,dialek"],["sarip","sarip (sêbutan wong arab).","","ngoko,arkais"],["saripah","saripah (sêbutan wong arab wadon).","","ngoko,arkais"],["sarsar","gèndhèng; kc. sasar.","","ngoko"],["saru","bngs. cêmara.","",""],["saruk","tersaruk: kêjêngklok, katêkuk sikile.","",""],["sarun","saron.","","ngoko"],["sarung","1 sarungan, wrangka; 2 ulês, blongsong; 3 (kain-) sarung; sarung jari: cincin; sarung kaki (-tangan): mojah sikil (tangan); disarungkan: disarungake tmr. kêris lsp. dilêbokake ing ulês lsp.","","ngoko,dialek,arkais"],["sarwa","sarwa, sakabèhe.","","ngoko"],["sarwal","kathok.","","ngoko"],["sasa","sêntosa, pêngkuh, kuwat.","","ngoko"],["sasak","sasak, tabag, gèdhèg kasar.","","ngoko,kasar,dialek"],["sasap","kc. susup.","","ngoko"],["sasar","i gèndhèng. ii sasaran: lesan, pangincêngan.","","ngoko"],["sastera","buku, layang, buku suci.","","ngoko"],["sasterawan","ahli kawruh, ahli kitab suci.","","ngoko,arab"],["sat","ar. takêran (= 5 ut. 10 gantang).","","ngoko"],["satai","sate.","","ngoko"],["satu","siji; satu-satunya: sawijining (ngêmungake siji); satu persatu: saka siji; bersatu: nunggal, ngumpul; di(per)satukan: didadèkake siji, ditunggalake.","","ngoko,arkais"],["satwa","kewan, kc. setua.","","ngoko,arab"],["sau","mak krês, nyos; kc. desau.","","ngoko,cakapan,dialek"],["saudagar","sudagar.","","ngoko"],["saudara","sadulur, saudara sepupu: nak-sanak; saudara sejalan sejadi: sadulur tunggal bapa-biyung; persaudaraan: pasaduluran, pamitran.","","ngoko,krama"],["sauh","i jangkar; membuang sauh: labuh jangkar; membongkar sauh: bêdhol jangkar. ii buah sauh: sawo.","","ngoko"],["saujana","sayojana; kc. yojana.","","ngoko,arkais"],["sauk","i ut. sauk-sauk: bngs. jaring diseropake; sauk-menyauk: gayut-gayutan; disauk: 1 digèndèng sarana dirangkul, digujêngi kêncêng nganggo tampar lsp. diubêdake; 2 dicidhuk; dicawuk; dirauk kambi mlaku.\n--- 158 ---","","ngoko,dialek"],["saum","pasa.","","ngoko,arkais"],["saur","saur (mangan ing wayah bêngi ing sajrone pasa).","","ngoko,inggil,dialek,arkais"],["sawa","ular sawa: ula sawa.","","ngoko,dialek,arkais"],["sawab","i (ut. tsawab) kang sanyata. ii (ut. thawab) ganjaran ing ngakerat.","","ngoko,dialek"],["sawah","sawah; sawah bencah: sawah sorotan; sawah berbandar langit: sawah tadhahan; menyawah: nênandur ing sawah.","","ngoko"],["sawal","sasi sawal.","","ngoko,dialek,arkais,arab"],["sawan","laran sawan; sawan babi (gila): ayan.","","ngoko"],["sawang","i warnaning banyu sêgara ing pinggir. ii (-langit) awang-uwung.","","ngoko,dialek"],["sawar","pagêr ut. sangkrah-sangkrah dianggo nggiring kewan alasan ut. iwak; disawar: ditrapi pagêr ut. sangkrah.","","ngoko,dialek,arab"],["sawat","bngs. sabuk (slempang) salaka.","","ngoko"],["sawi-sawi","i sawi. ii wong nunut nunggang prau nganggo ngrewangi nyambut gawe minangka pambayaring opahane.","","ngoko,dialek,arkais"],["saya","kula; kc. sahaya.","","ngoko,krama,arkais"],["sayak","bokor bathok; bêruk; kc. batil.","","ngoko"],["sayang","1 eman, owêl; 2 mêmêlas, mêsakake; 3 (kasih-) trêsna, asih; 4 (-akan, -kan) wêlas marang, asih marang; menaruh sayang: eman, wêlas, asih; disayangkan: 1 dieman, diowêl; 2 (ut. disayangi) diwêlasi, disihi.","","ngoko,dialek"],["sayap","1 suwiwi, lar; 2 pênjawating baris; sayap kumbang: irêng mêlêng-mêlêng; sayap sandang: rante mas loro kaêtrap ing dhadha.","","ngoko,dialek"],["sayat","disayat: diirisi tipis-tipis, dikêlèti, dioncèki.","",""],["sayembara","sayêmbara.","",""],["sayu","trênyuh, sêdhih nglangut; sayu rayu: sêdhih bangêt, kêranta-ranta.","","ngoko"],["sayup","i (ut. sayup-sayup) lamat-lamat tmr. swara ut. pamandêng; 2 cupêt ut. kadung tmr. mbalang, mbêdhil lsp; 3 kêtinggal, kêpancal; sayup mata mamandang: sapandêlêng.","","ngoko"],["sayur","jangan, jêjanganan; sayur mayur: jêjanganan; sayur-sayuran; menyayur: kêlan, njangan; disayurkan: dikêla.","","ngoko"],["sebab","sabab, jalaran.","","ngoko"],["sebagai","kaya, saèmpêr.","","ngoko,dialek,arkais"],["sebah-serbih","pating slêmbrèh.","","ngoko"],["sebai","i sondhèr, sampur. ii bngs. kêmladheyan.","","ngoko"],["sebak","1 mbludag, lubèr, banjir; 2 crocosan tmr. luh.","","ngoko,cakapan"],["sebal","gêla, susah.","","ngoko"],["sebam","klawu sêmu irêng.","","ngoko"],["sebar","i menyebar: krasa kranyas-kranyas ing awak. ii disebar(kan): disêbar.","","ngoko,cakapan,dialek,arkais"],["sebarang","sadhengah, sêmbarangan.","",""],["sebarau","ar. iwak.","","ngoko"],["sebasah","ar. wit.","","ngoko"],["sebat","disebat: disabêt.","",""],["sebaya","babag, barakan, pantaran.","","ngoko"],["sebekah","ar. iwak kali.","","ngoko"],["sebelah","1 sisih, sasisih; 2 siji ut. sasêle tmr. barang rakitan; disebelah: ing sisih, sandhing; sebelah menyebelah: ing sakiwa têngêne (kali, dalan lsp); menyebelah: nisih, ent. bau kapine; kc. belah.","","ngoko,dialek"],["sebelas","sawêlas; kesebelasan: sawêlasan tmr. bal-balan.","","ngoko"],["sebentar","sadhela.","",""],["seberang","sabrang, sisih ing têbing kanane (tmr. kali, sagara lsp); menyeberang: nyabrang; seberang menyeberang: padha dene dumunung ing sapinggiring kali (tmr. desa lsp); diseberangi: disêbrangi; berseberangan: arêp-arêpan.","","ngoko,dialek"],["seberhana","saprabot tmr. sandhangan, rêrênggan lsp; seberhana bumi: saisining bumi kabèh; seberhana hari: sadina muput.","","ngoko,arkais"],["sebih","kêmbang gêdhang (ar. têtuwuhan).","","ngoko"],["sebik","menyebik: nyungir.","",""],["sebu","kêbak jêjêl; disebu: diisèni nganti kêbak, diurug.","","ngoko"],["sebuk","menyebuk: mlaku saantarane wong jèjèr-jèjèr.","","ngoko,dialek,arkais"],["sebun","1 ora nganti rampung tmr. pagaweyan lsp; 2 ora nganti matêng tmr. olah-olahan lsp.","","ngoko,krama"],["seburu","ar. têtuwuhan.","",""],["sebut","disebut: 1 disêbut, disêbutake, diarani; 2 dipratelakake, diucapake; sebutan: 1 pocapan, kang disêbutake, pakêcapan; 2 sêsêbutan; 3 andharaning jêjêr (ing paramasastra).\n--- 159 ---","","ngoko,dialek,arkais"],["sedak","i wangkisan (blêngkêr) kendhang lsp; disedak: diwangkis. ii tersedak: kêsêlak. iii ar. wit.","","ngoko"],["sedan","tersedan-sedan: sênggruk-sênggruk, kamisêsêgên.","",""],["sedang","1 sêdhêng(an); 2 nêdhêng-nêdhênge, pinuju, lagi; 3 (ut. sedangkan) salagine, sing ... bae; disedang: dicoba tmr. klambi lsp.","","ngoko,krama"],["sedap","enak, mirasa, kêpenak tmr. pangrasa; sedap hati: lêga, sênêng atine; sedapan: panganan sêgêr-sêgêran.","","ngoko"],["sedap-sedu","mirasa bangêt.","","ngoko"],["sedar","1 (-akan, -kan) eling marang, rumangsa; 2 (-daripada) eling ut. nglilir saka ênggone sêmaput lsp.","","ngoko,arkais"],["sedat","ora gumathok pamikire.","","ngoko,krama"],["sedekah","sidhêkah, slamêtan, dana.","","ngoko"],["sedekala","tansah, kaya adat sabêne.","","ngoko,dialek,arkais"],["sedelinggam","cèt abang (mêni).","","ngoko"],["sederhana","sêdhêngan, samadya.","","ngoko"],["sederiah","bngs. klambi rangkêpan.","","ngoko"],["sedia","i sadhiya, cumawis, siyaga; bersedia: cêcawis, cumawis, sumadhiya; disediakan: disadhiyakake, dicawisake; persediaan: sêdhiyan, cawisan, tandhon. ii kang dhingin, biyèn, kuna.","","ngoko,krama,dialek"],["sediakala","1 tansah; 2 kaya adat sabêne, kaya kang uwis.","","ngoko,cakapan,dialek,arkais"],["sedih","sêdhih, susah.","","ngoko"],["sedikit","sathithik, rada.","","ngoko"],["sedondon","padha warnane.","","ngoko"],["sedu","i tersedu-sedu: sênggruk-sênggruk, sêgunên, kamisêsêgên. ii disedu(h): disoki wedang.","",""],["seduayah","sidawayah (ar. têtuwuhan).","","ngoko"],["sedut","suntrut sêdhih.","","ngoko"],["sega","klimis, alus gilap.","","ngoko"],["segah","mbêsêsêk, sêbah.","",""],["segal","mulad-mulad murub.","","ngoko"],["segala","kabèh, sakabèhe.","","ngoko"],["segan","suthik, sungkan; menyegan: ngêmohi, nampik, sungkan.",