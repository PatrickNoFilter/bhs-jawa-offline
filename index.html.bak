,"rancangan, cêngkorongan.","",""],["denai","dalan ing alas (ambah-ambahane buron alas); tapaking buron alas.\n--- 47 ---","","ngoko,dialek"],["denak","1 kunthèt, cebol tmr. kewan; 2 (burung-) jontrot.","","ngoko,cakapan,dialek,arab"],["dencing","swara krincing, cring, thing.","","ngoko,dialek"],["denda","1 gada, gêbug; 2 dhêndha; kena denda, didenda: didhêndha.","","ngoko"],["dendam","kapidêrênging ati (kangên, nêdya, malês lsp.); dendam semara (berahi): kedanan; rindu dendam: kangên bangêt; menaruh dendam, mendendam: êndhêm-êndhêman, ngincim-incim.","","ngoko"],["dendang","1 dhandhang (gagak); 2 (timun dendang, pedendang) timun abang; 3 ar. prau. 4 mênyanyian nalikane nyambut gawe lsp.; berdendang: mênyanyi karo nyambut gawe lsp.","","ngoko"],["dendeng","dhèndhèng.","","ngoko"],["dengak","mendengak: linggih nglèyèk.","","ngoko"],["dengan","i 1 karo, nganggo, kalawan; 2 dening, krana, up. dengan takdir allah; 3 awit saka, up. dengan perintah raja; 4 sarta, tur, up. besar dengan tingginya; tiada dengan: tanpa. ii (hamba dengan): 1 rewang, batur tukon; 2 aku, kula.","","ngoko,krama,arkais,arab"],["dengar","mendengar, menengar: krungu, ngrungu; didengar(kan): dirungokake, ditilingake, diwigatèkake; pendengar: 1 (ut. pendengaran) pangrungu; 2 wong ut. piranti (kang) ngrungokake; pendengaran: 1 kang dirungu; 2 pangrungu; diperdengarkan: diunèkake supaya wong liya krungu; dengar-dengaran: 1 rêrungonên; 2 jare-jarene, kabar-kabare; terdengar: kêprungu, krungu; kedengaran: krungu.","","ngoko,cakapan,dialek,arkais"],["dengik","swara mak gablug (blug).","","ngoko,cakapan,dialek"],["dengkang","hung-hung (swarane wong watuk lsp.).","","ngoko,arkais"],["dengkang-dengkol","pating bêdhêgol.","","ngoko"],["dengkel","kumêt daging, sathithik daginge, tanpa banyu tmr. wowohan.","","ngoko,dialek"],["dengki","1 (-hati) drêngki, jail; 2 (-akan) gêthing marang.","","ngoko"],["dengking","swaraning panjêlih, asu klengkengan lsp.; mendengking: 1 njêrit, njêlih; 2 klengkengan.","","ngoko"],[