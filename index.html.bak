],["baring","berbaring: sumèlèh têturon; dibaringkan: diturokake.","",""],["baris","1 garis; 2 larik, larikan, jejeran; 3 baris tmr. prajurit; 5 (-diatas, -dibawah, didepan, -mati) ar. sandhangan ing aksara arab yaiku fatah, kasrah, lamah, jasam); berbaris: baris, tatabaris; membaris: 1 blajar baris; 2 nggawêng tmr. teja lsp; barisan: 1 (bukit barisan) gunung kêndhêng; 2 gêgolonganing prajurit.","","ngoko,dialek,arkais"],["barkas","kapal barkas: kapal api cilik.","","ngoko,krama,dialek,arkais"],["baru","i ut. baharu: anyar, mêntas bae, lagi. ii wit waru.","","ngoko"],["baruh","palêmahan ing ngisor (cakêt kali, pasisir lsp).","","ngoko"],["barung-barung","gubug, omah tambêlan, pakajangan.","","ngoko"],["barungsai","barongan.","","ngoko"],["barus","kapur barus: kampêr.","","ngoko,dialek"],["barusan","lagi, mêntas bae.","","ngoko"],["barut","blêbêd, ubêl-ubêl; dibarut: diblêbêd.","",""],["barwa","grobog, pêthi gêdhe.","","ngoko"],["barzakh","jaman antarane pati karo tangining badan.","","ngoko,krama,arkais,sanskerta"],["barèh","utang.","","ngoko"],["basa","basa; kc. bahasa.","","ngoko,dialek"],["basah","têlês; dibasahkan: ditêlêsi; basahan: sandangan têlêsan (padinan).","","ngoko"],["basah kuyup","têlês klêbus.","",""],["basai","ngêmbus-êmbus (abuh lêlaranên).","","ngoko"],["basal","1 abuh ngêmbus-êmbus; 2 (-angin) mlênthing.","","ngoko"],["basat","bangsat.","","ngoko"],["basau","atos kriyak-kriyak.","","ngoko,krama"],["basi","i 1 basèn (cowokan dhuwit sing diijolake); 2 wuwuhan, anakan, undhakan pagaweyan lsp. ii wayu, wis mèh mambu.","","ngoko,krama,arkais"],["basir","waskitha, mahawikan.","","arkais"],["basit","lamba; al-basit: kang sawiji (allah); bilangan basit: cacah lamba (3, 5, 7, lsp).","","ngoko,dialek,arab"],["basmi","dibasmi: 1 diobong; 2 disirnakake.","",""],["basuh","dibasuh: dikumbah, diwasuh, diwisuhi; pembasuh baluh, pembasuh meja: wragad prakaran; pembasuh mulut: panganan ut. ombèn-ombèn sabakdane mangan; pembasuh tangan: pituwasing kangelan (opahan m