<script>
"use strict";
/* Basa Jawa Offline v1.0 — UI kamus. Data dari kamus_data.js (dibangkitkan tools/). */

var FILTER = "";          // filter tingkat tutur: "" = semua
var LETTER = "";          // bucket aktif A-Z / #
var lastSecs = [];        // seksi hasil aktif [{key,title,list,shown}]
var lastQ = "";           // query aktif (untuk tombol "muat lagi")
var lastHasTr = false;    // ada kartu terjemahan? (sembunyikan hint "tidak ketemu")

/* ---------- normalisasi: huruf kecil + lipat ejaan lama (dj/tj/oe) + diakritik --- */
function norm(s) {
  s = (s || "").toLowerCase();
  s = s.replace(/[éèêë]/g, "e").replace(/[áàâ]/g, "a").replace(/[íìî]/g, "i")
       .replace(/[óòô]/g, "o").replace(/[úùû]/g, "u");
  s = s.replace(/dj/g, "j").replace(/tj/g, "c").replace(/oe/g, "u");
  return s;
}

/* ---------- indeks ternormalisasi (sekali saat muat) ---------- */
var IDX = { id_jv: [], jv_en: [], jv_jv: [], kbji: [], kawi: [] };
var LVL_ID = { ngoko: "Ngoko", madya: "Madya", krama: "Kromo", inggil: "Kromo Inggil",
  andhap: "Kromo Andhap", kasar: "Kasar", cakapan: "Cakapan", dialek: "Dialek",
  arkais: "Arkais", arab: "Arab", sanskerta: "Sanskerta", walanda: "Walanda",
  cina: "Cina", melayu: "Melayu", prancis: "Prancis", portugis: "Portugis" };
function lvArr(s) {
  return (s || "").split(",").filter(function (x) { return !!x; });
}
function buildIndex() {
  if (IDX.id_jv.length || IDX.jv_en.length) return;  // idempoten (WebView restore)
  var b, arr, i, e;
  for (b in KAMUS_ID_JV) {
    arr = KAMUS_ID_JV[b];
    for (i = 0; i < arr.length; i++) {
      e = arr[i];
      IDX.id_jv.push({ k: e[0], a: e[1], nk: norm(e[0]), na: norm(e[1]),
        lv: lvArr(e[3]), lvStr: e[3] || "" });
    }
  }
  for (b in KAMUS_JV_EN) {
    arr = KAMUS_JV_EN[b];
    for (i = 0; i < arr.length; i++) {
      e = arr[i];
      IDX.jv_en.push({ k: e[0], a: e[1], pos: e[2] || "", nk: norm(e[0]), na: norm(e[1]),
        lv: lvArr(e[3]), lvStr: e[3] || "" });
    }
  }
  if (typeof KAMUS_JV_JV !== "undefined") {
    for (b in KAMUS_JV_JV) {
      arr = KAMUS_JV_JV[b];
      for (i = 0; i < arr.length; i++) {
        e = arr[i];
        IDX.jv_jv.push({ k: e[0], a: e[1], nk: norm(e[0]), na: norm(e[1]),
          lv: lvArr(e[3]), lvStr: e[3] || "" });
      }
    }
  }
  if (typeof KAMUS_KBJI !== "undefined") {
    for (b in KAMUS_KBJI) {
      arr = KAMUS_KBJI[b];
      for (i = 0; i < arr.length; i++) {
        e = arr[i];
        IDX.kbji.push({ k: e[0], a: e[1], nk: norm(e[0]), na: norm(e[1]),
          lv: lvArr(e[3]), lvStr: e[3] || "" });
      }
    }
  }
  if (typeof KAMUS_KAWI !== "undefined") {
    for (b in KAMUS_KAWI) {
      arr = KAMUS_KAWI[b];
      for (i = 0; i < arr.length; i++) {
        e = arr[i];
        IDX.kawi.push({ k: e[0], a: e[1], nk: norm(e[0]), na: norm(e[1]),
          lv: lvArr(e[3]), lvStr: e[3] || "" });
      }
    }
  }
}

/* ---------- cari ---------- */
/* ---------- cari terpadu: 4 kamus sekaligus, hasil berkelompok ---------- */
var SEC_INIT = 30, SEC_MORE = 100;
function rankPool(pool, q, reverse) {
  var rank1 = [], rank2 = [], rank3 = [], i, e;
  for (i = 0; i < pool.length; i++) {
    e = pool[i];
    if (FILTER && e.lv.indexOf(FILTER) === -1) continue;   // filter tingkat tutur
    if (reverse) {
      if (e.na.indexOf(q) === 0 || (" " + e.na).indexOf(" " + q) !== -1) rank1.push(e);
      else if (e.na.indexOf(q) !== -1) rank2.push(e);
      else if (e.nk.indexOf(q) !== -1) rank3.push(e);
    } else {
      if (e.nk.indexOf(q) === 0) rank1.push(e);
      else if (e.nk.indexOf(q) !== -1) rank2.push(e);
      else if (e.na.indexOf(q) !== -1) rank3.push(e);
    }
  }
  return rank1.concat(rank2, rank3);
}
function searchAll(q) {
  q = norm(q.trim());
  if (!q) return [];
  return [
    { key: "id_jv", title: "Indonesia → Jawa", list: rankPool(IDX.id_jv, q, false) },
    { key: "jv_id", title: "Jawa → Indonesia (cari balik)", list: rankPool(IDX.id_jv, q, true) },
    { key: "jv_jv", title: "Jawa → Jawa (Bausastra)", list: rankPool(IDX.jv_jv, q, false) },
    { key: "kbji", title: "Jawa → Indonesia (KBJI)", list: rankPool(IDX.kbji, q, false) },
    { key: "jv_en", title: "Jawa → Inggris", list: rankPool(IDX.jv_en, q, false) },
    { key: "kawi", title: "Kawi → Jawa", list: rankPool(IDX.kawi, q, false) }
  ];
}
function browseAll(letter) {
  var secs = [
    { key: "id_jv", title: "Indonesia → Jawa", pool: IDX.id_jv },
    { key: "jv_jv", title: "Jawa → Jawa (Bausastra)", pool: IDX.jv_jv },
    { key: "kbji", title: "Jawa → Indonesia (KBJI)", pool: IDX.kbji },
    { key: "jv_en", title: "Jawa → Inggris", pool: IDX.jv_en },
    { key: "kawi", title: "Kawi → Jawa", pool: IDX.kawi }
  ];
  var out = [], s, i, e, b, list;
  for (s = 0; s < secs.length; s++) {
    list = [];
    for (i = 0; i < secs[s].pool.length; i++) {
      e = secs[s].pool[i];
      if (FILTER && e.lv.indexOf(FILTER) === -1) continue;
      b = e.nk.charAt(0);
      b = (b >= "a" && b <= "z") ? b : "#";
      if (b === letter) list.push(e);
    }
    list.sort(function (x, y) { return x.nk < y.nk ? -1 : 1; });
    out.push({ key: secs[s].key, title: secs[s].title + " · " + letter.toUpperCase(), list: list });
  }
  return out;
}

/* ---------- favorit & riwayat (localStorage, pola Katolik) ---------- */
function lsGet(k, fb) {
  try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : fb; }
  catch (e) { return fb; }
}
function lsSet(k, v) {
  try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {}
}
function favKey(e, mode) { return mode + "|" + e.k; }
function isFav(e, mode) { return !!lsGet("bj_fav", {})[favKey(e, mode)]; }
function toggleFav(e, mode) {
  var f = lsGet("bj_fav", {}), k = favKey(e, mode);
  if (f[k]) delete f[k];
  else f[k] = { k: e.k, a: e.a, pos: e.pos || "", lvStr: e.lvStr || "", mode: mode };
  lsSet("bj_fav", f);
  renderFavCount();
}
function renderFavCount() {
  var n = Object.keys(lsGet("bj_fav", {})).length;
  document.getElementById("favCount").textContent = n ? "(" + n + ")" : "";
}
function pushHist(q) {
  q = q.trim();
  if (!q) return;
  var h = lsGet("bj_hist", []).filter(function (x) { return x !== q; });
  h.unshift(q);
  lsSet("bj_hist", h.slice(0, 10));
}

/* ---------- translator ngoko → krama/inggil (padanan kata + frasa) ---------- */
var TMODE = "krama";      // krama | inggil
var PAD = {};             // norm(ngoko) -> {w, krama, inggil}
function buildPad() {
  if (typeof KAMUS_PADANAN === "undefined") return;
  for (var b in KAMUS_PADANAN) {
    var arr = KAMUS_PADANAN[b];
    for (var i = 0; i < arr.length; i++) {
      if (arr[i][0]) PAD[norm(arr[i][0])] = { w: arr[i][0], krama: arr[i][1], inggil: arr[i][2] };
    }
  }
}
function capFirst(s, orig) {
  var c = orig.charAt(0);
  if (c >= "A" && c <= "Z") return s.charAt(0).toUpperCase() + s.slice(1);
  return s;
}
function trTranslate(text) {
  var toks = text.match(/[A-Za-z'êéèÉÈÊ\-]+|\s+|[^A-Za-z'êéèÉÈÊ\s\-]+/g) || [];
  var isWord = function (t) { return /^[A-Za-z'êéèÉÈÊ\-]+$/.test(t); };
  var isSpace = function (t) { return /^\s+$/.test(t); };
  var out = "", known = 0, changed = 0, total = 0, unk = [], i, n, j;
  for (i = 0; i < toks.length; i++) {
    if (!isWord(toks[i])) { out += esc(toks[i]); continue; }
    var hit = null, used = 1, srcWords = [toks[i]];
    for (n = 3; n >= 1; n--) {   // frasa terpanjang dulu (cth. "adang sega")
      var words = [];
      for (j = i; j < toks.length && words.length < n; j++) {
        if (isWord(toks[j])) words.push(toks[j]);
        else if (isSpace(toks[j])) continue;
        else break;
      }
      if (words.length !== n) continue;
      var key = norm(words.join(" ").toLowerCase());
      if (PAD[key] && PAD[key][TMODE]) {
        hit = PAD[key][TMODE]; used = j - i; srcWords = words; break;
      }
    }
    total++;
    if (hit) {
      known++;
      if (hit.toLowerCase() !== srcWords.join(" ").toLowerCase()) changed++;
      out += esc(capFirst(hit, toks[i]));
    }
    else { unk.push(toks[i]); out += '<mark class="unknown">' + esc(toks[i]) + "</mark>"; }
    i += used - 1;
  }
  return { html: out, known: known, changed: changed, total: total, unk: unk };
}
function transCard(q) {
  // Kartu terjemahan otomatis di atas hasil kamus; "" bila tak ada kata BERUBAH.
  var r = trTranslate(q);
  if (!r.changed) return "";
  var onK = TMODE === "krama" ? " on" : "", onI = TMODE === "inggil" ? " on" : "";
  return '<div class="card"><div class="muted">Ngoko → ' +
    '<button data-tmode="krama" class="mini' + onK + '">Kromo</button>' +
    '<button data-tmode="inggil" class="mini' + onI + '">Kromo Inggil</button>' +
    ' · <b>' + r.known + "</b>/" + r.total + " kata</div>" +
    '<div class="arti trout">' + r.html + "</div></div>";
}

/* ---------- render ---------- */
function esc(s) {
  return (s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
function hi(text, q) {
  var t = esc(text), nq = norm(q);
  if (!nq || nq.length < 2) return t;
  // highlight sederhana pada teks asli (kasus umum: query == substring asli)
  var i = t.toLowerCase().indexOf(q.trim().toLowerCase());
  if (i === -1) return t;
  return t.slice(0, i) + "<mark>" + t.slice(i, i + q.trim().length) + "</mark>" + t.slice(i + q.trim().length);
}
function tagFor(mode, e) {
  if (mode === "id_jv") return "ID→JV";
  if (mode === "jv_id") return "JV→ID · balik";
  if (mode === "jv_jv") return "JV→JV · Bausastra";
  if (mode === "kbji") return "JV→ID · KBJI";
  if (mode === "kawi") return "KAWI→JV";
  return "JV→EN" + (e.pos ? " · " + esc(e.pos) : "");
}
function badges(e) {
  var lv = (e.lv && e.lv.length) ? e.lv : lvArr(e.lvStr);
  var html = "";
  for (var i = 0; i < lv.length; i++) {
    html += '<span class="tag lvl-' + lv[i] + '">' + (LVL_ID[lv[i]] || lv[i]) + "</span>";
  }
  return html;
}
function card(e, mode, q) {
  var fav = isFav(e, mode) ? " fav" : "";
  return '<div class="card entry"><div class="body">' +
    '<div class="kata">' + hi(e.k, q || "") + "</div>" +
    '<div class="arti">' + hi(e.a, q || "") + "</div>" +
    '<span class="tag">' + tagFor(mode, e) + "</span>" + badges(e) + "</div>" +
    '<button class="star' + fav + '" data-k="' + esc(e.k).replace(/"/g, "&quot;") +
    '" data-mode="' + mode + '" title="Favorit">★</button></div>';
}

var resultsEl = document.getElementById("results");
var lastQ = "";
resultsEl.addEventListener("click", function (ev) {
  var el = ev.target && ev.target.closest ? ev.target : null;
  if (!el) return;
  var t = el.closest ? el.closest("[data-tmode]") : null;
  if (t) {
    TMODE = t.getAttribute("data-tmode");
    refresh(false);
    return;
  }
  var m = el.closest ? el.closest("button.more[data-sec]") : null;
  if (m) {
    secMore(m.getAttribute("data-sec"), lastQ);
    return;
  }
  var s = el.closest ? el.closest(".star") : null;
  if (s) { fireStar(s); return; }
});
function emptyHint() {
  return '<div class="card"><p class="muted">Tidak ketemu. Coba ejaan lain (cth. <i>tjahaya → cahaya</i>, ejaan lama dilipat otomatis) atau telusuri lewat huruf A–Z.</p></div>';
}
function renderSections(sections, q) {
  lastSecs = [];
  var tr = transCard(q || "");
  lastHasTr = !!tr;
  var html = tr, total = 0, i;
  for (i = 0; i < sections.length; i++) {
    if (!sections[i].list.length) continue;
    sections[i].shown = 0;
    lastSecs.push(sections[i]);
    total += sections[i].list.length;
  }
  var ftag = FILTER ? " · " + (LVL_ID[FILTER] || FILTER) : "";
  html += '<div class="muted count">Hasil' + ftag + ": <b>" + total + "</b> entri di <b>" +
    lastSecs.length + "</b> kamus</div>";
  for (i = 0; i < lastSecs.length; i++) html += secHTML(lastSecs[i], q);
  if (!lastSecs.length && !lastHasTr) html += emptyHint();
  resultsEl.innerHTML = html;
}
function secHTML(sec, q) {
  var html = '<div class="sec-head">' + sec.title + " (<b>" + sec.list.length + "</b>)</div>";
  html += '<div id="secbody-' + sec.key + '">';
  var slice = sec.list.slice(0, SEC_INIT);
  sec.shown = slice.length;
  for (var i = 0; i < slice.length; i++) html += card(slice[i], sec.key, q);
  html += "</div>";
  if (sec.shown < sec.list.length) {
    html += '<button class="more" data-sec="' + sec.key + '">Muat lagi (' +
      (sec.list.length - sec.shown) + " lagi)…</button>";
  }
  return html;
}
function secMore(key, q) {
  var sec = null, i, j;
  for (i = 0; i < lastSecs.length; i++) {
    if (lastSecs[i].key === key) sec = lastSecs[i];
  }
  if (!sec) return;
  var body = document.getElementById("secbody-" + key);
  if (!body) return;
  var slice = sec.list.slice(sec.shown, sec.shown + SEC_MORE);
  sec.shown += slice.length;
  var tmp = document.createElement("div");
  var html = "";
  for (j = 0; j < slice.length; j++) html += card(slice[j], sec.key, q);
  tmp.innerHTML = html;
  while (tmp.firstChild) body.appendChild(tmp.firstChild);
  var btns = resultsEl.querySelectorAll('button.more[data-sec="' + key + '"]');
  for (j = 0; j < btns.length; j++) {
    if (sec.shown < sec.list.length) {
      btns[j].textContent = "Muat lagi (" + (sec.list.length - sec.shown) + " lagi)…";
    } else if (btns[j].parentNode) {
      btns[j].parentNode.removeChild(btns[j]);
    }
  }
}
function findEntry(k, mode) {
  var i, j, sec;
  for (i = 0; i < lastSecs.length; i++) {
    sec = lastSecs[i];
    if (mode && sec.key !== mode) continue;
    for (j = 0; j < sec.list.length; j++) {
      if (sec.list[j].k === k) return sec.list[j];
    }
  }
  if (mode) return findEntry(k, "");
  return null;
}
function fireStar(btn) {
  var mode = btn.getAttribute("data-mode") || "id_jv";
  var found = findEntry(btn.getAttribute("data-k"), btn.getAttribute("data-mode"));
  if (found) {
    toggleFav(found, mode);
    btn.classList.toggle("fav");
  }
}

function renderHome() {
  var h = lsGet("bj_hist", []);
  var m = KAMUS_META || { counts: {} };
  var html = '<div class="card"><div class="kata">Sugeng rawuh! 🙏</div>' +
    '<div class="arti">Kamus offline: <b>' + (m.counts.id_jv || 0) +
    "</b> Indonesia→Jawa, <b>" + (m.counts.jv_jv || 0) +
    "</b> Jawa→Jawa, <b>" + (m.counts.kbji || 0) +
    "</b> KBJI, <b>" + (m.counts.jv_en || 0) +
    "</b> Jawa→Inggris &amp; <b>" + (m.counts.kawi || 0) +
    "</b> Kawi→Jawa. Ketik kata di atas, atau pilih huruf A–Z.</div>" +
    '<div class="arti" style="margin-top:6px">Ketik kalimat ngoko (cth. <i>aku arep mangan</i>) — terjemahan kromo otomatis muncul di atas hasil.</div>';
  if (h.length) {
    html += '<div class="muted" style="margin-top:8px">Terakhir dicari:</div><div class="hist">';
    for (var i = 0; i < h.length; i++) {
      html += '<button data-h="' + esc(h[i]).replace(/"/g, "&quot;") + '">' + esc(h[i]) + "</button>";
    }
    html += "</div>";
  }
  html += "</div>";
  resultsEl.innerHTML = html;
  var btns = resultsEl.querySelectorAll("[data-h]");
  for (var j = 0; j < btns.length; j++) {
    btns[j].onclick = function () {
      document.getElementById("q").value = this.getAttribute("data-h");
      refresh();
    };
  }
}

function renderFav() {
  var f = lsGet("bj_fav", {}), keys = Object.keys(f);
  var el = document.getElementById("favList");
  if (!keys.length) {
    el.innerHTML = '<div class="card"><p class="muted">Belum ada favorit. Ketuk bintang ★ pada entri untuk menyimpan di sini (tersimpan offline di HP).</p></div>';
    return;
  }
  var html = '<div class="muted count">Favorit: <b>' + keys.length + "</b></div>";
  for (var i = 0; i < keys.length; i++) {
    var e = f[keys[i]];
    html += card(e, e.mode, "");
  }
  el.innerHTML = html;
  // hapus favorit dari tab ini (toggle off)
  var btns = el.querySelectorAll(".star");
  for (var j = 0; j < btns.length; j++) {
    btns[j].classList.add("fav");
    btns[j].onclick = function () {
      var k = this.getAttribute("data-k");
      var ff = lsGet("bj_fav", {});
      for (var key in ff) {
        if (ff[key].k === k) delete ff[key];
      }
      lsSet("bj_fav", ff);
      renderFavCount();
      renderFav();
    };
  }
}

function renderAbout() {
  var m = KAMUS_META || { counts: {}, built: "-" };
  document.getElementById("aboutBody").innerHTML =
    '<div class="card"><h2 class="sec">Basa Jawa Offline v1.0</h2>' +
    "<p>Kamus offline Indonesia→Jawa (" + (m.counts.id_jv || 0) + " entri), " +
    "Jawa→Indonesia (cari balik), Jawa→Jawa (" + (m.counts.jv_jv || 0) +
    ") &amp; Jawa→Inggris (" + (m.counts.jv_en || 0) +
    "). Data dibangun " + esc(m.built || "-") + ". Tanpa internet, tanpa iklan.</p></div>" +
    '<div class="card"><h2 class="sec">Sumber &amp; atribusi</h2><ul>' +
    "<li><b>sastra-jawa</b> (github nsulistiyawan) — dictionary.csv Indonesia→Jawa.</li>" +
    "<li><b>batangan</b> (github lantip, kamus Poerwadarminta) — Jawa→Jawa.</li>" +
    "<li><b>KBJI</b> (Balai Bahasa DIY, kbji.kemendikdasmen.go.id) — Jawa→Indonesia resmi.</li>" +
    "<li><b>Kamus Kawi-Djarwa</b> (Poerwadarminta, via arsip archive.org) — Kawi→Jawa.</li>" +
    "<li><b>kamus-jawa-api</b> (github Habibzz01) — padanan ngoko→kromo &amp; kromo inggil untuk Translator.</li>" +
    "<li><b>kaikki.org</b> — ekstrak Wiktionary bahasa Jawa (Jawa→Inggris), lisensi CC BY-SA: © kontributor Wiktionary.</li>" +
    "<li>Entri bersejarah memakai ejaan lama; pencarian melipat otomatis <i>dj→j, tj→c, oe→u</i> &amp; diakritik ê/é.</li>" +
    "</ul></div>" +
    '<div class="card"><h2 class="sec">Tingkat tutur (badge)</h2><ul>' +
    "<li><b>Ngoko</b> — sehari-hari (penanda KN/kn./n.). Entri tanpa penanda dianggap ngoko.</li>" +
    "<li><b>Kromo</b> — halus (K/k.), <b>Kromo Inggil</b> — sangat halus (Ki/ki.).</li>" +
    "<li><b>Kasar</b> — kasar (ks.), <b>Cakapan</b> — lisan (cak.), <b>Dialek</b> — daerah (dl.), <b>Arkais</b> — kuno (ar.).</li>" +
    "<li><b>Asal kata</b> — Arab, Sanskerta, Walanda (Belanda), Cina, Melayu, Prancis, Portugis.</li>" +
    "<li>Saring lewat pilihan <i>Tingkat tutur</i> di bawah mode kamus.</li>" +
    "</ul></div>" +
    '<div class="card"><h2 class="sec">Teknis</h2>' +
    '<p class="muted">WebView wrapper tanpa Gradle (pola katolik-digital-offline): id.basajawa.offline. Favorit &amp; riwayat tersimpan di localStorage HP.</p></div>';
}

/* ---------- wiring ---------- */
var qEl = document.getElementById("q"), timer = null;
function refresh(push) {
  var q = qEl.value;
  lastQ = q;
  if (q.trim()) {
    renderSections(searchAll(q), q);
    if (push !== false) pushHist(q);
  } else if (LETTER) {
    renderSections(browseAll(LETTER), "");
  } else {
    renderHome();
  }
}
qEl.addEventListener("input", function () {
  if (timer) clearTimeout(timer);
  timer = setTimeout(function () { refresh(false); }, 180);
});
qEl.addEventListener("change", function () { pushHist(qEl.value); });
document.getElementById("clr").onclick = function () {
  qEl.value = ""; LETTER = "";
  var c = document.querySelectorAll("#chips button");
  for (var i = 0; i < c.length; i++) c[i].classList.remove("on");
  refresh();
};
document.getElementById("lvlFilter").onchange = function () {
  FILTER = this.value;
  refresh();
};

(function buildChips() {
  var letters = "abcdefghijklmnopqrstuvwxyz#", el = document.getElementById("chips"), html = "";
  for (var i = 0; i < letters.length; i++) {
    html += '<button data-l="' + letters[i] + '">' + letters[i].toUpperCase() + "</button>";
  }
  el.innerHTML = html;
  el.addEventListener("click", function (ev) {
    var b = ev.target.closest("button");
    if (!b) return;
    LETTER = b.getAttribute("data-l");
    var all = el.querySelectorAll("button");
    for (var j = 0; j < all.length; j++) all[j].classList.remove("on");
    b.classList.add("on");
    qEl.value = "";
    refresh();
  });
})();

var tabs = document.querySelectorAll("nav.tabs button");
for (var t = 0; t < tabs.length; t++) {
  tabs[t].onclick = function () {
    for (var j = 0; j < tabs.length; j++) tabs[j].classList.remove("on");
    this.classList.add("on");
    var tab = this.getAttribute("data-tab");
    document.getElementById("tab-kamus").style.display = tab === "kamus" ? "" : "none";
    document.getElementById("tab-fav").style.display = tab === "fav" ? "" : "none";
    document.getElementById("tab-about").style.display = tab === "about" ? "" : "none";
    if (tab === "fav") renderFav();
    if (tab === "about") renderAbout();
  };
}

/* ---------- init ---------- */
if (typeof KAMUS_META === "undefined" || typeof KAMUS_ID_JV === "undefined") {
  resultsEl.innerHTML = '<div class="card"><p><b>Data kamus tidak termuat.</b></p>' +
    '<p class="muted">Pastikan kamus_data.js ada di folder yang sama dengan index.html, ' +
    "lalu bangun ulang dengan tools/build_kamus.py.</p></div>";
} else {
  buildIndex();
  buildPad();
  renderFavCount();
  renderHome();
}
</script>
</body>
</html>
