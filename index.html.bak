i","ar. iwak sagara.","","ngoko"],["puntianak","bngs. wewe.","",""],["puntul","kêthul; kc. tumpul, majal.","",""],["puntung","kêthokan, tugêlan (tumpêr, têgêsan lsp); dipuntungkan: dikêthoki, dipruthuli.","",""],["punya","1 duwe; 2 ing pacalathon iya sok dianggo atêgês pandarbe, kyt. saya punya anjing (asuku); di(ke)punyai: didarbèni; dikepunyakan: didhaku, diêpèk; kepunyaan: darbèke, barang darbe.","","ngoko,dialek,arkais"],["pupu","urut-urutaning saduluran; saudara sepupu: nak sanak; saudara dua pupu: sadulur misan.","","ngoko,dialek,arkais"],["pupuh","ut. berpupuh: tarung (kabruk-kabrukan lsp); dipupuh: 1 ditladhung, dikabruk; 2 (ut. dipupuhkan) ditarungake, diêdu.","","ngoko"],["pupuk","1 pupuk; 2 rabuk; dipupuk: 1 dipupuki; 2 dirabuki.","","ngoko,dialek"],["pupul","panèn wowohan.","","ngoko"],["pupur","i (tepung pupur, pupuran) pupur, bobok. ii ut. berpupur, memupur: kêkipu; pupuran: papan kang dianggo kêkipu.","","ngoko,dialek,arkais"],["pupus","êntèk-êntèkan, ludhês, curês; dipupuskan: dicurês, diêntèkake babarpisan.","",""],["pura","kutha.","","ngoko"],["pura-peranda","mobrak-mabrik; kc. porak-peranda.","","ngoko"],["pura-pura","ethok-ethok, pawadan.\n--- 141 ---","","ngoko"],["purbakala","jaman kuna.","","ngoko,sanskerta"],["puri","1 kutha, bètèng, kastil; 2 kêdhaton.","","ngoko"],["purin","sada; kc. lidi.","","ngoko"],["purnama","purnama.","","ngoko"],["puru","pathèk sabangsane; puru sembilit: lara ambe.","","ngoko"],["purun","(rumput-) mendhong.","",""],["purut","limau purut: jêruk purut.","","ngoko"],["pusa","adrêng, dêrêng, kumudu-kudu.","",""],["pusaka","pusaka, warisan; dipusakai: ditinggali, diwarisi.","","ngoko,dialek"],["pusar","ut. berpusar, memusar: mubêng mungsêr; dipusar: diubêngake mungsêr; (ngêrêgi, ngagar gêni, nggêrus cèt lsp); pusaran angin: lesus; pusaran air: ulêkan.","","ngoko,dialek"],["pusat","1 wudêl, pusêr; 2 têlêng, kang têngah dhewe; dipusatkan: diklumpukake ana ing sawijining panggonan, didadèkake siji.","","ngoko,dialek"],["pusing","1 (ut. berpusing) mubêng kaya kitiran lsp; 2 (-kepala) mumêt, ngêlu; pusing angin: kitiran; pusing balik: mubêng mingêr.","","ngoko,dialek,arkais"],["puspa","1 kêmbang; 2 pêpêthingan, kang bêcik dhewe.","","ngoko,dialek"],["pusparagam, puspawarna","manca-warna.","",""],["pusta","ar. prau pêrang (jaman biyèn).","","ngoko,sanskerta"],["pustaka","layang wacan; perpustakaan: pabukon.","","ngoko"],["pusu","1 punthuk, unthuk, pundhung; 2 grombolan, krompolan; berpusu-pusu: 1 pêpunthukan; 2 mrana-mrene.","","ngoko,cakapan"],["putar","diputar: diputêr, diubêngake, diingêr; putar balik: 1 mubêng mingêr; 2 putêr giling.","","ngoko,dialek"],["putarwali","bratawali (ar. tetuwuhan).","","ngoko"],["putat","putat.","","ngoko"],["putera","putra.","","ngoko,inggil"],["puteri","putri; puteri malu: biskucing.","","ngoko,inggil,dialek"],["putih","1 putih; 2 ent. suci, murni; putih mata: wirang, kêwirangan; putih metah: putih mêmplak; putih tulang: mati; memutih: katon (dadi) putih; diputihkan: diputih (dikumbah lsp).","","ngoko,cakapan"],["putik","pêntil.","",""],["puting","purusing lading lsp; puting beliung: clèrèt taun ing sagara; puting susu: pênthil.","","ngoko,dialek"],["putu","puthu.","","ngoko"],["putus","1 pêdhot; 2 putus tmr. rêmbugan, prakara lsp.; diputuskan: 1 dipêdhot; 2 (ut. diputusi) diputusi, dirampungi, dipancasi; 3 dicugag, disigêg; keputusan: putusan; tiada berkeputusan: tanpa pêdhot, tanpa wasana; putus asa (-harap): êntèk pangarêp-arêpe; putus bicara: kêntekan akal; putus nyawa: mati.","","ngoko,inggil,dialek,arkais"],["puyu","angin puyu: angin mubêng saèm. lesus.","","ngoko"],["puyu-puyu","ar. iwak sagara.","","ngoko"],["puyuh","gêmak.","",""]],"r":[["raba","diraba: digrayangi, dimêk-mêki: meraba-raba: grayah-grayah, mêk-mêkan.","","ngoko"],["rabak","suwèk, bêdhah: dirabak: disuwèk, dibêdah.","","ngoko"],["raban","meraban: ndlêming, clêmongan.","",""],["rabbi","bêndara (panyêbut marang allah).","","ngoko,arab"],["rabbul'alamin","bêndaraning jagat (allah).","","ngoko,arab,sanskerta"],["rabit","sêmbir, sêmbrèt, suwèk, dawir.","","ngoko"],["rabiul-akhir","rabingulakir.","","ngoko"],["rabiul-awal","rabingulawal.","","ngoko"],["rabu","(hari-) dina rêbo.","","ngoko"],["rabuk","i kawul, ii rabuk.","","ngoko"],["rabun","1 ukub (kêbul dianggo sarat supaya mari, atos lsp); 2 (ut. merabun) bawur. blabur marga kêna pêga lsp; dirabuni: diukub, dikêbuli.","","ngoko,krama,dialek"],["rabung","wêlit ing wuwungan; perabungan: wuwungan.","","ngoko"],["rabut","uwal (ucul) saka ing jala, pancing lsp; merabut: polah kroncalan supaya uwal; njambak, njabut.","","ngoko,arkais"],["racau","meracau: ndlêming marga lara panas lsp.","","ngoko"],["racik","i diracik; digêbingi, diirisi tipis. ii bngs. kala pracik; meracik: ngala nganggo pracik.","","ngoko,arkais"],["racun","racun.","","ngoko"],["radai","i talang tritisan; meradai: ngêmis.\n--- 142 ---","","ngoko"],["radak","beradak: ngamuk nyuduki; diradak: 1 dijojoh ing tumbak lsp; 2 dirêmuk.","","ngoko"],["radang","1 krasa panas marga nêpsu lsp; 2 lara abuh ing pêru lsp; meradang: kêmropok, muring bangêt.","","ngoko"],["radiallahu'anhu","muga dhèwèke ndadèkake kêparênging allah (kanggo yèn nyêbut asmane para kalipah).","","ngoko,inggil,arkais,arab"],["radif","purwakanthi.","","ngoko"],["radin","radèn.","","ngoko"],["rafik","mitra.","","ngoko"],["raga","i 1 bngs. kranjang (krênêng) kasar; 2 (buah-) saèm. bal kang digawe nam-naman pênjalin; sepak raga: bal-balan; bantal seraga: bantal gêdhe kanggo rêrênggan. ii raga.","","ngoko,kasar,dialek,arkais"],["ragam","cengkoking lagu, pratingkah, saradan, lêlai, corak; seragam bau, wêwangi campur bawur.","","ngoko,dialek"],["ragang","meragang: mènèk mrambat.","","ngoko"],["ragas","diragas: dijambak, disêbrot, ditêkêm banjur ditarik.","","ngoko"],["ragi","1 ragi; 2 campuran ut. wuwuhan supaya mundhak bêcik; 3 warna kanggo coraking tênunan.","","ngoko,arkais"],["ragu","1 (-hati) kuwur atine; 2 (ut. ragu-ragu) mamang, gojag-gajêg.","","ngoko,dialek"],["ragum","tanggêm (dianggo njêpit wêsi kang dikikir lsp).","","ngoko,dialek"],["ragung","teragung (-ragung): kêtatab (-tatab).","",""],["ragut","diragut: dijambak, disêbrot.","",""],["rahang","gronggonganing cangkêm ut. gurung; tulang rahang: wang.","","ngoko,dialek,arkais"],["rahap","(ut. kain rahap, perahap) lurub mayit; merahap: niyub suwiwine njêpapang; dirahap(i): dilurubi.","","ngoko"],["rahasia, rahsia","wadi; dirahasiakan: digawe wadi.","","ngoko,dialek"],["rahat","jantra pangantihan lsp.","","ngoko"],["rahib","wong tapa.","","ngoko,arkais"],["rahim","i wêlas(an), sih kawêlasan. ii guwagarba.","","ngoko"],["rahman","wêlas(an), sih kawêlasan.","","ngoko"],["rahmani","kang ambêk wêlas.","","ngoko,dialek"],["rahmat(ullah)","sih kawêlasaning allah.","","ngoko,arab"],["rahsia","wadi.","","ngoko,dialek"],["rahu","rahu (buta ut. naga kang mangan rêmbulan lan srêngenge).","","ngoko,krama,inggil,dialek"],["raiat, ra'yat, rakyat","1 rakyat, kawula; 2 kawula, karerehan.","","ngoko,dialek"],["raib","ilang, gaib.","","ngoko"],["raih","diraih: 1 dicènèng dicêdhakake lsp; 2 dikulak, diborong; tolak raih, menolak meraih: candhak kulak (adol lan kulak tanpa nganggo lantaran); peraih: têngkulak, bakul kang kulak.","","ngoko,krama,inggil,dialek"],["rais","dirais: disaponi (dikêluti) rêrêgêde diklumpukake.","",""],["raja","raja, ratu; meraja: 1 jumênêng ratu; 2 kumratu-ratu; dirajai: diratoni; dirajakan: dijumênêngake raja.","","ngoko"],["raja-badar","bngs. mori putih.","","ngoko,cakapan"],["raja-busana","panganggo kêprabon (ing prang lsp).","","ngoko,cakapan"],["raja-diraja","bandhosa tmr. ratu.","","ngoko"],["raja-mudha","wêwakiling ratu.","","ngoko"],["raja-penomah","paningsêt.","",""],["raja-sari (sehari)","pangantèn lanang.","","ngoko"],["raja-singa","raja singa.","","ngoko"],["rajab","rêjêb.","",""],["rajah","i rajah. ii merajah: jojoh-jojoh nggagapi banyu lsp.","","ngoko,dialek"],["rajalela","merajalela: ambêk sawênang-wênang.","",""],["rajam","dirajam: dibandhêmi watu.","","ngoko"],["rajawali","bngs. manuk wulung.","","ngoko,dialek"],["rajim","dibandhêmi watu.","","ngoko"],["rajin","tabêri, srêgêp; dirajinkan: ditabêrèni.","",""],["rajuk","merajuk: grundêlan, grênêngan; dirajuki: digrundêli, digrênêngi.","",""],["rajut","1 rajut; 2 susuh manyar; dirajut: dirajut, disongkèt.","","ngoko"],["rak","swara gêrot, rêkètèk.","","ngoko"],["raka","mêprêl (gampang pêcahe ut. rêmuke).","","ngoko"],["rakaat","rêkangat.","",""],["rakam","bludiran, songketan; merakam: nyongkèt, mbludir.","","ngoko"],["rakan","1 pasar, papan paklumpukaning barang dagangan; 2 bakul; 3 (ut. rakanan) kanca, kanca bathon dagang lsp; kc. rekan.","","ngoko,dialek,arkais"],["rakap","merakap; mbrangkang; kc. rangkak.","","ngoko"],["rakat","woh saga.","","ngoko"],["rakit","gèthèk (pring digandhèng-gandhèng); berakit: gandhèng tumèmplèk; dirakit:\n--- 143 ---","","ngoko"],["raksa","ra'sa, air raksa: banyu rasa.","","ngoko,dialek,arkais"],["raksamala","wit rasamala.","","ngoko"],["raksasa","buta, rasêksa.","","ngoko"],["raksi","ambon-ambon wangi; diraksi: didokoki wêwangi; seraksi: jodho, cocog.","","ngoko,arkais"],["rakus","cluthak, nggragas.","","ngoko"],["rakut","merakut: 1 gawe klamat (tmr. kêmangga); 2 ent. ngapusi.","","ngoko"],["rakyat","rakyat.","",""],["ralat","kliru, salah; kc. galat.","","ngoko,dialek,arkais"],["ralip","i mbliyut, mbêyuyut; peralip: ngantukan, nglêntuk. ii kamanuhan, kalumrahan; kc. galib.","","ngoko"],["ram","i swara grubug-grubug; kc. deram. ii dirami: diêngrêmi; kc. eram.","","ngoko"],["rama-rama","kupu gajah.","","ngoko"],["ramadan","sasi ramêlan.","","ngoko,arkais"],["ramah","grapyak, sumanak; beramah-ramahan: sêsrawungan ut. omong-omongan kanthi supêkêt; diramahi: ditanduki kalawan sumanak; peramah: supêkêt, sumanak.","","ngoko,krama"],["ramah-tamah","supêkêt, sumanak bangêt.","","ngoko"],["ramai","rame, rêja, akèh wong lsp; beramai-ramai: bêbarêngan wong akèh, rame-rame.","","ngoko,arkais"],["ramal","kawruh pêthèk sarana ndêlêng sasmita ing wêdhi lsp; membuka (membilang) ramal: mbincili; diramalkan: diwêca, dipêthèk; ramalan: pêthèk, wêwêcan.","","ngoko,arkais,arab"],["ramalan, ramelan","sasi ramêlan.","","ngoko,arkais"],["ramas","diramas: 1 diulèni, diulêd tmr. jladrèn lsp; 2 dipijêti.","","ngoko"],["rambah","i têlês, jêblog tmr. lêmah. ii dirambah: dipaprasi, dikêthoki pucuke.","",""],["rambai","i buah rambai: kêpundhung. ii bulu rambai: wulu sruwun ing buntut jago lsp.","","ngoko,dialek"],["rambaian","jriwut-jriwut mawa wulu tmr. rai lsp.","","ngoko,dialek"],["rambak","(ut. merambak): ngrêmbaka, njênggar mrana-mrana, mundhak-mundhak tmr. kasugihan lsp.","",""],["rambang","i (ut. merambang) bêgjan-bêgjan. ii amba, jêmbar tmr. jala, bolongan lsp.","","ngoko,arkais"],["rambat","merambat: njênggar mrana-mrana tmr. têtuwuhan, ent. mrèntèk-mrèntèk, sumêbar mrana-mrana.","",""],["rambih","ut. berambih, merambih: lêlungan bêbarêngan wong akèh (sujarah lsp).","","ngoko,arkais"],["rambu","i anjir, pathokan ancêr-ancêr dalan, watês lsp. ii ut. rambu-rambu: 1 gombyok ing tumbak, layangan lsp; 2 wulu sruwun (jriwut-jriwut ing kulit, wowohan lsp).","","ngoko,dialek"],["rambun","udan woh (udan ès).","","ngoko,arkais"],["rambunia, ramunia","ar. woh.","","ngoko"],["rambut","rambut, suri, bobat, wulu kewan lsp.","","ngoko,dialek,arab"],["rambutan","rambutan.","","ngoko"],["rambuti","(kain-) bngs. sêngkêlat.","",""],["rami","rami.","","ngoko"],["ramin","jêjêt.","",""],["rampai (-rampai)","campuran warna-warna tmr. kêmbang, gêgodhongan lsp; bunga rampai: 1 kêmbang campur bawur; layang pêpêthikan; dirampaikan: disêbar-sêbar tmr. kêmbang lsp.","","ngoko"],["rampak","ut. berampak: njêrkakah, ngrêmbaka; kc. rambak.","","ngoko"],["rampas","dirampas: dirampas (dijarah, dirêbut kanthi pêksa, dibêskup).","","ngoko"],["rampat","dirampat: 1 disabêt nganggo tampar lsp; 2 dibabadi, dipaprasi; 3 (-papat) digêbyah uyah (diampyak, ora nganggo dibedak-bedakake).","","ngoko,krama,dialek"],["ramping","lêncir, ora mbêmbêng.","","ngoko,krama"],["rampok","ut. perampok: kècu, wong njarah rayah.","","ngoko,dialek,arkais"],["rampuk","dirampuk: digêpuk, dirusak.","",""],["rampung","sumpung, kc. rompong.","","ngoko"],["rampus, ramput","saru; berampus, beramput: gunêman saru, crêmêdan, ngucap kasar.","","ngoko,kasar"],["ramu","meramu: kêklumpuk bakal kanggo gawe prau, omah lsp. (kyt. golèk kayu lsp); ramuan: 1 kayu lsp. kang bakal dianggo gawe omah lsp; 2 (-obat) racikan (adon-adon) jamu.","","ngoko,inggil,dialek"],["ramus","(ut. meramus): pating jriwut mawa wulu.","","ngoko,dialek"],["rana","ut. merana: 1 tansah lêlaranên; 2 ent. ngênês, sêdhih, ngranuhi.","","ngoko"],["ranah","palêmahan lêmpar, lêmbah.\n--- 144 ---","",""],["ranai","diranai: digawa disangga ing èpèk-èpèk; kc. tatang.","","ngoko"],["ranap","meranap: katon munggul (mêncungul) kyt. pulo ing sagara lsp.","","ngoko"],["rancah","dirancah: digarap srana diidak-idak ing kêbo sapi tmr. palêmahan.","","ngoko"],["rancak","1 rame, sigrak tmr. gamêlan, njogèd lsp.; 2 endah, ngrêsêpake.","","ngoko"],["rancang","1 nyongat lancip (kaya borang lsp); 2 pring ut. kayu lancip ditancêbake kanggo watêsan lsp.; dirancang: 1 dipasangi (dipêpêti) nganggo rancang; 2 diculik sarana dicublês sathithik; 3 dirancang.","","ngoko,dialek,arkais"],["rancap","i tumuli, têrusan bae lête sadhela. ii 1 gilig; 2 landhêp bangêt; tukang rancap: tukang ngasah gêgaman.","","ngoko"],["rancung","lancip kaya kalam; dirancung: dipagas lancip kaya ngongoti kalam.","","ngoko,inggil,dialek,arkais"],["randa","randha; meranda: dadi randha, ora jêjodhoan.","","ngoko,krama"],["randa-jawa","bngs. juwawut.","","ngoko"],["randah","berpindah randah: ngolah-ngalih, lunga mrana-mrana.","","ngoko"],["randai","merandai: nasak (nyabrang ngrubyuk) ing banyu, sukêtan lsp.","","ngoko,dialek"],["randau","dirandau: disubal supaya katon akèh tmr. lawuh.","","ngoko"],["randi","bngs. sutra wêton tiongkok.","","ngoko"],["randuk","i mawa rambut krêmbyah-krêmbyah, kc. kambing randuk (wêdhus berok). ii diranduk: disasak, disabrangi, dikrubyuk.","","ngoko,dialek"],["rang","i swara brêng, jrêng. ii ut. rang-rangan: cêngkorongan, rèng-rèngan. iii tanah rang: lêmah bêra. iv rang, pangkat.","","ngoko,dialek"],["rangah","angkuh, ngêdir-êdirake; merangah: sumêngah, ngêpak ing liyan.","","ngoko,dialek"],["rangai","dirangai: digolèki mrana-mrana, dilari.","",""],["rangak","bngs. tirêm.","",""],["rangau","wuru kunyit (ar. wit).","","ngoko,inggil"],["rangga","i merangga: nyongat lancip; kc. berangga, runggu-rangga. ii kêsêl bangêt; diranggakan dirinya: disrêmpêng, diêtog kakuwatane.","","ngoko"],["ranggah","diranggah: diundhuhi.","",""],["ranggak","diranggak(kan): diêntas ing dharatan tmr. prau.","","ngoko,cakapan,arkais"],["ranggas","i 1 ngarang, brindhil tanpa godhong; 2 pang-pang kang wis garing; meranggas: ngarang, mbrindhili, mbodhol, brondhol. ii ar. pasangan iwak.","","ngoko,dialek"],["ranggul","meranggul: nyundhul, nyondhol, nyungul.","","ngoko"],["ranggung","i burung ranggung: bngs. manuk bango; kail ranggung: pancing sungu mawa walêsan loro, memainkan ranggung: nindakake prakara kang mutawatiri. ii meranggung: ngongkog, mbrangkang dhadhane kambah.","","ngoko,dialek"],["rangin","bngs. tamèng.","","ngoko"],["rangka","ragangan, jrangkong.","","ngoko"],["rangka-dada","gronggongan dhadha.","","ngoko"],["rangkai","ombyokan, dhompolan; dirangkai(kan): digandhèng, disambung dadi siji tmr. têmbung lsp.","","ngoko,cakapan,arkais"],["rangkak","merangkak: 1 mbrangkang; 2 ent. ora rikat lakune.","","ngoko,krama,dialek"],["rangkap","i dirangkap: didêkêp, dicêkêl; perangkap: pasangan kewan. ii rangkêp, sapasang ngloro; dirangkap: dirangkêp, ditindakake barêng.","","ngoko,arab"],["rangket","dirangket: dirangkèt.","","ngoko,dialek"],["rangkik","bngs. tirêm.","",""],["rangking","bngs. tombong, rêmbêng.","","ngoko,cakapan"],["rangkum","(se-) sarauk, sajupukan; dirangkum: dicakup nganggo tangan loro.","","ngoko"],["rangkung","merangkung: ndhodhok.","","dialek"],["rangkup","1 gonggangan (lowahan); 2 têpung tmr. alis.","","ngoko"],["rangsang","i ut. berangsang: sêngak, sumêgrak; dirangsang: disigrakake, dimêmpêngake sarana diombèni inuman kêras lsp. ii dirangsang: dirangsang, dirabasa.","","ngoko"],["rangsum","rangsum, ingon.","","ngoko"],["ranguk","ar. wit.","","ngoko"],["rangup","mêprêl, gampang cuwile.","","ngoko"],["rani","i sugih; kc. gani. ii rajaputri; maharani: pramèswari.","","ngoko,arkais"],["ranjang","bngs. ambèn paturon, tempat tidur.","","ngoko,dialek"],["ranjau","borang.\n--- 145 ---","","ngoko"],["ranjau-laut","bom kambang ing sêgara.","","ngoko"],["rantai","rante; rantai kangkang: blênggu sikil; baju rante: klambi kêre; orang rantai: prantean; dirantaikan: dirante.","","ngoko,dialek"],["rantam","dirantam: dikrubut, ditandangi bêbarêngan; rantaman: krubutan, bajongan tmr. têtuku lsp.","","ngoko"],["rantang","rantang (bngs. kranjang cilik dianggo wêwadhah).","","ngoko,dialek"],["rantau","lêngkonganing kali ut. sêgara; teluk rantau: 1 sunglon lan lêngkonganing sagara; 2 ent. wêwêngkon, tlatah; merantau: 1 lêlayaran turut rantau (golèk kayu lsp); 2 ent. lunga mênyang ngamanca golèk panguripan.","","ngoko,krama,dialek"],["ranting","rèncèk; meranting: 1 padha gogrog godhonge (ngarang); 2 ent. tuwa; meranting aur: tuwa bangêt.","","ngoko"],["ranum","dalu (matêng-bangêt).","","ngoko,krama"],["ranyah","diranyah: 1 dijupuki sathithik-sathithik tmr. lêlawuhan ing rampadan; 2 dianggo dhisik.","","ngoko"],["rap","swara krêpyêk, krês.","","ngoko"],["rapah","dirapah: 1 diidak-idak, diicak-icak; 2 diwatun lêt sêsasi sabakdane tandur.","","ngoko"],["rapak","berapak: bêbarêngan (turu, linggih lsp); merapak: nggladrah; dirapakkan: digêlar.","","ngoko"],["rapang","ar. iwak sagara.","","ngoko"],["rapat","1 rapêt, rêngkêd, cêdhak mèpèt; 2 rakêt tmr. pamitran; srasehan, rêrêmbugan; 3 (ut. kerapatan) pakumpulan; dirapatkan: dirapêtake, dirêngkêdake; 2 digandhèng, dicêdhakake.","","ngoko"],["rapi, rapih","sarwa bêcik.","","ngoko"],["rapih","i 1 roti kang njêro; merapih: mêprêl. ii dirapih: dicakêtake, digandhèng dicêdhakake.","","ngoko,dialek"],["rapik","merapik: gunêman ngayawara.","","ngoko"],["rapin","ar. têtuwuhan.","",""],["rapu","dirapu: diopèni (dijupuk) tmr. barang kang ora mbêjaji; merapu dana: ngêmis.","","ngoko,krama,dialek"],["rapuh","mêprêl, gêtas, bêbrêg; rapuh hati: gampang trênyuh; rapuh mulut: sênêng nggunêm (nyatur, gunêman ala lsp); nyawa rapuh: apêsan.","","ngoko,dialek,arkais"],["rapung","merapung: ngambang, kumambang; kc. apung.","","ngoko"],["rapus","dirapus: dicêncang sikile (tmr. kêbo lsp. arêp dibêlèk).","",""],["ras","i swara krêtêg. ii tali ras: apus, kêndhali.","","ngoko"],["rasa","1 rasa, pangrasa; 2 kira, pangira; berasa, merasa: ngrasa, krasa, rumangsa; dirasai: dirasakake, ditêmahi; rasanya, serasa: kayadene.","","ngoko"],["rasai","merasai: wis nandhang ut. ngalami kasusahan akèh; perasaian: panandang.","","ngoko"],["rasam","padatan; tatangadat; kc. rasmi.","","ngoko,arkais"],["rasamala","rasamala.","","ngoko"],["rasau","bngs. pandhan; merasau: nywara krasak-krasak kaya pandhan kanginan.","","ngoko,dialek,arkais"],["rasi","i 1 gêgambaran ing langit kang kadadeyan saka lintang-lintang; 2 lintang kang dianggo mêthèk bêgja cilakaning wong; dirasi: dipetungi (ditayuh lsp). arêp disumurupi jodho lan orane lsp; berasian: ngimpi, kêtayuh; perasian: bêgja cilakaning manungsa kasumurupan saka ing palintangan; serasi: cocog petungane, jodho, prayoga. ii kc. raksi.","","ngoko,krama,dialek,arkais"],["rasmi","1 miturut pranatan (padatan); 2 dhinês, opisiyil; hukum rasmi: pranatan manut padatan.","","ngoko,arkais,arab"],["rasuk","i palang olèh cagak dianggo sanggan glogoring jrambah. ii kena rasuk, dirasuk(i): disurupi; kerasukan: kêsurupan.","","ngoko,krama"],["rasul","rasul, utusaning allah.","","ngoko,arab"],["rasullullah","utusaning allah (k.n. muhamad s.a.w).","","ngoko,arab"],["rasyid","jujur, têmên ênggone ngibadah.","","ngoko"],["rasywan","ruba, bêsêl.","","ngoko"],["rat","singsêt, kêncêng; kc. erat.","","ngoko,dialek"],["rata","i 1 (ut. merata) rata, rampak; 2 (ut. sama rata, rata-rata) racak, kabèh padha; 3 (ut. serata) wrata ingêndi-êndi, sumarambah; diratai: diwratani, disrambahi; diratakan: dirata, dirampak, diracak. ii kreta (ing papêrangan). iii rata-rata: bngs. sulung.","","ngoko,cakapan,dialek,arkais"],["ratah","wantahan (tanpa momoran); meratah: 1 nindakake maligi; 2 nggadho iwak lsp.","","ngoko"],["ratap","sêsambat, ngêsah; meratap: nangis sêsambat.","","ngoko"],["ratib","kêrêp, tansah; meratib: dikir la ilaha illa'llah.\n--- 146 ---","","ngoko"],["ratna","1 intên; 2 ent. putri; ratna mutu manikam: (intên, mutiara, mirah) sêsotya warna-warna.","","ngoko,krama,inggil,arkais,sanskerta"],["ratu","1 ratu; 2 ratu putri, pramèswari.","","ngoko,inggil,arkais"],["ratus","seratus dua ratus: 100, 200.","","ngoko"],["rau","mak byuk (banyu udan lsp).","","ngoko,cakapan,dialek,arkais"],["raum","meraum: nggêrêng, nggêro.","",""],["raung","meraung: nggêro, gêro-gêro.","",""],["raup","raup, rauk; dirauk: diraup, dirauk.","","ngoko,inggil"],["raut","pisau raut: bngs. pangot; diraut: diongoti, disisiki.","","ngoko,dialek"],["rawa","rawa; kain rawa: bngs. sutra.","","ngoko"],["rawah","i bathon dagang (ana sing urun dhuwit ana sing bau). ii kuwali gêdhe.","","ngoko,krama,dialek"],["rawai","pancing rawe.","","ngoko"],["rawak","dirawak (-rambang): diawag tmr. mbêdhil, mbalang lsp.","","ngoko"],["rawan","i trênyuh, ngêrês, atine; merawan: ngênês, ngranuhi; merawankan hati: nrênyuhake (ngêrês-êrêsi) ati. ii 1 wilangan barang lawe, kayata jala sêrawan; 2 saprangkat kèhe 7, up. kancing sêrawan; tulang serawan: balung iga.","","ngoko,arkais"],["rawang","rawa, alas kang ora akèh wite; dirawang: didusi, tmr. mayit.","","ngoko,krama,dialek"],["rawat","dirawat: dirawati, diopèni, diupakara.","","ngoko"],["rawi","juru crita (pangarang lsp.).","","ngoko"],["rawit","i cabe rawit: lombok rawit. ii (ke-) rawitan: krawitan, gêndhing bêbuka.","","ngoko,arkais"],["raya","gêdhe, agung; dirayakan: dimulyakake srana pista lsp; perayaan: pahargyan (pista lsp).","","ngoko,arkais"],["rayah","merayah: ngrayah.","",""],["rayang","nggliyêr, yêr-yêran.","",""],["rayap","merayap: mrambat, nggrêmêt; dirayapi: dirambati, digrêmêti.","",""],["rayat","rakyat.","",""],["rayau","merayau: 1 gagap-gagap, grayah-grayah; 2 ngudhêg nganggo tangan lsp; 3 tansah obah tmr. awak lsp.","","ngoko,dialek"],["rayu","1 (sayu-) rasa sêdhih; 2 (ut. merayu) sêdhih, ngêrês, kêrasa-rasa, kêranta-ranta.","","ngoko"],["reba","tumpukan kayu (pang) ing babadan.","","ngoko,dialek"],["rebab","rêbab.","",""],["rebah","rubuh, ambruk, nggloso; rebah rempah: ambruk pating slayah.","","ngoko,krama,arkais"],["rebak","i polèng-polèng (dham-dhaman) ing bakal. ii mluwèk tmr. tatu, bêdhah tmr. layar lsp.","","ngoko"],["reban","i direban: dibanting, dikipatake; kc. heban. ii longaning omah panggung.","","ngoko"],["rebana","têrbang, kêtipung.","",""],["rebas","rusak padha popol.","","ngoko,dialek"],["rebat","direbati: dipêpêti slangkrah, êri lsp.","","ngoko"],["rebatang","rêbatang (kayu mati).","","ngoko"],["rebeh","suwèk nglèmbrèh tmr. layar, dhèngklèh tmr. suwiwi.","","ngoko"],["rebo","rêbo.","",""],["rebuk","merebuk: ngurèng tmr. gudhig.","","ngoko"],["rebung","bung; merebung: 1 golèk bung; 2 kaya bung.","","ngoko,dialek,arkais"],["rebus","direbus: digodhog.","",""],["rebut","direbut: dirêbut.","",""],["reca","rêca.","",""],["recak","ut. recak-recak: burik bêrcak; berecak: brêcak.","","ngoko"],["recik","merecik: nyiprat; direciki: diciprati, dikêpyuri.","","ngoko"],["recup","merecup: 1 pating pênculat tmr. iwak, urang lsp; 2 padha trubus tmr. wiji, kacang lsp.","","ngoko,dialek"],["reda","i palilah, idin, kc. rela. ii mêndha, lêrêm tmr. angin lsp., rada suda tmr. lêlara lsp.","","ngoko"],["redah","diredah: ditêgor, disigar tmr. pring disêrang ut. ditekadi tmr. bêbaya.","","ngoko"],["redam","i swara brung, dhung. ii redam-redam, meredam: lamat-lamat tmr. swara, rêrupan lsp; kc. remuk redam.","","ngoko,dialek"],["redan","ar. wit.","","ngoko"],["redang","i rawa, êmbêl. ii mangêt-mangêt.","","ngoko"],["redap","i bngs. kêtipung. ii meredap: padha thukul tmr. kukul, plênthing lsp.","","ngoko"],["redas","meredas: ngancab, nrajang, nyrudug.","","ngoko"],["redih","diredih: didhaut.","",""],["redik","diredik: disrêngêni bangêt; kc. hardik.","",""],["redum","i timbrêng, pêtêng rêmêng-rêmêng; kc. redup. ii dirêdum: dipêpêti tmr. dalan.\n--- 147 ---","","ngoko"],["redup","1 timbrêng, pêtêng rêmêng-rêmêng; marga pêdhut lsp; 2 ut. redup-redup: lamat-lamat tmr. swara.","","ngoko"],["regang","kêncêng (manthêng); diregang(kan): ditarik (dipanthêng) kêncêng.","","ngoko,cakapan,arkais"],["regat","diregat: disabrangi nrabas ut. nênggêl tmr. dalan lsp.","","ngoko"],["regu","pêpanthan giliraning wong nyambut gawe; beregu: giliran gêgolongan tmr. wong nyambut gawe; kc. gu.","","ngoko,arkais"],["rehal","1 padunungan, wêwêngkon; 2 rêkal (sanggan kitab).","","ngoko,arab"],["reja","suwekan sêmbagi, dluwang lsp.","","ngoko"],["rejah","merejah: 1 numbuk bêntus, nekad numbuk-numbuk; 2 ent. clola-clolo, murang tata; perejah: wong kang dêksura.","","ngoko,dialek,arkais"],["rejam","direjam: dibandhêmi watu; kc. rajam.","","ngoko"],["rejan","lara ising-isingên pating plilit; batuk rejan: watuk sêngkil (watuk garing); direjan: 1 diênêtake, diêdênake; 2 dipêtêl-pêtêl, diujêg.","","ngoko"],["rejang","i (se-)sadohe ..., up. sêrêjang kuda lari. ii urut-urutaning têtêngêr ing palintangan dianggo mêthèk bêgja cilaka utawa ala bêciking dina. iii direjang: dipêcah nganggo linggis lsp; perejang: linggis.","","ngoko"],["rejeh","jêlèh, rêmbês.","",""],["rejeki","rêjêki.","",""],["rejuk","merejuk: mêncolot-mêncolot, mlumpat.","","ngoko"],["reka","reka, rêrekan, pangathik-athik, rumpakan; direka: 1 direka, direkadaya; 2 diathik-athik, dirumpaka, dianggit.","",""],["rekah","plêthekan (ing woh lsp); merekah: mlêthèk, mlêkah; merekah fajar: bangun esuk, gagat rina.","","ngoko,krama,dialek"],["rekan","1 pasar, papan paklumpukaning barang dagangan; 2 bakul; 3 (ut. rekanan) kanca, kanca bathon dêdagangan, kanca tunggal pagaweyan.","","ngoko,krama,dialek,arkais"],["rekat","krakêt; perekat: ancur, lim; kc. lekat.","","ngoko,arkais"],["rela","rila; direlakan: dirilakake.","","ngoko"],["relai","1 bngs. tirêm gêdhe; 2 ar. wit.","","ngoko"],["relang","kolongan pênjalin (kalung asu lsp).","","ngoko"],["relas","nglinyêm, mlècèt; kc. lelas.","","ngoko"],["relau","bngs. kêrên kanggo ngluluh wêsi lsp.","","ngoko"],["relung","i guwa, song ing pèrèng; merelung: ngêsong, lêgok kaya guwa. ii ar. ukuran lêmah ana 1? acre.","","ngoko,dialek,arkais"],["remah","gogrogan (upa, cuwilan panganan lsp); diremah-remahkan: dicuwil-cuwil, diècèr-ècèr.","","ngoko"],["remaja","diwasa, wis mangsane omah-omah.","","ngoko"],["remak","aluwung, angur.","","ngoko,cakapan"],["remang","i rêmêng-rêmêng, timbrêng. ii ut. meremang: njêgrag tmr. rambut lsp. iii meremang-remang: gumrênggêng, gumluruh.","","ngoko"],["remas","kc. ramas.","",""],["rembah-rembih","1 pating dlèwèr tmr. luh; 2 pating slêmbrèh.","","ngoko,cakapan"],["rembang","nêdhêng dhuwur-dhuwure, up. rêmbang matahari (srêngenge ana ing têngah bênêr), rêmbang kuasanya (sagêdhe-gêdhene panguwasane).","","ngoko"],["rembas","rusak ut. bosok bangêt.","","ngoko"],["rembat","merembat: oglag-aglig, oyag-ayig, miyat-miyut.","","ngoko,dialek"],["rembega","wit widuri; kc. lembega.","","ngoko"],["rembes","ut. merembes: ngêmbês, rêmbês, umês, pating prêntul tmr. kringêt.","","ngoko"],["rembunai","sêdhêngan gêdhene (ut. dhuwure).","",""],["remet","meremet: nggêdobrol.","",""],["remis","ar. keyong cilik.","","ngoko"],["rempah","(rebah-) ambruk, rubuh.","","ngoko,arkais"],["rempah (-rempah)","bumbu, jantu, adon-adon; dirempahi: dijêbadi, tmr. mayit.","","ngoko"],["rempak","i urut kacang; serempak: 1 salaras; 2 (-sekali) sapisan brêg, babarpisan, bêbarêngan; berempak: maju barêng. ii gêmpil, cuwil ing pinggir.","","ngoko"],["rempang","nglawèr (nglèmbrèh).","","ngoko"],["rempa