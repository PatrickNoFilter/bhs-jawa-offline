anar","êndhut ing sagara.","","ngoko"],["lanat","laknat, bêbêndu; dila'natkan: dibêndoni, disotake, disebratake.","","ngoko"],["lanau","lêndhut, êmbêl.","",""],["lanca","ar. prau.","","ngoko"],["lancana","tandha; têngêr; ciri.","","ngoko,arkais"],["lancang","i ar. prau pêrang jaman kuna. ii lancang, clandhakan, kêmajon. iii ancak.","","ngoko,sanskerta"],["lancap","alus sarta wrata, papak alus.","","ngoko,inggil,dialek,arkais"],["lancar","rikat, bantêr lakune, lancar; melancar: lumarap (nylorot) bantêr; dilancakan: dilarapake ditlorongake.","","ngoko,dialek"],["lancip","lancip, lincip.","","ngoko,dialek"],["lancit","melancit: muncrat, mêncurat.","","ngoko"],["lancung","palsu, ora murni, tiron; melancung: ngapusi, mblibuk.","","ngoko,krama"],["lancung-kicu","apus krama.","","ngoko"],["lancur","mancur.","","ngoko"],["lancut","i tanpa gawe. ii melancut: muncrat, mêncurat.","","ngoko"],["landa","melanda: nrabas, nêmbus, nrajang.","","ngoko"],["landai","rada mayat tmr. palêmahan, ngêndhêlong tmr. tali lsp.\n--- 103 ---","","ngoko"],["landaian","1 landeyan; 2 ukiran kêris.","","ngoko"],["landak","landhak.","","ngoko,dialek"],["landas","ganjêl, landhêsan; landasan: paron, landhêsan.","","ngoko"],["landuh","mblêndhuk.","",""],["landung","landhung, kêdawan.","","ngoko"],["landut","melandut: katon mbrênjul ut. mblêndhuk (up. dhompèt ing kanthongan).","","ngoko"],["lang","manuk wulung; kc. elang.","","ngoko,dialek"],["langah","terlangah, terbelangah: mênga, njêblag.","",""],["langau","(lalat-) lalêr wilis.","","ngoko,arkais"],["langgaian","anjang-anjang.","","ngoko"],["langgam","i berlanggam: rêrukunan, bajongan tuku barêng. ii cara; selanggam: padha cengkoke, nunggal carane.","","ngoko,arkais"],["langganan","lêngganan.","",""],["langgar","dilanggar: 1 ditumbuk, ditrajang; 2 ditêrak tmr. larangan lsp; pelanggaran: palanggaran (prakara nêrak anggêr-anggêr).","","ngoko"],["langir","(landha, sabun lsp) kang dianggo kramas; melangir, berlangir: adus kramas; dilangiri: dikramasi.","","ngoko,dialek"],["langit","langit; langit-langit: 1 plangitan; 2 (ut. langitan mulut) cêthak; melangit: sundhul langit, ent. muluk bangêt.","","ngoko,inggil,dialek"],["langkah","jangkah, tindak; melangkah: njangkah, mlangkah; dilangkah(i): 1 dilangkahi; 2 ditêrak tmr. larangan lsp; dilangkahkan: 1 dijangkahake; 2 disarati murih slamêt tmr. prau kang arêp lêlayaran; pelangkah: sarat srana kanggo nyarati prau kang arêp mangkat supaya slamêt; pe(r)- langkahan: slamêtan lsp nalikane arêp ngangkatake prau.","","ngoko,inggil,dialek"],["langkai","bêcik wangune; kc. lampai, ramping.","","ngoko"],["langkan","jrambah kang dhuwur (balkon).","","ngoko,dialek"],["langkap","i perangan wadhah suruh ing tepak (wadhah kinang), ii kc. lengkap.","","ngoko,dialek"],["langkas","cukat, trêngginas, mêmpêng.","","ngoko,arkais"],["langkat","têlung dina êngkas.","","ngoko"],["langkau","kêlangkahan (pangetunge lsp); dilangkaui: dilangkahi.","",""],["langlang","nganglang, midêr-midêr.","","ngoko"],["langsai","langse, gubah.","","ngoko"],["langsar","1 katon dawa nglojok; 2 lêncir, dhuwur jêjêg.","","ngoko"],["langsat","langsêp.","",""],["langsi","melangsi: lungse, langkah saka ukurane.","","ngoko,arkais"],["langsing","i bantas, sêru tmr. swara; melangsing: ngêlik, mbrêngêngêng tmr. kombang. ii alus bêcik tmr. bangkekan lsp.","","ngoko,dialek"],["langsuir, langsuyar","sundêl bolong.","","ngoko"],["langsung","1 têrus, tanpa lèrèn, ngênêr têrus; 2 lêstari; 3 rampung, sida; berlangsung: sida kêlakon; dilangsungkang: ditêrusake, dilêstarèkake, dirampungake.","","ngoko"],["langu","rada badhêg (ambune iwak buthuk).","","ngoko"],["langut","melangut: krasa kangên (kêpengin) bangêt.","","ngoko"],["lanjar","dawa nglawèr, dawa pucuke mêrit.","","ngoko"],["lanjung","cilik dawa tmr. têbu lsp.","","ngoko"],["lanjur","nglantur (nganti suwe); dilanjurkan: dilanturake, diulur; terlanjur, telanjur; kêbanjur.","","ngoko"],["lanjut","1 dawa (tmr. umur), nglantrah tmr. crita lsp; 2 têrusan, banjur bae; dilanjutkan: 1 didawakake, diulur; 2 dibanjurake, ditêrusake.","","ngoko"],["lansing","kc. langsing.","","ngoko"],["lantai","jrambah ut. gladhaging omah panggung, prau lsp; besi lantai: wêsi blebekan.","","ngoko"],["lantak","dilantak: diblêsêkake sarana dithuthuk kyt. paku, pathokan lsp, dilantaki; emas lantak: êmas cithakan; pelantak: lantak, gandhèn gêdhe kanggo ngêbruk lsp.","","ngoko"],["lantang","1 bawera tmr. pandêlêng; 2 katon (krungu) cêtha; 3 suwung blung tmr. pasar lsp.","","ngoko"],["lantaran","jalaran, marga.","","ngoko"],["lantas","banjur, nuli, têrus; melantas: nrabas, mlêbu têrus.","","ngoko"],["lantik","dilantik: dikêpyakake (ênggone têtêp ngrênggêp pangkat); pelantikan: kêpyakan.","","ngoko,dialek"],["lantin","lêntera, ting.","","ngoko"],["lantung","sumêntuk tmr. ambu, mbrêbêgi, bangêt tmr. swara.","","ngoko"],["lanyak","dilanyak (-lanyak): diidak-idak ut. diilês-ilês tmr. lêmah lsp.","","ngoko"],["lanyau","lêmah lêndhut kang atos ing dhuwur. [dhu...]\n--- 104 ---","","ngoko,krama,dialek"],["lapah","melapah: 1 midak apa-apa kang sumèlèh ing dalan lsp; 2 mothèng-mothèng (ngrêncak) kewan bêlehan.","","ngoko,dialek,arab"],["lapal","lapal; kc. lafal.","","ngoko,arab"],["lapang","1 jêmbar, ombèr, kobèt, lêga; 2 ludhang, sêla ing pagawean; dilapangkan: 1 dijêmbarake, diombèrake; 2 disêlakake; tanah lapang: ara-ara, alun-alun; kelapangan: 1 lowahan; 2 lêga, sêla ing pagawean; lapangan: papan jêmbar; lapangan bekerja: patêban nyambut gawe; lapangan terbang: papan palerenan mêsin mabur.","","ngoko,cakapan,dialek,arkais"],["lapar","ngêlih (luwe); kelaparan: kêluwèn, kalirên.","","ngoko"],["lapau","warung; kc. lepau.","","ngoko,dialek,arkais"],["lapik","1 lèmèk, sèmèk, lambaran; 2 lèpèk (cawan); lapik kaki: trumpah.","","ngoko,dialek,cina"],["lapis","lapis, sap; dilapis: dilapis, dirangkêpi; lapisan: lapisan.","","ngoko"],["lapuk","1 jamur(ên) tmr. kayu; 2 gapuk, padha popol, buthuk tmr. iwak.","","ngoko,dialek"],["lapun","bngs. jaring kanggo masangi kidang lsp.","","ngoko"],["lara","1 sêdhih, susah; 2 (-berangti) kasmaran.","","ngoko"],["larai","dilarai(kan): 1 dipisah; 2 diêndhakake atine ut. nêpsune; pelarai: wong kang misah.","","ngoko,cakapan,dialek,arkais"],["larak","rêngkêd bangêd tmr. isining durèn lsp.","","ngoko"],["larang","dilarang: dilarangi, diwalêri, dipênging; larangan: larangan, pêpacuh, wêwalêr.","","ngoko"],["larap","i laris, payu. ii dilarapkan: diudhari lan diulur tmr. tampar lsp.","","ngoko,krama,dialek"],["laras","1 dêlêging wit (kang cilik lêncêng); 2 wuluh bêdhil; 3 kanggo petunganing bêdhil; 4 (ut. selaras): salaras, cocog.","","ngoko,dialek"],["larat","ut. melarat: 1 mlaku ut. maju alon; 2 mrèmèn-mrèmèn, tular-tumular; 3 kêlantur-lantur, kêdawa-dawa.","","ngoko,dialek"],["larau","rêribêd, rêrusuh; dilarau(kan): diribêdi, dirusuhi.","","cakapan,arkais"],["lari","playu, mlayu, minggat; dilarikan: 1 diplayokake; 2 diinggatake; 3 diungsèkake; pelari: wong kang minggat, wong kang ngungsi; pelarian: 1 playu; 2 (ut. larian) papan kang dianggo playon (balapan); 3 dalan ciyut (sauruting bètèng), èmpèr-èmpèraning lotèng; selari: bêbanjêngan.","","ngoko,dialek,arkais"],["larik","dilarik: dibubut (diêlus nganggo pambubutan); pelarikan: piranti pambubutan.","","ngoko"],["laris","laris; pelaris: panglarisan.","","ngoko"],["laru","laru.","","ngoko,dialek"],["larung","krêndha, trêbêla.","",""],["larut","1 ajur, luluh; 2 susut; 3 lungse tmr. waktu; larut malam: lingsir wêngi.","","ngoko,dialek,arkais,arab"],["las","blas, bablas.","","ngoko"],["lasa","pêpês.","",""],["lasah","dilasah: disapu, digêbugi; pelasah: kang dianggo nggêbugi.","","ngoko,dialek"],["lasak","dianggo srabudan ut. padinan tmr. piranti lsp; pakaian pelasak: sandhangan padinan.","","ngoko"],["laskar, lasykar","wadyabala, prajurit.","","ngoko,arkais"],["lat","lêt, antara.","","ngoko"],["lata","air lata: grojogan; orang lata: wong asor; melata: nggrêmêt, nlosor.","","ngoko,dialek,arkais"],["latah","duwe saradan sok nirokake pratingkahe wong liya.","","ngoko,dialek,arkais"],["latam","dilatam: diênêt-ênêt supaya madhêt (kayata kapuk ing kasur).","","ngoko"],["latih","lantih; dilatih(kan): dilêlantih, digêgulang; latihan: panglantih.","","ngoko,cakapan,arkais"],["latuh","ar. ganggêng sagara.","","ngoko"],["latuk","(parang-) bngs. berang.","",""],["lau","daun lau: ar. têtuwuhan rambat.","","ngoko"],["lauk","lawuh; lauk-pauk: lêlawuhan.","","ngoko"],["laun","kc, lambat laun.","",""],["laung","melaung: njêlih (mbêngok) sêru.","",""],["laut","sêgara; melaut: mênyang ing têngahing sêgara; dilauti: dilayari, disabrangi; lautan: sêgara gêdhe.","","ngoko"],["lawa","melawa: nyêgat lakuning pangantên; pelawa: alangan, pakewuh.","","ngoko"],["lawah","i gêguyon, banyolan; kc. lawak. ii bawera, kobèt.","","ngoko"],["lawak","banyolan, lêlucon; pelawak: banyolan, dhagêlan.","",""],["lawan","1 lawan, tandhing, sisihan; 2 mungsuh; 3 kosokbali; melawan: nandhingi, madhani; dilawan: dimungsuh, ditandhingi, dilawan; perlawanan: mêmungsuhan, kosokbalèn; diperlawankan: ditandhingake, dimungsuhake.\n--- 105 ---","","ngoko"],["lawang","i ar. wit. ii lawang, gapura, regol.","","ngoko"],["lawar","rajangan ut. suwiran iwak mêntah; dilawar: dirajang ut. disuwiri tmr. iwak.","","ngoko"],["lawas","melawas: 1 jêmbar, bawera, ora kaalang-alangan tmr. pamawas; 2 ngarang-arangi tmr. wêtuning wowohan; 3 lancang; kelawasan: ombèr bangêt, turah-turah.","","ngoko,krama,cakapan"],["lawat","dilawat(i): ditinjo, ditiliki, dilayati, didhayohi.","",""],["lawi-lawi","lancur (ing buntut jago, mêrak lsp).","","ngoko,dialek"],["layah","1 (ut. melayah) miyat-miyut tmr. wit kanginan lsp; 2 bngs. krudhuk; melayah: nglèmbrèh nutupi rai.","","ngoko,dialek"],["layak","i layak, pantês, patut; selayaknya: sapatute. ii dhèndhèng iwak loh.","","ngoko"],["layam","berlayamkan (-pedang, -lembing): ulah (pêdhang, tumbak).","","ngoko"],["layan","dilayan(i): diladèni; pelayan: paladèn.","",""],["layang","i melayang: nglayang (mabur): dilayangkan: dikleyangake (diaburake), dikirimake