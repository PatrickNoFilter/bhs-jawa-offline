<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Basa Jawa Offline — Kamus Indonesia-Jawa & Jawa-Inggris. Tanpa internet.">
<title>Basa Jawa Offline — Kamus</title>
<style>
  :root {
    --bg: #f6f1e7; --card: #ffffff; --ink: #2c2c2c; --muted: #777;
    --accent: #7c4a1e; --accent2: #4a2c12; --border: #ddd; --chip: #e8dcc8;
    --ok: #2e7d32; --star: #d9a441;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    background: var(--bg); color: var(--ink); line-height: 1.5;
  }
  header {
    background: linear-gradient(135deg, #4a2c12, #7c4a1e);
    color: #fff; padding: 14px 16px 12px;
    position: sticky; top: 0; z-index: 20;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
  header h1 { font-size: 20px; letter-spacing: .3px; }
  header h1 small { font-weight: 400; font-size: 12px; opacity: .85; display: block; }
  nav.tabs { display: flex; gap: 6px; margin-top: 10px; }
  nav.tabs button {
    flex: 1; background: rgba(255,255,255,.16); color: #fff;
    font-size: 13px; font-weight: 600; padding: 7px 4px; border-radius: 8px;
    border: 1px solid rgba(255,255,255,.35); font-family: inherit; cursor: pointer;
  }
  nav.tabs button.on { background: #fff; color: var(--accent2); }
  nav.modes { display: flex; gap: 6px; padding: 10px 16px 0; }
  nav.modes button {
    flex: 1; border: 1px solid var(--border); background: var(--chip); color: #444;
    padding: 6px 4px; border-radius: 8px; font-size: 12.5px; font-weight: 600;
    font-family: inherit; cursor: pointer;
  }
  nav.modes button.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .filterwrap { padding: 8px 16px 0; font-size: 12.5px; color: var(--muted); }
  .filterwrap select {
    font-family: inherit; font-size: 13px; font-weight: 600; color: var(--accent2);
    border: 1px solid var(--border); border-radius: 8px; background: #fff;
    padding: 5px 8px; margin-left: 4px; max-width: 70%;
  }
  .searchwrap { margin: 10px 16px 0; position: relative; display: flex; gap: 6px; }
  .searchwrap input {
    flex: 1; padding: 10px 14px; font-size: 16px;
    border: 1px solid var(--border); border-radius: 10px; outline: none;
    background: #fff; color: #222; min-width: 0;
  }
  .searchwrap input:focus { border-color: var(--accent); }
  .searchwrap button.clr {
    border: 1px solid var(--border); background: var(--chip); color: #444;
    border-radius: 10px; padding: 0 14px; font-size: 16px; cursor: pointer;
  }
  .trout { font-size: 16.5px; }
  mark.unknown { background: #ffd9d9; border-radius: 3px; padding: 0 1px; }
  .mini {
    border: 1px solid var(--border); background: var(--chip); color: #444;
    border-radius: 999px; font-size: 11.5px; font-weight: 700; cursor: pointer;
    font-family: inherit; padding: 2px 10px; margin: 0 2px;
  }
  .mini.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  nav.chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 16px 4px; }
  nav.chips button {
    border: 1px solid var(--border); background: var(--chip); color: #444;
    min-width: 34px; padding: 5px 8px; border-radius: 8px; font-size: 12.5px;
    font-weight: 700; cursor: pointer; font-family: inherit;
  }
  nav.chips button.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .sec-head {
    font-size: 13.5px; font-weight: 700; color: var(--accent2);
    margin: 14px 2px 8px; padding-top: 10px; border-top: 1px solid var(--border);
  }
  main { padding: 10px 16px 24px; max-width: 720px; margin: 0 auto; }
  .card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 12px 14px; margin-bottom: 10px;
    box-shadow: 0 1px 3px rgba(0,0,0,.08);
  }
  .entry { display: flex; gap: 10px; align-items: flex-start; }
  .entry .body { flex: 1; min-width: 0; }
  .entry .kata { font-size: 16.5px; font-weight: 700; color: var(--accent2); }
  .entry .arti { font-size: 14.5px; margin-top: 2px; word-wrap: break-word; }
  .entry .tag {
    display: inline-block; font-size: 11px; color: var(--muted);
    border: 1px solid var(--border); border-radius: 999px;
    padding: 0 8px; margin-top: 6px; margin-right: 4px;
  }
  .tag.lvl-ngoko { background: #e6f2e6; color: #2e7d32; border-color: #b5d8b5; }
  .tag.lvl-krama { background: #e3ecfa; color: #1e40af; border-color: #b3c6ea; }
  .tag.lvl-inggil { background: #fbf3dd; color: #8a6d1a; border-color: #e8d48a; }
  .tag.lvl-andhap { background: #f3e8fb; color: #6d1a8a; border-color: #d8b3ea; }
  .tag.lvl-kasar { background: #fbe3e3; color: #a02020; border-color: #eab3b3; }
  .tag.lvl-cakapan, .tag.lvl-dialek, .tag.lvl-arkais { background: #f0ebe2; color: #6d5a3e; border-color: #d8cbb6; }
  .tag.lvl-arab, .tag.lvl-sanskerta, .tag.lvl-walanda, .tag.lvl-cina, .tag.lvl-melayu, .tag.lvl-prancis, .tag.lvl-portugis { background: #ece7f5; color: #4a3e7c; border-color: #c9bde4; }
  .star {
    border: none; background: none; font-size: 22px; cursor: pointer;
    color: #ccc; padding: 0 2px; line-height: 1.2; flex-shrink: 0;
  }
  .star.fav { color: var(--star); }
  .hist { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .hist button {
    border: 1px solid var(--border); background: #fff; color: var(--accent2);
    padding: 4px 12px; border-radius: 999px; font-size: 12.5px; cursor: pointer;
    font-family: inherit;
  }
  .more {
    display: block; width: 100%; border: 1px solid var(--accent); background: #fff;
    color: var(--accent); border-radius: 10px; padding: 10px; font-size: 14px;
    font-weight: 700; cursor: pointer; font-family: inherit; margin-bottom: 10px;
  }
  .muted { color: var(--muted); font-size: 12.5px; }
  .count { padding: 2px 0 10px; }
  h2.sec { font-size: 15px; color: var(--accent2); margin: 12px 0 8px; }
  .about p { font-size: 14px; margin-bottom: 8px; }
  .about li { font-size: 13.5px; margin: 0 0 4px 18px; }
  mark { background: #ffe9a8; border-radius: 3px; padding: 0 1px; }
</style>
</head>
<body>
<header>
  <h1>ꦧꦱꦗꦮ Basa Jawa Offline <small>Kamus &amp; Ensiklopedia — 100% offline</small></h1>
  <nav class="tabs">
    <button data-tab="kamus" class="on">🔍 Kamus</button>
    <button data-tab="fav">⭐ Favorit <span id="favCount"></span></button>
    <button data-tab="about">ℹ️ Tentang</button>
  </nav>
</header>

<section id="tab-kamus">
  <div class="searchwrap">
    <input id="q" type="search" placeholder="Ketik kata… (cth. buku, banyu, mangan)" autocomplete="off">
    <button class="clr" id="clr" title="Bersihkan">✕</button>
  </div>
  <div class="filterwrap"><label for="lvlFilter">Tingkat tutur:</label>
    <select id="lvlFilter">
      <option value="">Semua</option>
      <option value="ngoko">Ngoko</option>
      <option value="madya">Madya</option>
      <option value="krama">Kromo</option>
      <option value="inggil">Kromo Inggil</option>
      <option value="andhap">Kromo Andhap</option>
      <option value="kasar">Kasar</option>
      <option value="cakapan">Cakapan</option>
      <option value="dialek">Dialek</option>
      <option value="arkais">Arkais</option>
      <option value="arab">Asal: Arab</option>
      <option value="sanskerta">Asal: Sanskerta</option>
      <option value="walanda">Asal: Walanda</option>
      <option value="cina">Asal: Cina</option>
      <option value="melayu">Asal: Melayu</option>
      <option value="prancis">Asal: Prancis</option>
      <option value="portugis">Asal: Portugis</option>
    </select>
  </div>
  <nav class="chips" id="chips"></nav>
  <main id="results"></main>
</section>

<section id="tab-fav" style="display:none">
  <main id="favList"></main>
</section>

<section id="tab-about" style="display:none">
  <main class="about" id="aboutBody"></main>
</section>

