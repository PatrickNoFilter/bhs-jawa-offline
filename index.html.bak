ais kotor","","arkais"],["ramelan","bulan yang kesembilan di tahun Hijrah, bulan Puasa","","ngoko"],["rames","dicampur menjadi satu; umpama sega rames ‘nasi rames’","","ngoko"],["rames","arkais 1 merusak, melebur; 2 mengerahkan (tentang sekutu, teman, anak buah, dan sebagainya)","","arkais"],["rames","dialek Kromo Ngoko mengerti sungguh-sungguh terhadap arti kata dan sebagainya","","ngoko,dialek"],["rami","1 rami; 2 serat tumbuhan rami, Boehmeria nica","","ngoko"],["ramon","1 korban, orang yang dianiaya; 2 kayu pelampung yang untuk pegangan ketika berenang agar tidak tenggelam; 3 sampah di sungai","","ngoko"],["rampa","mendepang, membopong, menggotong orang pingsan dan sebagainya","","ngoko"],["rampad","menata lauk-pauk di piring dan sebagainya;","","ngoko"],["rampag","cakapan Kromo Ngoko sama tinggi, rata (padi di sawah dan sebagainya)","","ngoko,cakapan"],["rampak","arkais terjang, menerjang, saling terjang","","arkais"],["rampak","1 serempak, semua sama (tidak ada yang menganjur); 2 seimbang serta rata-rata, sama rata;","","ngoko"],["rampaka","arkais menyairkan, mengarangkan dengan syair","","arkais"],["rampal","rompong, tanggal (gigi), sempal (tentang cabang);","","ngoko"],["rampang","dialek Kromo Ngoko kayu palang di antara kayu tarik pada kereta (dokar dan sebagainya)","","ngoko,dialek"],["rampas","1 merampasi (memotongi) tumbuh-tumbuhan, membuat rata (membuat tampak sama) apa-apa yang menganjur atau menyembul, memotong ujungnya (pohon); 2 dialek memetik daun tembakau yang paling akhir (paling atas);","","ngoko,dialek"],["rampas","pusat besi berani (ganti gigi) tentang kuda","","ngoko"],["rampas","1 merebut dengan paksa; 2 menyita (barang rampasan)","","ngoko"],["ramped","1 dirampat; 2 dibidai, dikerai, semua diikutkan tidak ada yang ditolak (dilewati)","","ngoko"],["rampekan","sembulihan yang diletakkan di bagian bokong","","ngoko"],["rampes","arkais merajang; menyayat; mengiris tipis-tipis","","arkais"],["rampet","dialek Kromo Ngoko tali tampar (digunakan le