raos","1 prada; 2 êngg. pc. prasa.","","krama"],["prasa","praos k. êngg. pc. pangrasa.","","ngoko"],["prase","ak. (mangsa [x]) mangsa akèh buron alas (ent. akèh durjana).","","ngoko"],["prasu","êngg. pc. palsu.","","ngoko"],["prata","kw. kaluwihan, kamisuwuran.","","sanskerta"],["prawa","wayang [x] êngg. wayang purwa.","","ngoko"],["praya","I kw. niyat, sêdya, karêp. II kn. ak: cahya (tmr. jaran); nyuda [x] pc: nyuda kaluhuraning liyan.","","ngoko"],["preen","pc. liburan; kc. prèi.","","ngoko"],["prelu","ak. pêrlu.","","ngoko"],["prema","kw. sih kawêlasan, pangeman; di-[x] êngg: dieman, dipirma.","","sanskerta"],["premi","ganjaran, pangêbang.","","ngoko,walanda"],["prene","sa-[x] n. sapriki k. tumêka saiki; diprènèkake n. dipunprikèkakên k: diparakake mrene.","","ngoko"],["presa","pc. priksa.","","ngoko"],["preta","kw. 1 roh, jiwa; 2 mêmêdi, dhêmit.","","sanskerta"],["pretu","kw. ak. apyun, madat.","","sanskerta"],["prewe","êngg. kapriye.","","ngoko"],["pribe","êngg. kapriye.","","ngoko"],["pribu","di-[x] kw: ditêmpuh, disêrang.","","ngoko"],["prige","êngg. kapriye.","","ngoko"],["prigi","1 êngg. saèm. tanggul kang digawe watu tumpukan; 2 ak. bêlik, sêndhang, tuk.","","ngoko"],["prika","sa-[x] k. saprana; dipunprikakakên k: dipranakake.","","ngoko"],["priki","sa-[x] k. saprene; dipunprikèkakên k: diprènèkake.","","ngoko"],["prime","êngg. kapriye.","","ngoko"],["pring","dêling k. ar. wit dêlêge digawe dandanan warna-warna, dene arane; [x] pêtung (-ori, apus, wulung, lsp).","","ngoko"],["priti","kw. 1 bungah, sênêng; 2 rukun, mitra.","","sanskerta"],["priwe","êngg. kapriye.","","ngoko"],["priya","kw. (wong-) lanang.","","sanskerta"],["priye","pc. kapriye.","","ngoko"],["prono","dipronokake n. dipunprikakakên k: digawa (diênêrake mrono).","","ngoko"],["prosa","di-[x] kn. alk. diprusa.","","ngoko"],["prung","mak [x] pc. sanalika padha lunga kabèh.","","ngoko"],["prusa","di-[x] kn. dipêksa, dijiyat, dipiyagah.","","ngoko"],["prusi","têtaining kuningan ut. têmbaga; di-[x]