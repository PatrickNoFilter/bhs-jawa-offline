],["alas rumah","têtalêsing omah.","","ngoko"],["alat","piranti, prabot; alat kerajaan: upacara kraton; peralatan: 1 prabot, ubarampe, upacara; 2 nindakake tatacara.","","ngoko"],["alat-alat","kayadene.","",""],["alau","manuk rangkok.","","ngoko"],["algoja, algoju","lêgojo (tukang ngukum kisas).","","ngoko"],["ali","i mengali: tansah ngaton (nglêleda lsp). ii ali-ali: bandhil; membuang ali-ali, mengali-ali: mbandhil.","","ngoko,dialek"],["alih","beralih, alihan, ngalih, malih; mengalih: ngalih; dialihkan: diêlih, diingsêr.","","ngoko,krama"],["alih-alih(kan)","jêbule ...","",""],["alim","bngs. blêndok damar.","","ngoko"],["alim","wong pintêr babagan agama.","","ngoko,arkais"],["alin","dialin: diginyêr nganggo êndhog lsp. supaya mari lara.","","ngoko"],["aling","dialing(-aling): diiling-ilingi, ditamatake.","","ngoko"],["alip","penyepit alip jumput cilik.","","ngoko"],["alir","i mengalir: mili; dialirkan: diilèkake; aliran: ilèn-ilèn, kalenan. ii (umpan alir): kewan urip-uripan dianggo pakan pancing.","","ngoko,dialek,arab"],["alis","alis; kc. kening.","","ngoko"],["alit","i 1 pinggiran (sêrêt lsp) kang diirêng nggalir kyt. mripat dicêlak; 2 (tali alit) uwêd gangsingan; 3 (ukur alit) cêngkorongan, pranatan; dialit: 1 dicêlak (tmr. mata), dicèt ing têpine; 2 diplipis (diwiru) tmr. srêban lsp.; 3 dirancang, dipranata. ii ut. alitan: tampar wuwuhan.","","ngoko,krama,dialek"],["alkah","i wijining manungsa; 2 asaling urip.","","ngoko"],["alkari","lak.","","ngoko"],["alkissah","dongèng, crita.","","ngoko"],["alku","jomblang.","","ngoko"],["allah subhana wa taala","allah kang pantês ingalêmbana sarta mahaluhur.","","ngoko,dialek,arab"],["allah taala","gusti allah mahaluhur.","","ngoko,arab"],["allahualam bissawab","allah kang priksa ing sanyatane.","","ngoko,inggil,dialek,arab"],["allahuma","dhuh allah!","","ngoko,arab"],["almanak","almênak, pananggalan.","",""],["almarhum","jênate.","",""],["almari","lêmari.","","ngoko"],["almas","intên.","",""],["almasih","sang panêbus (nabi ngisa).","","ngoko,arkais"],["alpa","sêmbrana, ora ngati-ati; dialpakan: dilirwakake.","","ngoko,krama"],["alperes","bngs. opsir.","","arkais"],["alu","i dialu(-alukan): dipêthuk, dipapagake, diancarani. ii alu; alu-alu: ar. iwak sagara.","","ngoko"],["alum","mengalum: alum, susut.","","ngoko,dialek"],["alun","alun: mengalun, beralun: ngombak.","","ngoko"],["alun-alun","alun-alun.","","ngoko"],["alung","gacuk.","","ngoko,dialek"],["alungan","blumbang, tlaga.","","ngoko"],["alur","beralur: rêrêmbugan.","",""],["alur bibir (-hidung)","gumun (lêgokan ing lambe dhuwur).","","ngoko"],["alur(an)","1 lêgokan kang nggalêr dawa (ing kayu lsp.); 2 peranganing kali utawa sagara kang jêro kang dianggo dalan prau.","","ngoko,dialek"],["alus","kc. halus.","","ngoko"],["am","i umum, sumarambah, kaprah. ii taun.","","ngoko"],["ama","ama, gêgrêmêt kang ngrusak têtanduran.","","ngoko,dialek"],["amah","babu.","","ngoko,arkais"],["amal","panggawe bêcik; di'amalkan: ditindakake tmr. piwulang lsp.","","ngoko"],["amamat","kaimaman.","",""],["aman","slamêt, têntrêm, ora rusuh.","","ngoko,krama,dialek"],["amanat","1 kaslamêtan, katêntrêman; 2 apa-apa kang dititipake (dianggo tanggungan, dianggo cêkêlan, dipracayakake) 3 piwêling, piwêkas; diamanatkan: dipracayakake, dipasrahake.\n--- 11 ---","","ngoko,dialek"],["amang","i diamang(-amang): diagag-agagi, digêgiro; dikira-kira, diawag. ii campuran ing timah.","","ngoko"],["amar","dhawuh, pêpacuh; diamarkan: didhawuhake, dipacuhi.","","ngoko,inggil"],["amarah","nêpsu.","",""],["amat","i bangêt. ii di(per) amat-amati: diawasake, ditamatake, diulat-ulatake.","",""],["ambai","bngs. irig gêdhe didokok ing prau dianggo golèk iwak.","","ngoko"],["ambai-ambai","1 bngs. kêpithing; 2 bngs. kêmladheyan.","",""],["ambal","i babud. ii berambal-ambalan: arak-arakan.","","arkais"],["ambang","i 1 palang (ing lawang lsp); 2 tlundhag; 3 pinggiran ut. plisir ing klambu lsp. ii kurang lancar lakune tmr. prau; diambang: diêndhêg-êndhêgi lakune tmr. prau.","","ngoko"],["ambar","i cêmplang, kêmba. ii ambêr; ambar batu (kuning): bngs. watu rupane kuning.","","ngoko"],["ambaru","tembok ut. watu ing pinggir kali, sagara lsp.","","ngoko"],["ambat","diambat: dioyak; kc. hambat.","",""],["ambau","i pring (kayu) ditrap ing bambing prau supaya bisa amot akèh. ii mengambau: mlumpat; anjlog; terambau: tiba anjlog (kantêb).","","ngoko"],["ambil","diambil: 1 dijupuk; 2 diêpèk, dialap; 3 dipêthik (tmr. karangan lsp); 4 ditampa (tmr. surasaning têmbung lsp); 5 dipigunakake (tmr. reka, srana); 6 digolèki (tmr. iwak lsp); diambil ingatan: dicathêt; diambil simpan (ringkas): diringkês, dicêkak; berambil-ambilan: padha ngalap; salah ambil: klèru tampa.","","ngoko,arkais"],["ambin","1 bngs. êmban-êmban; 2 (tali-) bngs. tampar dianggo nggêgendhong; diambin: 1 (ut. dikelek ambin) diêmban ing bangkekan; 2 digendhong lsp. nganggo tali lsp; ambinan: gendhongan.","","ngoko"],["amboi","wadhuh!","","ngoko,cakapan"],["ambul","mengambul: mêndal bali (mêncungul).","","ngoko"],["ambung","i bngs. kranjang ut. tenggok dianggo nggêgendhong diêrut olèh êndhas; diambung: digendhong kaêrut olèh êndhas. ii diambungkan: disawatake munggah, diumbulake.","","ngoko"],["ambung-ambung","dudulan (ar. têtuwuhan).","",""],["amil","1 wong kang dana saliyane jakat; 2 kaum, lêbe, pêngulu desa.","","ngoko,dialek,arkais,sanskerta"],["amin","amin.","","ngoko"],["amir","senapati.","","ngoko"],["amirulbahari","senapati lautan.","","ngoko"],["amirulmukminin","(pangarêping wong islam) sêsêbutane para kalipah.","","ngoko,arkais,arab"],["amis","amis.","","ngoko"],["amma badu","sawuse iku.","","ngoko,arkais"],["ampai","i diampai: disampirake lan dipepe; ampaian: sampiran pamemean. ii lêncir, kc. lampai.","","ngoko,krama,dialek"],["ampai-ampai","ar. kewan sagara kang nggatêli.","","ngoko,dialek,arab"],["ampang","i gampang; ii kc. empang.","","ngoko"],["ampas","ampas, sêpah.","","ngoko"],["ampat","papat; kc. empat.","","ngoko"],["ampelam","pêlêm.","",""],["ampelas","rêmpêlas.","",""],["ampu","diampu(kan): 1 disangga, dicongkogi; 2 diratoni, diprentah.","","cakapan,arkais"],["ampuh","i banjir, lubèr. ii gêdhe dayane.","","ngoko"],["ampul","mengampul: mbêdhodhog, mundhak gêdhe.","","ngoko"],["ampun","apura, pangapura; diampuni: diapura.","","ngoko"],["amsal","sanepa, upama.","","ngoko"],["amuk","mengamuk: ngamuk.","","ngoko"],["amung","teramung: sawiji, ngêmungake; inilah saudara tuan yang teramung: siji iki sadulurmu.","","ngoko,krama,cakapan,dialek,arkais"],["anai-anai","rayap.","","ngoko"],["anak","1 anak; 2 bocah; 3 turun(an); 4 wong ing, up. anak malaka; 5 ing têmbung camboran atêgês kang cilik up. anakbukit: (gumuk), perangane kang cilik (up. anak gobèk: cocoh); beranak: duwe anak, manak; diperanakkan: 1 dianakake (dilairake); 2 diêpèk anak; peranakan: 1 pranakan; 2 wadhah bayi; anakan: 1 anakan (uyahan); 2 (ut. anak-anakan) golèk, bonekah.\n--- 12 ---","","ngoko,dialek,arkais"],["anak air","kalèn (sidhatan).","","ngoko"],["anak alang","pêndhadha.","",""],["anak baju","klambi rangkêpan.","","ngoko"],["anak buah","wong-wong kang ana ing omah, kapal lsp.","","ngoko,krama,dialek"],["anak kapal (perahu)","bêbauning prau.","","ngoko"],["anak lidah","sêntil.","",""],["anak mas","anak pèk-pèkan.","","ngoko"],["anak negeri","wong asli ing panggonan kono.","","ngoko,arkais"],["anak rambut","athi-athi, sinom.","","ngoko,arkais"],["anak telinga","kêndhangan kuping.","","ngoko"],["anak tunggal","bocah ontang-anting.","","ngoko,dialek"],["anakanda, anakenda, anakda","ingkang putra.","","ngoko,krama,inggil,dialek"],["anakhoda","nakoda.","","ngoko"],["anang","ênggèr, thole.","","ngoko"],["anasir","jasad asal.","","ngoko,sanskerta"],["anbar","ambêr.","",""],["anbiya","para nabi.","","ngoko,arkais"],["ancai","bujat, rêmuk, rusak, ambyar; diancaikan: dirusak, dirêmuk, dibujat.","","ngoko"],["ancak","ancak.","","ngoko"],["ancam","diancam: diancam, diincim-incim.","",""],["ancar","wit ipuh.","","ngoko"],["anda-musang","klênjar rase sing ngêtokake dhèdhès.","","ngoko,krama"],["andai","(se)andainya: saupama; berandai-andai: ngrêrantam, rêrêmbugan.","",""],["andak","i diandakkan: digulung sathithik. tmr. layar, dicêndhakake dikikis; kc. pandak; ii andak-andak: trêkadhang; kadhang-kala.","","ngoko,dialek"],["andaka","banthèng.","",""],["andalan","cêkêlan, tanggungan.","",""],["andam","diandam: ditata lan dicukur tmr. rambut lsp.","","ngoko,krama,dialek"],["andang","obor blarak lsp.","","ngoko"],["andang-andang","kayu (wêsi) panggantungan layar.","","ngoko"],["andar","i mati andar: mati tanpa guna; mati tanpa sabab; mati ora dibêlèh (tmr. kewan). ii sêjati; bapa andar: bapa têmênan (dudu kuwalon lsp.). iii diandarkan: dicritakake; diandharake.","","ngoko,krama,arab"],["andawali","bratawali.","","ngoko"],["anderak","luwangan pasangan gajah.","","ngoko"],["andika","panjênêngan.","",""],["andon","mengandon perang: nglurug pêrang.","","ngoko,dialek"],["anduh","dianduh: diêmban (digantung) nganggo tali lsp.; anduhan: êmban-êmban (tali lsp.), tali panggantungan sêkoci lsp.","","ngoko"],["anduk","andhuk.","","ngoko"],["andung","wit andong.","","ngoko"],["andur, anur","grobag kêbo.","","ngoko"],["aneh","anèh.","","ngoko"],["aneka (-warna)","warna-warna.","","ngoko"],["anfas","akèh ajine.","","ngoko"],["angan(-angan)","angên-angên, gagasan; angan-angan: mbokmanawa; diangan(-angan): digagas-gagas, diangên-angên.","","ngoko"],["angau","kc. anggau.","",""],["angga","berangga, merangga: branggah (tmr. sungu).","","ngoko"],["anggai","sasmita, ngalamat.","","arkais"],["anggal","anggêl (ora kakehan momotan tmr. prau).","","ngoko,krama"],["anggap","i ut. menganggap: ndhungkluk ngancarani ngajak ngombe lsp.; beranggap-anggapan: padha dene ngancarani ndhungkluk. ii dianggap: dianggêp kaya.","","ngoko,dialek,arkais"],["anggar","dianggar: dikira-kira, dipetung, dirancang; anggaran: 1 pangira-ira (petungan lsp.); 2 rancangan, rantaman; 3 wêwatoning pakumpulan (setatuten).","",""],["anggara","setua anggara: kewan galak.","","ngoko,arkais,arab"],["a