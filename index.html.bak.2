  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    background: var(--bg); color: var(--ink); line-height: 1.5;
  }
  header {
    background: linear-gradient(135deg, #4a2c12, #7c4a1e);
    color: #fff; padding: 14px 16px 12px;
    position: sticky; top: 0; z-index: 20;
    box-shadow: 0 2px 8px rgba(0,0,0,.25);
  }
  header h1 { font-size: 20px; letter-spacing: .3px; }
  header h1 small { font-weight: 400; font-size: 12px; opacity: .85; display: block; }
  nav.tabs { display: flex; gap: 6px; margin-top: 10px; }
  nav.tabs button {
    flex: 1; background: rgba(255,255,255,.16); color: #fff;
    font-size: 13px; font-weight: 600; padding: 7px 4px; border-radius: 8px;
    border: 1px solid rgba(255,255,255,.35); font-family: inherit; cursor: pointer;
  }
  nav.tabs button.on { background: #fff; color: var(--accent2); }
  nav.modes { display: flex; gap: 6px; padding: 10px 16px 0; }
  nav.modes button {
    flex: 1; border: 1px solid var(--border); background: var(--chip); color: #444;
    padding: 6px 4px; border-radius: 8px; font-size: 12.5px; font-weight: 600;
    font-family: inherit; cursor: pointer;
  }
  nav.modes button.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .filterwrap { padding: 8px 16px 0; font-size: 12.5px; color: var(--muted); }
  .filterwrap select {
    font-family: inherit; font-size: 13px; font-weight: 600; color: var(--accent2);
    border: 1px solid var(--border); border-radius: 8px; background: #fff;
    padding: 5px 8px; margin-left: 4px; max-width: 70%;
  }
  .searchwrap { margin: 10px 16px 0; position: relative; display: flex; gap: 6px; }
  .searchwrap input {
    flex: 1; padding: 10px 14px; font-size: 16px;
    border: 1px solid var(--border); border-radius: 10px; outline: none;
    background: #fff; color: #222; min-width: 0;
  }
  .searchwrap input:focus { border-color: var(--accent); }
  .searchwrap button.clr {
    border: 1px solid var(--border); background: var(--chip); color: #444;
    border-radius: 10px; padding: 0 14px; font-size: 16px; cursor: pointer;
  }
  .trout { font-size: 16.5px; }
  mark.unknown { background: #ffd9d9; border-radius: 3px; padding: 0 1px; }
  .mini {
    border: 1px solid var(--border); background: var(--chip); color: #444;
    border-radius: 999px; font-size: 11.5px; font-weight: 700; cursor: pointer;
    font-family: inherit; padding: 2px 10px; margin: 0 2px;
  }
  .mini.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  nav.chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 16px 4px; }
  nav.chips button {
    border: 1px solid var(--border); background: var(--chip); color: #444;
    min-width: 34px; padding: 5px 8px; border-radius: 8px; font-size: 12.5px;
    font-weight: 700; cursor: pointer; font-family: inherit;
  }
  nav.chips button.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .sec-head {
    font-size: 13.5px; font-weight: 700; color: var(--accent2);
    margin: 14px 2px 8px; padding-top: 10px; border-top: 1px solid var(--border);
  }
  main { padding: 10px 16px 24px; max-width: 720px; margin: 0 auto; }
  .card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 12px 14px; margin-bottom: 10px;
    box-shadow: 0 1px 3px rgba(0,0,0,.08);
  }
  .entry { display: flex; gap: 10px; align-items: flex-start; }
  .entry .body { flex: 1; min-width: 0; }
  .entry .kata { font-size: 16.5px; font-weight: 700; color: var(--accent2); }
  .entry .arti { font-size: 14.5px; margin-top: 2px; word-wrap: break-word; }
  .entry .tag {
    display: inline-block; font-size: 11px; color: var(--muted);
    border: 1px solid var(--border); border-radius: 999px;
    padding: 0 8px; margin-top: 6px; margin-right: 4px;
