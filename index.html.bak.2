  .tag.lvl-krama { background: #e3ecfa; color: #1e40af; border-color: #b3c6ea; }
  .tag.lvl-inggil { background: #fbf3dd; color: #8a6d1a; border-color: #e8d48a; }
  .tag.lvl-andhap { background: #f3e8fb; color: #6d1a8a; border-color: #d8b3ea; }
  .tag.lvl-kasar { background: #fbe3e3; color: #a02020; border-color: #eab3b3; }
  .tag.lvl-cakapan, .tag.lvl-dialek, .tag.lvl-arkais { background: #f0ebe2; color: #6d5a3e; border-color: #d8cbb6; }
  .tag.lvl-arab, .tag.lvl-sanskerta, .tag.lvl-walanda, .tag.lvl-cina, .tag.lvl-melayu, .tag.lvl-prancis, .tag.lvl-portugis { background: #ece7f5; color: #4a3e7c; border-color: #c9bde4; }
  .star {
    border: none; background: none; font-size: 22px; cursor: pointer;
    color: #ccc; padding: 0 2px; line-height: 1.2; flex-shrink: 0;
  }
  .star.fav { color: var(--star); }
  .hist { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .hist button {
    border: 1px solid var(--border); background: #fff; color: var(--accent2);
    padding: 4px 12px; border-radius: 999px; font-size: 12.5px; cursor: pointer;
    font-family: inherit;
  }
  .more {
    display: block; width: 100%; border: 1px solid var(--accent); background: #fff;
    color: var(--accent); border-radius: 10px; padding: 10px; font-size: 14px;
    font-weight: 700; cursor: pointer; font-family: inherit; margin-bottom: 10px;
  }
  .muted { color: var(--muted); font-size: 12.5px; }
  .count { padding: 2px 0 10px; }
  h2.sec { font-size: 15px; color: var(--accent2); margin: 12px 0 8px; }
  .about p { font-size: 14px; margin-bottom: 8px; }
  .about li { font-size: 13.5px; margin: 0 0 4px 18px; }
  mark { background: #ffe9a8; border-radius: 3px; padding: 0 1px; }
</style>
</head>
